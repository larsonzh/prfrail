+	blob := []byte{2, 0, 0, 0} // ACL version 2, little-endian
+	appendEntry := func(tag, perm uint16, id uint32) {
+		blob = append(blob,
+			byte(tag), byte(tag>>8),
+			byte(perm), byte(perm>>8),
+			byte(id), byte(id>>8), byte(id>>16), byte(id>>24))
+	}
