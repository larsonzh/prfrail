+
+// P85 F07 (design rev 3, section 3 / test row M7): the shebang limit is the KERNEL's
+// 256-byte window, counted INCLUDING the "#!" magic.
+//
+// binfmt_script copies at most BINPRM_BUF_SIZE (256) bytes and needs the terminating
+// newline INSIDE that window. The previous rule counted the remainder after "#!" and
+// did not check where the newline landed, so a spec of 254 bytes (newline at file
+// offset 256) passed a rule that claimed to be equivalent to the kernel's.
+//
+// Mutation check: restore the "remainder length vs 256" rule (and search for the
+// newline in the whole buffer) => the offset-256 case stops being refused by the
+// window and this test goes red.
+
+import (
+	"strings"
+	"testing"
+)
+
+const p85F07WindowRefusal = "no newline within the kernel's"
+
+func TestP85F07ShebangWindowIncludesTheMagicBytes(t *testing.T) {
+	// newline at file offset 255: spec is 253 bytes, exactly what the kernel keeps.
+	insideWindow := "#!" + "/" + strings.Repeat("a", 252) + "\n" + "tail"
+	if len(insideWindow) <= installSourceShebangWindow {
+		t.Fatalf("the fixture must extend past the window, got %d bytes", len(insideWindow))
+	}
+	if _, err := installSourceShebangInterpreter([]byte(insideWindow), "/p85-f07-offset-255", 0); err != nil {
+		if strings.Contains(err.Error(), p85F07WindowRefusal) {
+			t.Fatalf("a newline at offset 255 is inside the kernel window and must pass the window rule, got %v", err)
+		}
+	}
+
+	// newline at file offset 256: one byte past the window, so the kernel never
+	// terminates the line. The old "remainder vs 256" rule admitted it.
+	pastWindow := "#!" + "/" + strings.Repeat("a", 253) + "\n" + "tail"
+	if _, err := installSourceShebangInterpreter([]byte(pastWindow), "/p85-f07-offset-256", 0); err == nil {
+		t.Fatal("a newline past the kernel window must be refused")
+	} else if !strings.Contains(err.Error(), p85F07WindowRefusal) {
+		t.Fatalf("the refusal must come from the window rule, got %v", err)
+	}
+}
diff --git a/internal/adapters/p85_f13_spec_binding_test.go b/internal/adapters/p85_f13_spec_binding_test.go
new file mode 100644
index 0000000..d767b55
--- /dev/null
+++ b/internal/adapters/p85_f13_spec_binding_test.go
@@ -0,0 +1,90 @@
+package adapters
+
+// P85 F13 (design rev 3, section 5 / test row M9, adapters half): the platform write
+// proof is bound to ONE frozen specification.
+//
+// Two specifications on the same platform that differ in a single field (here the
+// output bound) must produce different specification digests AND different
+// PlatformWriteProof digests. Before the fix the proof was GOOS+GOARCH+reason+
+// "allowed", so both specifications shared one proof and "the sandbox allowed THIS
+// spawn" was unprovable.
+//
+// Mutation check: drop specDigest from the canonical text in
+// copilotCLIProbePlatformWriteVerdict (back to the constant "allowed" tail) =>
+// "the-proof-follows-the-specification" goes red.
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/guard"
+)
+
+// p85F13SilentAllowedSandbox answers Allowed but echoes NO specification, which is
+// the shape of a layer that judged "a probe in general".
+type p85F13SilentAllowedSandbox struct{}
+
+func (p85F13SilentAllowedSandbox) Check(_ context.Context, _ guard.CheckSpec) (guard.Verdict, error) {
+	return guard.Verdict{Status: guard.VerdictAllowed}, nil
+}
+
+func p85F13BaseSpawnSpec(t *testing.T) copilotCLIProbeSpawnSpec {
+	t.Helper()
+	spec, err := copilotCLIProbeLaunchSpec(
+		filepath.Join(t.TempDir(), "copilot"),
+		t.TempDir(),
+		"secret",
+		p85T8ABYOKProfile().Model,
+		1,
+		1<<20,
+	)
+	if err != nil {
+		t.Fatalf("a compliant launch template must be constructible: %v", err)
+	}
+	return spec
+}
+
+func TestP85F13PlatformWriteProofIsBoundToTheSpawnSpecification(t *testing.T) {
+	base := p85F13BaseSpawnSpec(t)
+	other := base
+	other.OutputBound++
+
+	baseDigest := copilotCLIProbeSpawnSpecDigest(base)
+	otherDigest := copilotCLIProbeSpawnSpecDigest(other)
+	if baseDigest == "" || otherDigest == "" {
+		t.Fatalf("both specifications must encode a digest, got %q and %q", baseDigest, otherDigest)
+	}
+	if baseDigest == otherDigest {
+		t.Fatalf("two specifications that differ in one field must not share a digest (%s)", baseDigest)
+	}
+	if again := copilotCLIProbeSpawnSpecDigest(base); again != baseDigest {
+		t.Fatalf("the specification digest must be stable, got %s then %s", baseDigest, again)
+	}
+
+	sandbox := p85T8AAllowedSandbox{}
+	baseProof, err := copilotCLIProbePlatformWriteVerdict(context.Background(), sandbox, baseDigest)
+	if err != nil {
+		t.Fatalf("an Allowed sandbox must answer the base specification, got %v", err)
+	}
+	otherProof, err := copilotCLIProbePlatformWriteVerdict(context.Background(), sandbox, otherDigest)
+	if err != nil {
+		t.Fatalf("an Allowed sandbox must answer the other specification, got %v", err)
+	}
+	if baseProof == otherProof {
+		t.Fatalf("two specifications on one platform must not share a write proof (%s)", baseProof)
+	}
+	sameProof, err := copilotCLIProbePlatformWriteVerdict(context.Background(), sandbox, baseDigest)
+	if err != nil || sameProof != baseProof {
+		t.Fatalf("the proof must be stable for one specification, got %s then %s (err=%v)", baseProof, sameProof, err)
+	}
+
+	// A layer that answers without echoing the specification is refused, and so is a
+	// request that names no specification at all: an unbound verdict is never a proof.
+	if _, err := copilotCLIProbePlatformWriteVerdict(context.Background(), p85F13SilentAllowedSandbox{}, otherDigest); err == nil {
+		t.Fatal("a verdict that does not echo the specification must be refused")
+	}
+	if _, err := copilotCLIProbePlatformWriteVerdict(context.Background(), sandbox, ""); err == nil {
+		t.Fatal("an unbound specification must be refused")
+	}
+}
diff --git a/internal/adapters/p85_f18_start_count_test.go b/internal/adapters/p85_f18_start_count_test.go
new file mode 100644
index 0000000..cd07324
--- /dev/null
+++ b/internal/adapters/p85_f18_start_count_test.go
@@ -0,0 +1,97 @@
+package adapters
+
+// P85 F18 (design rev 3, section 7 / test row M11): the platform write verdict must
+// be the only gate between a COMPLIANT credential-bearing envelope and the start
+// observation.
+//
+// Review r1 rejected the earlier shape because the Allowed stand-in never entered the
+// real executor: the counterexample used a shell argv that the argv allowlist refused
+// on its own, so no verdict change was measurable. The fix puts an injectable check
+// layer on the executor and an observation point at the LAST gate
+// (copilotCLIProbeRunManaged), so the two legs below differ in ONE fact - the verdict
+// - and the child is never really started (the stub only counts).
+//
+// Mutation check (the single-variant body of M11): make the executor ignore its
+// Sandbox field (or delete the final guard.CheckSandbox call) and the Unknown leg
+// starts the child => "a-non-allowed-verdict-keeps-the-start-count-at-zero" goes red.
+//
+// The element-level control (M12: a non-compliant argv is still refused under an
+// Allowed verdict, by its own element and not by the sandbox) lives in
+// TestP85T8APlatformVerdictAloneControlsTheSpawn.
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/guard"
+)
+
+// p85F18StubStart replaces the managed-process launcher with a counter, so "the child
+// would have been created" becomes an integer and nothing is spawned.
+func p85F18StubStart(t *testing.T) *int {
+	t.Helper()
+	previous := copilotCLIProbeRunManaged
+	starts := 0
+	copilotCLIProbeRunManaged = func(_ context.Context, _ guard.ProcessSpec, _ time.Duration) (guard.ProcessResult, error) {
+		starts++
+		return guard.ProcessResult{Started: true}, nil
+	}
+	t.Cleanup(func() { copilotCLIProbeRunManaged = previous })
+	return &starts
+}
+
+func TestP85F18ThePlatformVerdictAloneDecidesTheStart(t *testing.T) {
+	// The executable must pass the LIVE install-source re-verification Execute runs
+	// before the BYOK gates, otherwise the legs would both be refused by that check
+	// and neither would isolate the verdict.
+	shell := p85T8ASystemShell(t)
+	root := t.TempDir()
+	profile := p85T8ABYOKProfile()
+	invocation := CopilotCLIProbeInvocation{
+		Executable:       shell,
+		WorkingDirectory: root,
+		Args:             copilotCLIProbeArgs(profile.Model, root, 1, "secret"),
+		Environment:      copilotCLIProbeEnvironment(profile, []byte("p85-t8a-secret")),
+		AuthMode:         "secret",
+	}
+	starts := p85F18StubStart(t)
+
+	t.Run("an-allowed-verdict-reaches-the-start-observation", func(t *testing.T) {
+		*starts = 0
+		executor := ManagedCopilotCLIProbeExecutor{TemporaryDirectory: root, Sandbox: p85T8AAllowedSandbox{}}
+		execution := executor.Execute(context.Background(), invocation)
+		if *starts != 1 {
+			t.Fatalf("an Allowed verdict on a compliant envelope must reach the start observation exactly once, got %d (outcome=%q evidence=%v)",
+				*starts, execution.Outcome, execution.Evidence)
+		}
+		if execution.Outcome == "start-failed" && execution.FailureCode == copilotCLIProbeBYOKFailure {
+			t.Fatalf("the BYOK gate must not refuse a compliant envelope under an Allowed verdict, got %+v", execution)
+		}
+	})
+
+	t.Run("a-non-allowed-verdict-keeps-the-start-count-at-zero", func(t *testing.T) {
+		*starts = 0
+		unknown := &p85T8ASandboxDouble{verdict: guard.Verdict{Status: guard.VerdictUnknown, Reason: "S1 sandbox enforcement checks not implemented"}}
+		executor := ManagedCopilotCLIProbeExecutor{TemporaryDirectory: root, Sandbox: unknown}
+		execution := executor.Execute(context.Background(), invocation)
+		if *starts != 0 {
+			t.Fatalf("an Unknown platform verdict must keep the child from starting, got %d starts", *starts)
+		}
+		if execution.Outcome != "start-failed" || execution.FailureCode != copilotCLIProbeBYOKFailure {
+			t.Fatalf("an Unknown verdict must refuse under the BYOK class, got outcome=%q failure=%q", execution.Outcome, execution.FailureCode)
+		}
+		want := copilotCLIExecutorEvidence("byok-confinement-unproven")
+		if len(execution.Evidence) != 1 || execution.Evidence[0] != want {
+			t.Fatalf("the refusal must be the closed classification %q, got %v", want, execution.Evidence)
+		}
+	})
+
+	t.Run("the-observation-point-is-the-last-gate", func(t *testing.T) {
+		*starts = 0
+		executor := ManagedCopilotCLIProbeExecutor{TemporaryDirectory: root, Sandbox: &p85T8ASandboxDouble{verdict: guard.Verdict{Status: guard.VerdictDenied, Reason: "the environment provably lacks write restrictions"}}}
+		if execution := executor.Execute(context.Background(), invocation); *starts != 0 || execution.Outcome != "start-failed" {
+			t.Fatalf("a Denied verdict must refuse before the launcher, got starts=%d outcome=%q", *starts, execution.Outcome)
+		}
+	})
+}
diff --git a/internal/adapters/p85_r6_sandwich_linux_test.go b/internal/adapters/p85_r6_sandwich_linux_test.go
new file mode 100644
index 0000000..3488f48
--- /dev/null
+++ b/internal/adapters/p85_r6_sandwich_linux_test.go
@@ -0,0 +1,62 @@
+//go:build linux
+
+package adapters
+
+// P85 R6 / the Linux native leg of the identity sandwich (review r3 finding 1).
+//
+// managedAgentPolicyDomainSlotObservation runs, per present slot,
+//
+//	fstat(handle) -> name == handle identity -> ACL probe
+//	              -> fstat(handle) again      -> name == handle identity
+//
+// The leg below states the bracket at its smallest discriminating unit: the opening
+// comparison passes on the untouched name, the swap happens, and the closing
+// comparison refuses. It then runs the production observation over a name that
+// already moved, so the refusal is attributable to the sandwich and not to the
+// ACL or the writability rules (both of which this host would also refuse, which is
+// why the assertion is on the message).
+//
+// Verification status: this file is skipped on Windows; its authoritative run is
+// the Ubuntu VM leg (本机 skip 待 VM).
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func init() {
+	p85R6SandwichPlatformLegs = append(p85R6SandwichPlatformLegs, p85R6SandwichLeg{
+		name: "the-linux-native-sandwich-refuses-a-swap-between-its-two-comparisons",
+		run: func(t *testing.T) {
+			slot, handleIdentity, swap := p85R6SandwichFixture(t)
+			if err := managedAgentPolicyDomainAssertNameIdentity(slot, handleIdentity, "before"); err != nil {
+				t.Fatalf("the untouched name must pass the opening comparison, got %v", err)
+			}
+			swap()
+			err := managedAgentPolicyDomainAssertNameIdentity(slot, handleIdentity, "after")
+			if err == nil {
+				t.Fatal("a name swapped between the two comparisons must refuse the closing comparison")
+			}
+			if !errors.Is(err, ErrManagedAgentPolicyWriteProof) {
+				t.Fatalf("the refusal must be the write-proof sentinel, got %v", err)
+			}
+			if !strings.Contains(err.Error(), "no longer addresses the object its handle addresses") {
+				t.Fatalf("the refusal must be the name-versus-handle comparison, got %v", err)
+			}
+			if !strings.Contains(err.Error(), "after") {
+				t.Fatalf("the refusal must say which side of the sandwich failed, got %v", err)
+			}
+
+			// The production observation over the same moved name refuses as well, so
+			// the bracket above is not a parallel re-implementation.
+			movedSlot, _, moveAgain := p85R6SandwichFixture(t)
+			moveAgain()
+			if _, err := managedAgentPolicyDomainSlotObservation(movedSlot); err == nil {
+				t.Fatal("the production observation must refuse a name that no longer addresses its handle")
+			} else if !strings.Contains(err.Error(), "before its ACL check") {
+				t.Fatalf("the production refusal must come from the opening comparison of the sandwich, got %v", err)
+			}
+		},
+	})
+}
diff --git a/internal/adapters/p85_r6_sandwich_supported_test.go b/internal/adapters/p85_r6_sandwich_supported_test.go
new file mode 100644
index 0000000..3a6a681
--- /dev/null
+++ b/internal/adapters/p85_r6_sandwich_supported_test.go
@@ -0,0 +1,132 @@
+//go:build windows || linux
+
+package adapters
+
+// P85 R6 (test round 6) / review r3 finding 1: the identity SANDWICH of the
+// handle-form write-domain observation. The observation reads a path-based probe
+// (the POSIX access-ACL read, the per-right Windows access checks) between two
+// name-versus-handle comparisons, so a name that no longer addresses the object
+// the handle addresses refuses instead of judging another object.
+//
+// The counterexample is the swap the review names: the artifact is renamed away and
+// a byte-identical stand-in is put at the same name. The handle keeps addressing the
+// recorded object, the name addresses a different one, and no byte in the domain
+// changed - so only an identity comparison can tell the two apart.
+//
+// Boundary (registered): a swap squeezed strictly BETWEEN the two comparisons of one
+// observation cannot be injected without a production seam, and no seam is added
+// here. The legs below therefore (a) prove the swap is a different object, and
+// (b) prove each platform's observation refuses a name that moved, which is the
+// discriminating fact both halves rely on.
+//
+// Mutation check (design rev 4 section 6, mutation 2): deleting one name comparison
+// from the sandwich - the Windows handle-versus-name comparison, or the Linux
+// managedAgentPolicyDomainAssertNameIdentity mismatch branch - makes the
+// corresponding leg below accept the moved name and go red.
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85R6SandwichLeg is one platform-native leg of the sandwich counterexample.
+type p85R6SandwichLeg struct {
+	name string
+	run  func(t *testing.T)
+}
+
+// p85R6SandwichPlatformLegs collects the legs each platform half registers in its
+// own init, so the shared test never has to name a platform symbol that another
+// build excludes.
+var p85R6SandwichPlatformLegs []p85R6SandwichLeg
+
+// p85R6SandwichFixture binds one artifact inside one bound directory and returns
+// the handle-form slot, the identity its handle reports, and the swap that renames
+// the artifact away and leaves a byte-identical stand-in at the same name.
+func p85R6SandwichFixture(t *testing.T) (managedAgentPolicyDomainSlot, evidence.FileID, func()) {
+	t.Helper()
+	root := t.TempDir()
+	policy := filepath.Join(root, "agent-runner-policy")
+	if err := os.MkdirAll(policy, 0o755); err != nil {
+		t.Fatalf("create the policy directory: %v", err)
+	}
+	name := "task.step.attempt.1.policy.json"
+	path := filepath.Join(policy, name)
+	if err := os.WriteFile(path, []byte("policy"), 0o600); err != nil {
+		t.Fatalf("write the artifact: %v", err)
+	}
+
+	directory, _, err := evidence.OpenBoundDirVerified(policy)
+	if err != nil {
+		t.Skipf("this host's temporary root is not bindable as a verified directory: %v", err)
+	}
+	t.Cleanup(func() { _ = directory.Close() })
+	bound, err := evidence.OpenBoundDirFile(directory, name, 1<<20)
+	if err != nil {
+		t.Fatalf("open the artifact relative to the bound directory: %v", err)
+	}
+	t.Cleanup(func() { _ = bound.Close() })
+	identity, err := bound.FileID()
+	if err != nil {
+		t.Fatalf("identify the artifact on its handle: %v", err)
+	}
+
+	slot := managedAgentPolicyDomainSlot{
+		label:   managedPolicyDomainArtifactRole,
+		path:    path,
+		isDir:   false,
+		present: true,
+		file:    bound,
+	}
+	swap := func() {
+		t.Helper()
+		// Rename first so the retired object keeps its identity; a create-after-delete
+		// can hand the same inode back, which would make the fixture agree by accident.
+		if err := os.Rename(path, path+".retired"); err != nil {
+			t.Fatalf("rename the artifact away: %v", err)
+		}
+		if err := os.WriteFile(path, []byte("policy"), 0o600); err != nil {
+			t.Fatalf("write the stand-in artifact: %v", err)
+		}
+	}
+	return slot, evidence.FileID(identity), swap
+}
+
+// TestP85R6SandwichRefusesANameSwapBetweenAssertions is the counterexample.
+func TestP85R6SandwichRefusesANameSwapBetweenAssertions(t *testing.T) {
+	t.Run("the-swap-leaves-a-different-object-behind-the-same-name", func(t *testing.T) {
+		slot, handleIdentity, swap := p85R6SandwichFixture(t)
+		untouched, err := evidence.FileIDAt(slot.path)
+		if err != nil {
+			t.Fatalf("identify the untouched artifact by name: %v", err)
+		}
+		if untouched != handleIdentity {
+			t.Fatalf("an untouched name must address the handle's object (%s != %s)", untouched, handleIdentity)
+		}
+		swap()
+		moved, err := evidence.FileIDAt(slot.path)
+		if err != nil {
+			t.Fatalf("the stand-in must still be observable by name: %v", err)
+		}
+		if moved == handleIdentity {
+			t.Fatalf("the fixture must put a DIFFERENT object behind the same name, got %s twice", moved)
+		}
+		// The name still resolves and the bytes are identical: only identity separates
+		// the two objects, which is what makes the sandwich necessary at all.
+		movedBytes, err := os.ReadFile(slot.path)
+		if err != nil {
+			t.Fatalf("read the stand-in by name: %v", err)
+		}
+		if string(movedBytes) != "policy" {
+			t.Fatalf("the stand-in must carry the same bytes, got %q", movedBytes)
+		}
+	})
+
+	for _, leg := range p85R6SandwichPlatformLegs {
+		leg := leg
+		t.Run(leg.name, leg.run)
+	}
+}
diff --git a/internal/adapters/p85_r6_sandwich_windows_test.go b/internal/adapters/p85_r6_sandwich_windows_test.go
new file mode 100644
index 0000000..f3389d7
--- /dev/null
+++ b/internal/adapters/p85_r6_sandwich_windows_test.go
@@ -0,0 +1,47 @@
+//go:build windows
+
+package adapters
+
+// P85 R6 / the Windows leg of the identity sandwich (review r3 finding 1).
+//
+// The Windows observation takes the slot identity from its handle, classifies the
+// name chain, then requires the NAME to still address that handle before the
+// per-right access probes and to still address it afterwards. The leg moves the name
+// onto a different object and requires the observation to refuse with the
+// handle-versus-name comparison rather than with a writability verdict - so the
+// sandwich, not the ACL table, is what answers.
+//
+// Mutation check (design rev 4 section 6, mutation 2, locally runnable equivalent):
+// deleting the handle-versus-name comparison from
+// managedAgentPolicyDomainSlotObservation leaves the observation reporting the
+// probes of the stand-in object, and this leg goes red.
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func init() {
+	p85R6SandwichPlatformLegs = append(p85R6SandwichPlatformLegs, p85R6SandwichLeg{
+		name: "the-windows-native-observation-refuses-a-name-that-moved",
+		run: func(t *testing.T) {
+			slot, _, swap := p85R6SandwichFixture(t)
+			swap()
+			sidText, err := installSourceCurrentUserSIDText()
+			if err != nil {
+				t.Skipf("this host cannot resolve the executing user's SID: %v", err)
+			}
+			_, _, observationErr := managedAgentPolicyDomainSlotObservation(slot, sidText)
+			if observationErr == nil {
+				t.Fatal("the observation must refuse a name that no longer addresses the handle's object")
+			}
+			if !errors.Is(observationErr, ErrManagedAgentPolicyWriteProof) {
+				t.Fatalf("the refusal must be the write-proof sentinel, got %v", observationErr)
+			}
+			if !strings.Contains(observationErr.Error(), "no longer names the object its handle addresses") {
+				t.Fatalf("the refusal must be the handle-versus-name comparison, got %v", observationErr)
+			}
+		},
+	})
+}
diff --git a/internal/adapters/p85_r6_slot_order_test.go b/internal/adapters/p85_r6_slot_order_test.go
new file mode 100644
index 0000000..8da40ae
--- /dev/null
+++ b/internal/adapters/p85_r6_slot_order_test.go
@@ -0,0 +1,283 @@
+package adapters
+
+// P85 R6 (test round 6) / review r3 finding 2: the observed vector of the
+// managed-identity write proof must be the FOUR fixed slots of the contract -
+//
+//	[policy directory | parent directory | artifact | anchor]
+//
+// with the absent slot rendered as the canonical empty marker - and the two file
+// slots must be placed by ROLE, never by path order. The review found that
+// `.anchor.json` sorts before `.policy.json` and that an anchor-only set slid the
+// anchor into the artifact slot, so the vector that was actually hashed differed
+// from the vector CONTRACTS.md:233 describes.
+//
+// The white-box assertions below read the slot list the production helpers return,
+// so the property is pinned where it is produced and not through a digest whose
+// preimage a later refactor could change.
+//
+// Mutation check (design rev 4 section 6, mutation 1): making
+// managedAgentPolicyDomainPlaceFileSlots ignore the resolved role and append the
+// candidates in path order puts the anchor third and the artifact fourth; the
+// full-object-vector, anchor-only and handle-form legs then go red.
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85R6DescribeSlots renders one four-slot vector as "label=path" with the
+// canonical empty marker for an absent slot, so an assertion can state the whole
+// vector literally.
+func p85R6DescribeSlots(slots []managedAgentPolicyDomainSlot) []string {
+	described := make([]string, 0, len(slots))
+	for _, slot := range slots {
+		if !slot.present {
+			described = append(described, slot.label+"="+managedAgentPolicyDomainEmptySlot)
+			continue
+		}
+		described = append(described, slot.label+"="+slot.path)
+	}
+	return described
+}
+
+// p85R6RequireSlots compares one vector against the expected slots position by
+// position, so an order swap cannot pass by comparing sets.
+func p85R6RequireSlots(t *testing.T, label string, got []string, want ...string) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("%s must keep the fixed %d-slot vector, got %d slots: %v", label, len(want), len(got), got)
+	}
+	for index := range want {
+		if got[index] != want[index] {
+			t.Fatalf("%s: slot %d must be %q, got %q (whole vector %v)", label, index+1, want[index], got[index], got)
+		}
+	}
+}
+
+// TestP85R6SlotOrderMatchesTheContract pins the real vector that enters the digest.
+func TestP85R6SlotOrderMatchesTheContract(t *testing.T) {
+	// The two names are the ones the frozen policy contract spells. The anchor name
+	// sorts BEFORE the artifact name, which is what made a path-sorted vector differ
+	// from the contract's order.
+	const (
+		artifactName = "task.step.attempt.1.policy.json"
+		anchorName   = "task.step.attempt.1.anchor.json"
+	)
+	if !(anchorName < artifactName) {
+		t.Fatalf("the fixture must use an anchor name that sorts first, otherwise the path-order counterexample proves nothing")
+	}
+
+	t.Run("the-full-object-vector-is-dir-parent-artifact-anchor", func(t *testing.T) {
+		root := t.TempDir()
+		policy := filepath.Join(root, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		// The caller passes the anchor first, so neither the argument order nor the
+		// path order may decide the slot.
+		slots, err := managedAgentPolicyDomainNameSlots(policy, []string{anchorName, artifactName})
+		if err != nil {
+			t.Fatalf("a two-file domain must produce the four-slot vector, got %v", err)
+		}
+		p85R6RequireSlots(t, "the full object set", p85R6DescribeSlots(slots),
+			"policy directory="+policy,
+			"parent directory="+filepath.Dir(policy),
+			"artifact="+artifactName,
+			"anchor="+anchorName,
+		)
+		if slots[2].path != artifactName || slots[3].path != anchorName {
+			t.Fatalf("the artifact must be slot 3 and the anchor slot 4, got %q and %q", slots[2].path, slots[3].path)
+		}
+		if slots[2].isDir || slots[3].isDir {
+			t.Fatal("the two file slots must be file slots")
+		}
+	})
+
+	t.Run("an-anchor-only-set-leaves-the-artifact-slot-empty", func(t *testing.T) {
+		root := t.TempDir()
+		policy := filepath.Join(root, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		slots, err := managedAgentPolicyDomainNameSlots(policy, []string{anchorName})
+		if err != nil {
+			t.Fatalf("an anchor-only domain must keep the four-slot shape, got %v", err)
+		}
+		p85R6RequireSlots(t, "the anchor-only set", p85R6DescribeSlots(slots),
+			"policy directory="+policy,
+			"parent directory="+filepath.Dir(policy),
+			"artifact="+managedAgentPolicyDomainEmptySlot,
+			"anchor="+anchorName,
+		)
+		if slots[2].present {
+			t.Fatalf("the artifact slot must stay empty instead of receiving %q", slots[2].path)
+		}
+	})
+
+	t.Run("the-handle-form-places-files-by-role-not-by-path-order", func(t *testing.T) {
+		root := t.TempDir()
+		policy := filepath.Join(root, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		artifactPath := filepath.Join(policy, artifactName)
+		anchorPath := filepath.Join(policy, anchorName)
+		for _, path := range []string{artifactPath, anchorPath} {
+			if err := os.WriteFile(path, []byte("policy"), 0o600); err != nil {
+				t.Fatalf("write %s: %v", path, err)
+			}
+		}
+
+		directory, directoryID, err := evidence.OpenBoundDirVerified(policy)
+		if err != nil {
+			t.Skipf("this host's temporary root is not bindable as a verified directory: %v", err)
+		}
+		defer func() { _ = directory.Close() }()
+		parent, parentID, err := evidence.OpenBoundDirVerified(filepath.Dir(policy))
+		if err != nil {
+			t.Skipf("this host's temporary root is not bindable as a verified directory: %v", err)
+		}
+		defer func() { _ = parent.Close() }()
+
+		artifact, err := evidence.OpenBoundDirFile(directory, artifactName, 1<<20)
+		if err != nil {
+			t.Fatalf("open the artifact relative to the bound directory: %v", err)
+		}
+		defer func() { _ = artifact.Close() }()
+		anchor, err := evidence.OpenBoundDirFile(directory, anchorName, 1<<20)
+		if err != nil {
+			t.Fatalf("open the anchor relative to the bound directory: %v", err)
+		}
+		defer func() { _ = anchor.Close() }()
+
+		// The anchor is passed FIRST, exactly as a caller that walked the directory
+		// in name order would.
+		files := []ManagedPolicyDomainBoundFile{
+			{Path: anchorPath, Role: managedPolicyDomainAnchorRole, Bound: anchor},
+			{Path: artifactPath, Role: managedPolicyDomainArtifactRole, Bound: artifact},
+		}
+		slots, err := managedAgentPolicyDomainHandleSlots(directory, directoryID, parent, parentID, files)
+		if err != nil {
+			t.Fatalf("the handle form must produce the four-slot vector, got %v", err)
+		}
+		if len(slots) != 4 {
+			t.Fatalf("the handle form must keep the fixed four-slot vector, got %d slots", len(slots))
+		}
+		for index, want := range []string{"policy directory", "parent directory", managedPolicyDomainArtifactRole, managedPolicyDomainAnchorRole} {
+			if slots[index].label != want {
+				t.Fatalf("slot %d must be labelled %q, got %q", index+1, want, slots[index].label)
+			}
+		}
+		if slots[2].path != artifactPath {
+			t.Fatalf("slot 3 must carry the artifact %q, got %q", artifactPath, slots[2].path)
+		}
+		if slots[3].path != anchorPath {
+			t.Fatalf("slot 4 must carry the anchor %q, got %q", anchorPath, slots[3].path)
+		}
+		for index, want := range []evidence.FileID{directoryID, parentID} {
+			if slots[index].dir == nil {
+				t.Fatalf("slot %d must carry its bound directory handle", index+1)
+			}
+			identity, err := slots[index].dir.FileID()
+			if err != nil {
+				t.Fatalf("identify the handle of slot %d: %v", index+1, err)
+			}
+			if identity != want {
+				t.Fatalf("slot %d must carry the recorded directory identity %s, got %s", index+1, want, identity)
+			}
+		}
+		if slots[2].file != artifact || slots[3].file != anchor {
+			t.Fatal("the artifact slot must carry the artifact handle and the anchor slot the anchor handle")
+		}
+	})
+
+	t.Run("a-cross-role-claim-on-one-slot-is-refused", func(t *testing.T) {
+		root := t.TempDir()
+		policy := filepath.Join(root, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		declared := filepath.Join(policy, "declared-name-policy.json")
+		fromName := filepath.Join(policy, "task.step.attempt.1.anchor.json")
+		for _, path := range []string{declared, fromName} {
+			if err := os.WriteFile(path, []byte("policy"), 0o600); err != nil {
+				t.Fatalf("write %s: %v", path, err)
+			}
+		}
+
+		directory, directoryID, err := evidence.OpenBoundDirVerified(policy)
+		if err != nil {
+			t.Skipf("this host's temporary root is not bindable as a verified directory: %v", err)
+		}
+		defer func() { _ = directory.Close() }()
+		parent, parentID, err := evidence.OpenBoundDirVerified(filepath.Dir(policy))
+		if err != nil {
+			t.Skipf("this host's temporary root is not bindable as a verified directory: %v", err)
+		}
+		defer func() { _ = parent.Close() }()
+
+		declaredBound, err := evidence.OpenBoundDirFile(directory, filepath.Base(declared), 1<<20)
+		if err != nil {
+			t.Fatalf("open the declared slot file: %v", err)
+		}
+		defer func() { _ = declaredBound.Close() }()
+		nameBound, err := evidence.OpenBoundDirFile(directory, filepath.Base(fromName), 1<<20)
+		if err != nil {
+			t.Fatalf("open the name-marked slot file: %v", err)
+		}
+		defer func() { _ = nameBound.Close() }()
+
+		// The first file DECLARES itself the anchor while its name says nothing; the
+		// second says anchor by name. Both claim slot 4, so the pair cannot be folded.
+		files := []ManagedPolicyDomainBoundFile{
+			{Path: declared, Role: managedPolicyDomainAnchorRole, Bound: declaredBound},
+			{Path: fromName, Role: "", Bound: nameBound},
+		}
+		_, err = managedAgentPolicyDomainHandleSlots(directory, directoryID, parent, parentID, files)
+		if !errors.Is(err, ErrManagedAgentPolicyWriteProof) {
+			t.Fatalf("two candidates claiming one slot must be refused, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "claimed by both") {
+			t.Fatalf("the refusal must be the slot-claim conflict, got %v", err)
+		}
+		if !strings.Contains(err.Error(), managedPolicyDomainAnchorRole) {
+			t.Fatalf("the refusal must name the contested slot, got %v", err)
+		}
+	})
+
+	t.Run("the-digest-tracks-the-slot-content", func(t *testing.T) {
+		root := t.TempDir()
+		policy := filepath.Join(root, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		artifactPath := filepath.Join(policy, artifactName)
+		anchorPath := filepath.Join(policy, anchorName)
+		for _, path := range []string{artifactPath, anchorPath} {
+			if err := os.WriteFile(path, []byte("policy"), 0o600); err != nil {
+				t.Fatalf("write %s: %v", path, err)
+			}
+		}
+		full, err := managedAgentPolicyDomainNameSlots(policy, []string{artifactPath, anchorPath})
+		if err != nil {
+			t.Fatalf("observe the full domain: %v", err)
+		}
+		anchorOnly, err := managedAgentPolicyDomainNameSlots(policy, []string{anchorPath})
+		if err != nil {
+			t.Fatalf("observe the anchor-only domain: %v", err)
+		}
+		fullDigest, _ := managedAgentPolicyDomainWriteProofSlots(full)
+		anchorOnlyDigest, _ := managedAgentPolicyDomainWriteProofSlots(anchorOnly)
+		if fullDigest == "" || anchorOnlyDigest == "" {
+			t.Skipf("this host cannot render the observation digest (the proof refuses before observing it): full=%q anchor-only=%q", fullDigest, anchorOnlyDigest)
+		}
+		if fullDigest == anchorOnlyDigest {
+			t.Fatalf("an empty artifact slot and a filled one must not hash to the same digest, got %s twice", fullDigest)
+		}
+	})
+}
diff --git a/internal/adapters/p85_r6_windows_forensics_test.go b/internal/adapters/p85_r6_windows_forensics_test.go
new file mode 100644
index 0000000..96057d1
--- /dev/null
+++ b/internal/adapters/p85_r6_windows_forensics_test.go
@@ -0,0 +1,107 @@
+//go:build windows
+
+package adapters
+
+// P85 R6 (test round 6) / review r3 finding 3: the T3 executable forensics.
+//
+// openInstallSourceLeaf used to bind the executable's directory with
+// evidence.OpenBoundDirNoFollow, whose Windows half falls through to a plain
+// OpenBoundDir: the kernel followed a reparse point in the chain and the digest was
+// then taken from whatever object the name had been redirected to. The binding is now
+// evidence.OpenBoundDirVerified, whose Windows half walks the root chain and refuses
+// every reparse component, and the identity it returns belongs to the SAME resolution
+// that produced the handle.
+//
+// The counterexample is an intermediate junction: `...\linked\bin\agent-stub.exe`
+// where `linked` is a junction. Before the fix the leaf was opened through the
+// junction; now the bind refuses and the refusal names the offending component, i.e.
+// it carries the directory identity the caller has to fix.
+//
+// Mutation check: going back to evidence.OpenBoundDirNoFollow (or any binding that
+// lets the kernel follow a component) opens the leaf through the junction and turns
+// this test red.
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// p85R6Junction creates one directory junction, or skips the caller when this host
+// cannot create one without elevation.
+func p85R6Junction(t *testing.T, link, target string) {
+	t.Helper()
+	if err := os.MkdirAll(target, 0o755); err != nil {
+		t.Fatalf("create the junction target %s: %v", target, err)
+	}
+	if output, err := exec.Command("cmd", "/c", "mklink", "/J", link, target).CombinedOutput(); err != nil {
+		t.Skipf("this host cannot create the junction %s -> %s without elevation: %v (%s)", link, target, err, strings.TrimSpace(string(output)))
+	}
+	// Registered AFTER t.TempDir's cleanup so it runs first (LIFO): the recursive
+	// removal must never walk through the reparse point.
+	t.Cleanup(func() { _ = os.Remove(link) })
+}
+
+// TestP85R6WindowsCarrierPublishRecheckRefusesAReparse carries the executable half of
+// the T3 binding (the carrier-publication half lives in internal/console, which owns
+// the publication helper).
+func TestP85R6WindowsCarrierPublishRecheckRefusesAReparse(t *testing.T) {
+	root := t.TempDir()
+	realDir := filepath.Join(root, "real")
+	binDir := filepath.Join(realDir, "bin")
+	if err := os.MkdirAll(binDir, 0o755); err != nil {
+		t.Fatalf("create the install-source directory: %v", err)
+	}
+	executable := filepath.Join(binDir, "agent-stub.exe")
+	if err := os.WriteFile(executable, []byte("MZ p85-r6-forensics"), 0o700); err != nil {
+		t.Fatalf("write the executable: %v", err)
+	}
+
+	// Positive control: the same leaf, reached without any reparse component, binds.
+	bound, err := openInstallSourceLeaf(executable)
+	if err != nil {
+		t.Skipf("this host's temporary root is not link-free, so the positive control cannot be established: %v", err)
+	}
+	if err := bound.Close(); err != nil {
+		t.Fatalf("close the bound executable: %v", err)
+	}
+
+	t.Run("an-intermediate-junction-is-refused-with-its-component", func(t *testing.T) {
+		link := filepath.Join(root, "linked")
+		p85R6Junction(t, link, realDir)
+
+		throughLink := filepath.Join(link, "bin", "agent-stub.exe")
+		boundLeaf, err := openInstallSourceLeaf(throughLink)
+		if err == nil {
+			_ = boundLeaf.Close()
+			t.Fatal("an executable reached through an intermediate junction must not bind")
+		}
+		if !errors.Is(err, ErrAIInstallSourceProof) {
+			t.Fatalf("the refusal must be the install-source sentinel, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "is a reparse point") {
+			t.Fatalf("the refusal must be the root-chain classification, got %v", err)
+		}
+		// The refusal has to carry the directory identity that failed, not just the
+		// leaf: an operator needs to know which component to fix.
+		if component := filepath.Base(link); !strings.Contains(err.Error(), component) {
+			t.Fatalf("the refusal must name the reparse component %q, got %v", component, err)
+		}
+
+		// Removing the junction restores the acceptance of the same target, so the
+		// refusal is attributable to the junction and not to the fixture.
+		if err := os.Remove(link); err != nil {
+			t.Fatalf("remove the junction: %v", err)
+		}
+		restored, err := openInstallSourceLeaf(executable)
+		if err != nil {
+			t.Fatalf("the same leaf must bind once the junction is gone, got %v", err)
+		}
+		if err := restored.Close(); err != nil {
+			t.Fatalf("close the re-bound executable: %v", err)
+		}
+	})
+}
diff --git a/internal/adapters/p85_t3_linux_tester_test.go b/internal/adapters/p85_t3_linux_tester_test.go
new file mode 100644
index 0000000..d8333cb
--- /dev/null
+++ b/internal/adapters/p85_t3_linux_tester_test.go
@@ -0,0 +1,330 @@
+//go:build linux
+
+package adapters
+
+// P85 T3 (finding F6) - the Linux half of the install source counterexamples.
+//
+// The Linux rule is: every component of the executable's absolute path (the
+// installation directory included) and of its shebang interpreter must be
+// non-writable by the executing user AND not owned by that user. The superuser can
+// rewrite any path, so euid 0 can never prove it - which is why the positive path
+// skips there instead of pretending.
+//
+// These tests are skipped on Windows by the build tag and, on a Linux run without a
+// provable fixture, by an explicit skip.
+//
+// P85 r1: the same-inode rewrite leg is REGISTERED as an exemption (see its skip
+// message) instead of a bare skip, and the ELF-magic counterexample left open by F3
+// is measured below (TestP85T3LinuxNonELFWithoutShebangIsNotProven).
+//
+// P85 final review (F17): the exemption covers EXACTLY ONE leg - the same-inode
+// rewrite that needs a PRIVILEGED fixture (an install directory that is unwritable
+// AND foreign-owned so the proof succeeds, yet still mutable by the test). The other
+// native counterexamples - the single-right refusals, the same-digest-different-object
+// case and the interpreter-chain drift - are NOT exempted with it: they must run on
+// the native Ubuntu VM (10.0.0.199) as a non-root user, and only a genuinely
+// privileged fixture may be reported as not executed.
+//
+// P85 final review (F18): ② single A changed the interpreter rule to prove the
+// ORIGINAL name chain (openat2 with RESOLVE_NO_SYMLINKS). A linked layout - the
+// merged-/usr shape where /bin/sh or the PT_INTERP loader is a symlink - is now
+// REFUSED, which is the fail-closed branch the review allows. The assertions below
+// therefore expect a refusal on a linked chain instead of a proven target.
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+// p85T3LinuxGuard skips when this build is not Linux or when the process is the
+// superuser, whose three-component rule cannot prove anything.
+func p85T3LinuxGuard(t *testing.T) {
+	t.Helper()
+	if runtime.GOOS != "linux" {
+		t.Skipf("the linux install source rule does not apply on %s", runtime.GOOS)
+	}
+	if os.Geteuid() == 0 {
+		t.Skip("euid 0 cannot prove immutability by design; run this leg as a non-root user")
+	}
+}
+
+// TestP85T3LinuxRefusesWritableInstallDirectory is the "directory became writable"
+// counterexample: a directory this user can write cannot protect a probe.
+func TestP85T3LinuxRefusesWritableInstallDirectory(t *testing.T) {
+	p85T3LinuxGuard(t)
+	dir := t.TempDir()
+	executable := filepath.Join(dir, "copilot")
+	if err := os.WriteFile(executable, []byte("#!/bin/sh\nexit 0\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := VerifyAIInstallSource(executable); !errors.Is(err, ErrAIInstallSourceProof) {
+		t.Fatalf("a writable installation directory must be refused, got %v", err)
+	}
+}
+
+// TestP85T3LinuxRefusesADirectoryThisUserOwns is the ownership half: removing the
+// write bits is not enough while the directory still belongs to the executing user,
+// because that user can restore them.
+func TestP85T3LinuxRefusesADirectoryThisUserOwns(t *testing.T) {
+	p85T3LinuxGuard(t)
+	dir := t.TempDir()
+	executable := filepath.Join(dir, "copilot")
+	if err := os.WriteFile(executable, []byte("#!/bin/sh\nexit 0\n"), 0o555); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(dir, 0o555); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(dir, 0o755) })
+	if _, err := VerifyAIInstallSource(executable); !errors.Is(err, ErrAIInstallSourceProof) {
+		t.Fatalf("a directory owned by the executing user must be refused even without write bits, got %v", err)
+	}
+}
+
+// TestP85T3LinuxShebangInterpreterInWritableDirectoryRefused isolates the
+// interpreter rule: the kernel re-resolves the shebang name at exec time, so an
+// interpreter that lives in a writable directory makes the script unprovable.
+//
+// Mutation check: deleting the verifyUnwritableInstallPath call for the interpreter
+// returns an interpreter fact instead of an error and turns this red.
+func TestP85T3LinuxShebangInterpreterInWritableDirectoryRefused(t *testing.T) {
+	p85T3LinuxGuard(t)
+	dir := t.TempDir()
+	// A real interpreter binary copied into a directory this user owns and can write.
+	realInterpreter, err := os.ReadFile("/bin/sh")
+	if err != nil {
+		t.Skipf("no /bin/sh available to copy: %v", err)
+	}
+	interpreter := filepath.Join(dir, "sh")
+	if err := os.WriteFile(interpreter, realInterpreter, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	script := filepath.Join(dir, "probe-script")
+	if err := os.WriteFile(script, []byte("#!"+interpreter+"\nexit 0\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := installSourceInterpreter(script); err == nil {
+		t.Fatalf("an interpreter in a writable directory must make the script unprovable")
+	}
+}
+
+// TestP85T3LinuxNonELFWithoutShebangIsNotProven is the F3 counterexample added by the
+// r1 review: before the fix a file carrying neither the ELF magic nor a shebang was
+// silently classified as a plain object ("not a script") and passed. The header rule
+// is called directly so the ELF-magic assertion itself is what is measured; going
+// through VerifyAIInstallSource on a temporary fixture would also trip the
+// writable-directory guard and make the leg over-determined.
+//
+// Mutation check: restoring the pre-fix branch that treats every non-shebang file as
+// an executable object turns the plain-text and short-file cases red.
+func TestP85T3LinuxNonELFWithoutShebangIsNotProven(t *testing.T) {
+	p85T3LinuxGuard(t)
+	dir := t.TempDir()
+	candidates := map[string][]byte{
+		"plain-text": []byte("this is an executable candidate with neither magic nor interpreter line\n"),
+		"short-file": []byte("hi"),
+	}
+	for name, body := range candidates {
+		path := filepath.Join(dir, "p85-t3-"+name)
+		if err := os.WriteFile(path, body, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		interpreter, err := installSourceInterpreter(path)
+		if err == nil {
+			t.Fatalf("%s: a non-ELF file without a shebang must not be proven, got interpreter=%+v", name, interpreter)
+		}
+		if !errors.Is(err, ErrAIInstallSourceProof) {
+			t.Fatalf("%s: the refusal must carry ErrAIInstallSourceProof, got %v", name, err)
+		}
+		// Fail-closed at the observation layer too. The writable temporary directory
+		// fires there as well, so only the classification is asserted here.
+		if _, observeErr := VerifyAIInstallSource(path); !errors.Is(observeErr, ErrAIInstallSourceProof) {
+			t.Fatalf("%s: the install source observation must refuse as well, got %v", name, observeErr)
+		}
+	}
+}
+
+// p85T3LinuxPathHasSymlinkComponent reports whether any component of an absolute
+// path is a symbolic link, without following it. It is the test-side oracle for
+// "this layout is linked", so the expectation below is derived from the host and not
+// asserted blindly.
+func p85T3LinuxPathHasSymlinkComponent(path string) bool {
+	cleaned := filepath.Clean(path)
+	current := string(filepath.Separator)
+	for _, part := range strings.Split(strings.TrimPrefix(cleaned, string(filepath.Separator)), string(filepath.Separator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		info, err := os.Lstat(current)
+		if err != nil {
+			return true
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// p85T3LinuxLinkRefusalSet is the closed set of attribution texts that describe a
+// link refusal by openat2 with RESOLVE_NO_SYMLINKS, spelled the way Go renders them.
+const p85T3LinuxLinkRefusalSet = `"symbolic link", "ELOOP", "not a directory", "ENOTDIR"`
+
+// p85T3LinuxLinkRefusalNamesLinkChain reports whether a refusal attributes the
+// refusal to a link in the name chain.
+//
+// openat2 with RESOLVE_NO_SYMLINKS has TWO failure shapes for a linked component,
+// and which one comes back depends on the host layout:
+//
+//   - ELOOP, rendered as "too many levels of symbolic links";
+//   - ENOTDIR, rendered as "not a directory".
+//
+// P85 T3 minimal fix (VM evidence): the native Ubuntu 24.04 VM (10.0.0.199) uses
+// the merged-/usr layout, so /bin is a symlink to usr/bin and openat2 answers
+// `openat /bin: not a directory` instead of ELOOP. The refusal itself is correct -
+// only the text shape differs from the one this leg used to demand. The assertion
+// below therefore pins the refusal to this closed set instead of one spelling; the
+// "the refusal must happen" half stays a hard assertion.
+func p85T3LinuxLinkRefusalNamesLinkChain(err error) bool {
+	if !errors.Is(err, ErrAIInstallSourceProof) {
+		return false
+	}
+	message := err.Error()
+	for _, shape := range []string{"symbolic link", "ELOOP", "not a directory", "ENOTDIR"} {
+		if strings.Contains(message, shape) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestP85T3LinuxELFObjectIsThePositiveControl keeps the F3 refusal honest: a real
+// ELF object carries no shebang and is accepted by the header rule. The test binary
+// itself is that ELF object, so no privileged fixture is needed.
+//
+// P85 F07: an ELF object is not automatically interpreter-free. A DYNAMIC object is
+// exec'd through its PT_INTERP loader, and the kernel re-resolves that loader at exec
+// time, so the observation must record (and immutability-verify) it; only a STATIC
+// object is exec'd directly and records none.
+//
+// P85 F18: the loader is verified from its ORIGINAL name chain (openat2 with
+// RESOLVE_NO_SYMLINKS), so on a merged-/usr host - where the PT_INTERP loader is a
+// symlink - the correct outcome is a fail-closed REFUSAL, not a proof through the
+// link target. The old assertion demanded a successful proof and would go red there.
+// The host's own layout decides which expectation applies; the ELF header, not the
+// filesystem, decides whether a loader exists at all.
+func TestP85T3LinuxELFObjectIsThePositiveControl(t *testing.T) {
+	p85T3LinuxGuard(t)
+	self, err := os.Executable()
+	if err != nil {
+		t.Skipf("the test binary cannot be located: %v", err)
+	}
+	body, err := os.ReadFile(self)
+	if err != nil {
+		t.Fatalf("read the test binary %q: %v", self, err)
+	}
+	// The header rule is pure: it describes the object, not the permissions of the
+	// directory the test binary happens to sit in (which this user owns, so the whole
+	// path walk would refuse it for the writable-directory reason).
+	loader, err := installSourceELFInterpreter(body, self)
+	if err != nil {
+		t.Fatalf("the ELF header of the test binary must be well formed, got %v", err)
+	}
+	if loader == "" {
+		// Static object: the kernel execs it directly, so no interpreter is recorded.
+		return
+	}
+	verified, verifyErr := installSourceVerifyInterpreter(loader, self, 0)
+	if p85T3LinuxPathHasSymlinkComponent(loader) {
+		if verifyErr == nil {
+			t.Fatalf("a linked PT_INTERP chain (%q) must be refused, got %+v", loader, verified)
+		}
+		if !errors.Is(verifyErr, ErrAIInstallSourceProof) {
+			t.Fatalf("the refusal must carry ErrAIInstallSourceProof, got %v", verifyErr)
+		}
+		if !strings.Contains(verifyErr.Error(), "symbolic link") {
+			t.Fatalf("the refusal must name the link chain, not some other rule: %q", verifyErr)
+		}
+		return
+	}
+	if verifyErr != nil {
+		t.Fatalf("a link-free PT_INTERP loader %q must be provable, got %v", loader, verifyErr)
+	}
+	if verified == nil {
+		t.Fatalf("a dynamic ELF must record its PT_INTERP loader %q", loader)
+	}
+	if filepath.Clean(verified.Path) != filepath.Clean(loader) {
+		t.Fatalf("the recorded interpreter must be the ORIGINAL loader name %q, got %q", loader, verified.Path)
+	}
+	if verified.Hash == "" || verified.FileID == "" {
+		t.Fatalf("the recorded interpreter must carry its digest and object identity, got %+v", verified)
+	}
+}
+
+// TestP85T3LinuxLinkedInterpreterChainIsRefused is the F18 native counterexample for
+// the single-A rule: the kernel walks the ORIGINAL interpreter name chain, so a link
+// anywhere in it cannot be described by the rule and must be refused instead of
+// proven through its target.
+//
+// The expectation is derived from the host: on a merged-/usr Ubuntu run /bin/sh is a
+// symlink and the refusal is the correct outcome; on a link-free layout the same call
+// must succeed, which keeps the refusal from being satisfied by refusing everything.
+//
+// P85 T3 minimal fix: the refusal must HAPPEN (hard assertion) and must be attributed
+// to the link rule, but the attribution text is taken from a closed set - openat2 with
+// RESOLVE_NO_SYMLINKS reports a linked component as ELOOP ("symbolic link") on some
+// layouts and as ENOTDIR ("not a directory") on the merged-/usr Ubuntu 24.04 VM, where
+// /bin is a symlink to usr/bin and the VM run observed `openat /bin: not a directory`.
+func TestP85T3LinuxLinkedInterpreterChainIsRefused(t *testing.T) {
+	p85T3LinuxGuard(t)
+	const interpreter = "/bin/sh"
+	linked := p85T3LinuxPathHasSymlinkComponent(interpreter)
+	proven, err := installSourceInterpreter(interpreter)
+	if linked {
+		if err == nil {
+			t.Fatalf("a linked interpreter chain (%q) must be refused, got %+v", interpreter, proven)
+		}
+		if !errors.Is(err, ErrAIInstallSourceProof) {
+			t.Fatalf("the refusal must carry ErrAIInstallSourceProof, got %v", err)
+		}
+		if !p85T3LinuxLinkRefusalNamesLinkChain(err) {
+			t.Fatalf("the refusal must name the link chain (one of %s), not some other rule: %q", p85T3LinuxLinkRefusalSet, err)
+		}
+		return
+	}
+	if err != nil {
+		t.Fatalf("a link-free interpreter %q must be provable, got %v", interpreter, err)
+	}
+	if proven == nil {
+		t.Fatalf("the interpreter %q must be reported, got nil", interpreter)
+	}
+}
+
+// TestP85T3LinuxSameInodeRewriteRequiresAPrivilegedFixture registers the one Linux
+// counterexample that cannot be built from this process: it needs an install
+// directory that is BOTH unwritable and foreign-owned (so the proof succeeds) and
+// still mutable by the test (so an in-place rewrite can be attempted).
+//
+// P85 r1 F1 / P85 final review F17: this skip is an EXEMPTION REGISTRATION, not a
+// silent gap. Its four elements are in the skip message itself so the test log
+// carries them verbatim, and the same text is the entry for this slice's report and
+// the ⑦ input package.
+//
+// F17 scope (final review): this exemption covers the SAME-INODE PRIVILEGED FIXTURE
+// LEG ONLY. The other native counterexamples are NOT covered and must not be
+// reported as exempt with it: the single-right refusals
+// (TestP85T3LinuxRefusesWritableInstallDirectory,
+// TestP85T3LinuxRefusesADirectoryThisUserOwns), the refusal of a linked interpreter
+// chain (TestP85T3LinuxLinkedInterpreterChainIsRefused) and the interpreter drift
+// assertions of TestP85T3LinuxELFObjectIsThePositiveControl. They run as a non-root
+// user on the native Ubuntu VM together with ⑨; only a genuinely privileged fixture
+// may be registered as not executed.
+func TestP85T3LinuxSameInodeRewriteRequiresAPrivilegedFixture(t *testing.T) {
+	p85T3LinuxGuard(t)
+	t.Skip("EXEMPT-REGISTERED P85/F1-F17 | scope: the same-inode rewrite leg ONLY | reason: an end-to-end same-inode rewrite needs a fixture directory that is unwritable AND foreign-owned (so the proof succeeds) yet still mutable by the test (so the rewrite can be attempted); building it needs root chown - the ownership rule is part of the ②b-2 verdict - and the VM's larson account has no passwordless sudo, so the privileged fixture is not constructible in this round | not exempted with it: the single-right refusals, the same-digest-different-object case and the interpreter-chain drift, which must run natively as a non-root user on the Ubuntu VM with ⑨ | carried-by: TestP85T3WritableInstallDirectoryIsNotProven (a writable installation directory is refused) and TestP85T3MatchesDetectsAChangedObservation (the same fileID with a changed digest stops matching, which is what an in-place rewrite produces) | destination: this slice's report and the ⑦ review input package")
+}
diff --git a/internal/adapters/p85_t3_tester_test.go b/internal/adapters/p85_t3_tester_test.go
new file mode 100644
index 0000000..496646f
--- /dev/null
+++ b/internal/adapters/p85_t3_tester_test.go
@@ -0,0 +1,223 @@
+package adapters
+
+// P85 T3 (finding F6) - the install source counterexamples at the adapter boundary.
+//
+// Two layers are pinned here:
+//
+//  1. the observation itself (VerifyAIInstallSource) refuses a source this user can
+//     mutate, and the carrier it produces cannot be decoded into a weaker claim;
+//  2. Execute re-observes the source immediately before the spawn, so a probe that
+//     was admitted earlier still refuses to start while the credential is in hand.
+//
+// The refusal evidence must stay a stable classification, never a path or a set of
+// permission bits (T8b discipline).
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+)
+
+// p85T3WriteSpawnMarkerScript writes an executable script that creates marker when
+// it runs. A refused probe must leave marker absent, which is the observable form
+// of "the child was never created".
+func p85T3WriteSpawnMarkerScript(t *testing.T, dir, marker string) string {
+	t.Helper()
+	var name, body string
+	if runtime.GOOS == "windows" {
+		name = "p85-t3-probe.cmd"
+		body = "@echo off\r\n: > \"" + marker + "\" echo ran\r\n"
+	} else {
+		name = "p85-t3-probe.sh"
+		body = "#!/bin/sh\n: > '" + marker + "'\n"
+	}
+	path := filepath.Join(dir, name)
+	if err := os.WriteFile(path, []byte(body), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+// TestP85T3WritableInstallDirectoryIsNotProven is the "the source became writable"
+// counterexample at the observation layer: a temporary directory grants this user
+// write, delete and permission rights, so immutability cannot be proven there.
+//
+// Mutation check: the Windows ACL capability probe and the Unix mode/owner walk are
+// the only guards that turn this red when removed.
+func TestP85T3WritableInstallDirectoryIsNotProven(t *testing.T) {
+	dir := t.TempDir()
+	executable := filepath.Join(dir, "copilot")
+	if err := os.WriteFile(executable, []byte("p85-t3-writable-probe"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	facts, err := VerifyAIInstallSource(executable)
+	if err == nil {
+		t.Fatalf("a writable installation source must not be proven, got facts=%+v", facts)
+	}
+	if !errors.Is(err, ErrAIInstallSourceProof) {
+		t.Fatalf("the refusal must carry ErrAIInstallSourceProof, got %v", err)
+	}
+}
+
+// TestP85T3ExecuteRefusesUnprovableInstallSourceWithoutSpawning is the pre-spawn
+// counterexample: the child never runs, the evidence is the stable classification,
+// and the temporary root the executor created is cleaned up.
+//
+// Mutation check: deleting (or short-circuiting) the VerifyAIInstallSource call in
+// Execute lets the script run and turns this red on the marker assertion.
+func TestP85T3ExecuteRefusesUnprovableInstallSourceWithoutSpawning(t *testing.T) {
+	dir := t.TempDir()
+	marker := filepath.Join(dir, "spawned.marker")
+	executable := p85T3WriteSpawnMarkerScript(t, dir, marker)
+
+	executor := ManagedCopilotCLIProbeExecutor{TemporaryDirectory: dir, Timeout: 5 * time.Second}
+	execution := executor.Execute(context.Background(), CopilotCLIProbeInvocation{
+		Executable:       executable,
+		WorkingDirectory: dir,
+	})
+	if execution.Outcome != "start-failed" {
+		t.Fatalf("an unprovable install source must refuse the start, got outcome=%q evidence=%v", execution.Outcome, execution.Evidence)
+	}
+	want := copilotCLIExecutorEvidence("install-source-unproven")
+	if len(execution.Evidence) != 1 || execution.Evidence[0] != want {
+		t.Fatalf("the refusal must be the closed-set install-source classification %q, got %v", want, execution.Evidence)
+	}
+	if _, err := os.Stat(marker); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("the probe must not be spawned, marker stat err=%v", err)
+	}
+}
+
+// p85T3WindowsProof builds a well-formed carrier body for the platform named by the
+// proof. It never touches the platform it names, so it can be built on any host.
+func p85T3WindowsProof(executablePath string) AIInstallSourceProof {
+	hash := p85T3Hash("p85-t3-executable")
+	return NewAIInstallSourceProof(AIInstallSourceFacts{
+		ExecutablePath: executablePath,
+		ExecutableHash: hash,
+		FileID:         "win32:1:2:3",
+		Platform:       AIInstallSourcePlatformFor("windows", "amd64"),
+		Immutability: AIInstallSourceImmutability{Windows: &AIInstallSourceWindowsFacts{
+			DirACLDeniesWriteDelete: true,
+			ACLEvidenceHash:         p85T3Hash("p85-t3-acl"),
+		}},
+	}, time.Date(2026, 9, 8, 10, 0, 0, 0, time.UTC))
+}
+
+func p85T3Hash(seed string) string {
+	return AIInstallSourceProofDigest([]byte(seed))
+}
+
+// p85T3HostAbsoluteExecutable returns a host-absolute path under a fresh temporary
+// directory.
+//
+// P85 F16: the carrier fixture used to be the literal `C:\Program Files\...`, and
+// AIInstallSourceProof.Validate decides "absolute" with filepath.IsAbs - which is
+// false on Linux for a Windows drive letter, so the SHARED positive case failed at
+// encode on the Linux leg. The fixture must therefore come from the host's own temp
+// root, which is absolute on every platform the shared test compiles for.
+func p85T3HostAbsoluteExecutable(t *testing.T, name string) string {
+	t.Helper()
+	return filepath.Join(t.TempDir(), name)
+}
+
+// TestP85T3CarrierDecodeRefusesAWeakenedOrMixedClaim pins the carrier as a claim
+// that cannot be decoded into something weaker than it says: a dropped ACL verdict,
+// a platform/fact mixture, an unknown platform and a malformed body are all refusals.
+//
+// Mutation check: deleting the corresponding branch of AIInstallSourceProof.Validate
+// turns the matching case green and this red.
+func TestP85T3CarrierDecodeRefusesAWeakenedOrMixedClaim(t *testing.T) {
+	valid := p85T3WindowsProof(p85T3HostAbsoluteExecutable(t, "copilot.exe"))
+	wire, err := EncodeAIInstallSourceProof(valid)
+	if err != nil {
+		t.Fatalf("a well-formed carrier must encode: %v", err)
+	}
+	decoded, err := DecodeAIInstallSourceProof(wire)
+	if err != nil {
+		t.Fatalf("a well-formed carrier must decode: %v", err)
+	}
+	if decoded.ExecutableHash != valid.ExecutableHash || decoded.FileID != valid.FileID ||
+		decoded.Platform != valid.Platform || decoded.Immutability.Windows == nil ||
+		!decoded.Immutability.Windows.DirACLDeniesWriteDelete {
+		t.Fatalf("the decoded carrier lost a fact: %+v", decoded)
+	}
+
+	weakenedACL := valid
+	weakenedACL.Immutability = AIInstallSourceImmutability{Windows: &AIInstallSourceWindowsFacts{
+		DirACLDeniesWriteDelete: false,
+		ACLEvidenceHash:         valid.Immutability.Windows.ACLEvidenceHash,
+	}}
+	mixedPlatform := valid
+	mixedPlatform.Immutability = AIInstallSourceImmutability{Linux: &AIInstallSourceLinuxFacts{
+		UnwritablePath:        true,
+		OwnershipEvidenceHash: p85T3Hash("p85-t3-ownership"),
+	}}
+	unknownPlatform := valid
+	unknownPlatform.Platform = AIInstallSourcePlatformFor("darwin", "arm64")
+	relativePath := valid
+	relativePath.ExecutablePath = "copilot.exe"
+
+	for name, proof := range map[string]AIInstallSourceProof{
+		"acl-does-not-deny-write": weakenedACL,
+		"platform-fact-mismatch":  mixedPlatform,
+		"unknown-platform":        unknownPlatform,
+		"relative-path":           relativePath,
+	} {
+		body, encodeErr := EncodeAIInstallSourceProof(proof)
+		if encodeErr != nil {
+			t.Fatalf("%s: the body must still encode so the DECODER is what refuses: %v", name, encodeErr)
+		}
+		if _, decodeErr := DecodeAIInstallSourceProof(body); decodeErr == nil {
+			t.Fatalf("%s: a weakened or mixed claim must be refused at decode", name)
+		}
+	}
+	if _, err := DecodeAIInstallSourceProof([]byte(`{"schemaVersion":1`)); err == nil {
+		t.Fatal("a malformed body must be refused at decode")
+	}
+}
+
+// TestP85T3MatchesDetectsAChangedObservation pins the comparison the command uses:
+// any change of digest, identity, platform or permission fact makes the memo stop
+// describing the live source.
+func TestP85T3MatchesDetectsAChangedObservation(t *testing.T) {
+	proof := p85T3WindowsProof(p85T3HostAbsoluteExecutable(t, "copilot.exe"))
+	facts := AIInstallSourceFacts{
+		ExecutablePath: proof.ExecutablePath,
+		ExecutableHash: proof.ExecutableHash,
+		FileID:         proof.FileID,
+		Platform:       proof.Platform,
+		Immutability:   proof.Immutability,
+	}
+	if !facts.Matches(proof) {
+		t.Fatal("an identical observation must match the carrier")
+	}
+	changedHash := facts
+	changedHash.ExecutableHash = p85T3Hash("p85-t3-swapped-bytes")
+	changedIdentity := facts
+	changedIdentity.FileID = "win32:1:2:4"
+	changedPlatform := facts
+	changedPlatform.Platform = AIInstallSourcePlatformFor("windows", "arm64")
+	changedACL := facts
+	changedACL.Immutability = AIInstallSourceImmutability{Windows: &AIInstallSourceWindowsFacts{
+		DirACLDeniesWriteDelete: true,
+		ACLEvidenceHash:         p85T3Hash("p85-t3-acl-after-a-loosening"),
+	}}
+	changedPath := facts
+	changedPath.ExecutablePath = p85T3HostAbsoluteExecutable(t, "other.exe")
+
+	for name, observation := range map[string]AIInstallSourceFacts{
+		"changed-digest":   changedHash,
+		"changed-identity": changedIdentity,
+		"changed-platform": changedPlatform,
+		"changed-acl":      changedACL,
+		"changed-path":     changedPath,
+	} {
+		if observation.Matches(proof) {
+			t.Fatalf("%s: a changed observation must not match the carrier", name)
+		}
+	}
+}
diff --git a/internal/adapters/p85_t3_windows_f04_tester_test.go b/internal/adapters/p85_t3_windows_f04_tester_test.go
