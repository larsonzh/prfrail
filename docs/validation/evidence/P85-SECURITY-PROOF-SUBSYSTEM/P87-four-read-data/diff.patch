diff --git a/internal/console/p85_f01_domain_tester_test.go b/internal/console/p85_f01_domain_tester_test.go
new file mode 100644
index 0000000..7ee9628
--- /dev/null
+++ b/internal/console/p85_f01_domain_tester_test.go
@@ -0,0 +1,267 @@
+package console
+
+// P85 F01 (design rev 3, section 8, rows M1-M3): the frozen-policy write domain is
+// the policy directory, its PARENT and every existing artifact/anchor file, and the
+// assembly option that used to let an out-of-package caller inject a well-formed
+// proof is gone.
+//
+// The end-to-end counterexample the design names - "directory not writable while the
+// artifact IS owned by the running user" - needs a directory this token cannot write
+// and a file it can. Neither is constructible from an unprivileged test on either
+// platform (a foreign owner needs chown/SeTakeOwnership), so the locally measurable
+// form of the same fact is used instead: on this host every object of the domain is
+// writable by the running identity, so the proof refuses and the refusal NAMES each
+// observed object. Dropping an object from the observation therefore removes it from
+// the refusal (M1: the artifact, M2: the parent) and changes the observation digest,
+// which is exactly what the two named mutations have to break.
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/chain"
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85F01ArtifactAndAnchor returns the two names the reuse branch must observe for
+// the one task attempt the T2 fixtures use.
+func p85F01ArtifactAndAnchor(runtime *agentRunnerRuntime) (string, string) {
+	return agentRunnerFrozenPolicyPath(runtime.runRoot, p83TaskID, p83StepID, 1),
+		agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+}
+
+// TestP85F01PolicyDomainObservesEachExistingFile is M1: the reuse branch must fold
+// the existing artifact AND its anchor into the observation, before a single byte of
+// either is read.
+//
+// Mutation checks:
+//   - drop the `existing` argument from the reuse branch's
+//     agentRunnerProvePolicyWriteProtection call => the refusal no longer names the
+//     artifact or the anchor and "the-refusal-names-each-existing-file" goes red;
+//   - drop the existing entries from managedAgentPolicyDomainObjects => the
+//     observation digest stops depending on the artifact's identity and
+//     "the-digest-tracks-the-artifact-identity" goes red.
+func TestP85F01PolicyDomainObservesEachExistingFile(t *testing.T) {
+	t.Run("the-refusal-names-each-existing-file", func(t *testing.T) {
+		runtime, _ := p85FrozenReviewRuntime(t)
+		artifactPath, anchorPath := p85F01ArtifactAndAnchor(runtime)
+		body := p85PolicyBody(runtime.runID+"-chain", p83TaskID)
+
+		// The production seam: no injected proof, so the real domain observation runs
+		// on the reuse branch - which is the branch that must pass existing files.
+		_, err := persistAgentRunnerFrozenPolicyProven(runtime.store, runtime.runRoot, runtime.runID, p83TaskID, p83StepID, 1, body, "")
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("a domain this identity can write must refuse the reuse branch, got %v", err)
+		}
+		message := err.Error()
+		for _, name := range []string{artifactPath, anchorPath} {
+			if !strings.Contains(message, fmt.Sprintf("%q", name)) {
+				t.Fatalf("the refusal must name the observed existing file %s, got %v", name, err)
+			}
+		}
+	})
+
+	t.Run("the-digest-tracks-the-artifact-identity", func(t *testing.T) {
+		root := t.TempDir()
+		policy := filepath.Join(root, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		artifact := filepath.Join(policy, "artifact.json")
+		if err := os.WriteFile(artifact, []byte("policy"), 0o600); err != nil {
+			t.Fatalf("write the artifact: %v", err)
+		}
+
+		// Standing in for the replacement object, prepared OUTSIDE the observed
+		// domain so the first observation is not disturbed by its presence.
+		standIn := filepath.Join(t.TempDir(), "stand-in.json")
+		if err := os.WriteFile(standIn, []byte("policy"), 0o600); err != nil {
+			t.Fatalf("write the stand-in artifact: %v", err)
+		}
+
+		before, beforeErr := adapters.VerifyManagedAgentCannotWritePolicyDomain(policy, []string{artifact})
+		if beforeErr == nil {
+			t.Fatalf("the fixture must place the domain inside a directory this identity can write, so the proof refuses; got success")
+		}
+		if before == "" {
+			t.Fatal("a refused observation must still carry the observation digest")
+		}
+
+		// Same path, same bytes, DIFFERENT object: only the per-file identity can
+		// tell the two observations apart.
+		//
+		// Replace by RENAME, never by remove-then-recreate: measured on Linux/ext4, a
+		// delete followed by a same-directory create inside a short window routinely
+		// hands the freed inode back, so dev:ino - and therefore the digest - does not
+		// move and this check reports a false red. A rename keeps the inode of the file
+		// being renamed, so the new artifact carries the STAND-IN's inode while the
+		// retired one still holds the old inode; the two identities cannot coincide.
+		retired := artifact + ".old"
+		if err := os.Rename(artifact, retired); err != nil {
+			t.Fatalf("retire the artifact: %v", err)
+		}
+		if err := os.Rename(standIn, artifact); err != nil {
+			t.Fatalf("promote the stand-in artifact: %v", err)
+		}
+		after, _ := adapters.VerifyManagedAgentCannotWritePolicyDomain(policy, []string{artifact})
+		if after == before {
+			t.Fatalf("replacing the observed artifact must change the observation digest, got %s twice", before)
+		}
+		if err := os.Remove(retired); err != nil {
+			t.Fatalf("remove the retired artifact: %v", err)
+		}
+	})
+}
+
+// TestP85F01PolicyDomainObservesTheParentIdentity is M2: the parent of the policy
+// directory gates rename/replace of the directory entry itself, so its identity is
+// part of the observation.
+//
+// The layout keeps the policy directory's OWN identity and spelling unchanged and
+// replaces only its parent object (rename the parent away, recreate it, move the
+// policy directory back to the same path). A digest that does not include the
+// parent therefore cannot tell the two layouts apart.
+//
+// Mutation checks:
+//   - drop the parent object from managedAgentPolicyDomainObjects => "the-digest-
+//     tracks-the-parent-identity" goes red (identical digests);
+//   - the creation branch's refusal stops naming the parent => "the-creation-branch-
+//     names-the-parent" goes red.
+func TestP85F01PolicyDomainObservesTheParentIdentity(t *testing.T) {
+	t.Run("the-creation-branch-names-the-parent", func(t *testing.T) {
+		runtime := p83Runtime(t, chain.AuthorizationLedger{})
+		p85AttachFrozenPolicyStore(t, runtime)
+		body := p85PolicyBody(runtime.runID+"-chain", p83TaskID)
+		_, err := persistAgentRunnerFrozenPolicyProven(runtime.store, runtime.runRoot, runtime.runID, p83TaskID, p83StepID, 1, body, "")
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("the creation branch must refuse an unprovable write domain, got %v", err)
+		}
+		parent := filepath.Dir(agentRunnerPolicyDirectory(runtime.runRoot))
+		if !strings.Contains(err.Error(), fmt.Sprintf("%q", parent)) {
+			t.Fatalf("the creation branch must observe the parent directory %s, got %v", parent, err)
+		}
+	})
+
+	t.Run("the-digest-tracks-the-parent-identity", func(t *testing.T) {
+		root := t.TempDir()
+		parent := filepath.Join(root, "run-root")
+		if err := os.MkdirAll(parent, 0o755); err != nil {
+			t.Fatalf("create the parent: %v", err)
+		}
+		policy := filepath.Join(parent, "agent-runner-policy")
+		if err := os.MkdirAll(policy, 0o755); err != nil {
+			t.Fatalf("create the policy directory: %v", err)
+		}
+		before, _ := adapters.VerifyManagedAgentCannotWritePolicyDomain(policy, nil)
+		if before == "" {
+			t.Fatal("a refused observation must still carry the observation digest")
+		}
+		policyIDBefore, err := evidence.FileIDAt(policy)
+		if err != nil {
+			t.Fatalf("identify the policy directory: %v", err)
+		}
+		parentIDBefore, err := evidence.FileIDAt(parent)
+		if err != nil {
+			t.Fatalf("identify the parent directory: %v", err)
+		}
+
+		// Replace the PARENT object while keeping the policy directory's inode and
+		// final spelling: rename the parent away, recreate it, move the policy
+		// directory back to the exact same path.
+		retired := parent + "-retired"
+		if err := os.Rename(parent, retired); err != nil {
+			t.Fatalf("rename the parent away: %v", err)
+		}
+		if err := os.Mkdir(parent, 0o755); err != nil {
+			t.Fatalf("recreate the parent: %v", err)
+		}
+		if err := os.Rename(filepath.Join(retired, "agent-runner-policy"), policy); err != nil {
+			t.Fatalf("move the policy directory back to its own spelling: %v", err)
+		}
+
+		policyIDAfter, err := evidence.FileIDAt(policy)
+		if err != nil {
+			t.Fatalf("identify the moved policy directory: %v", err)
+		}
+		parentIDAfter, err := evidence.FileIDAt(parent)
+		if err != nil {
+			t.Fatalf("identify the recreated parent: %v", err)
+		}
+		if policyIDAfter != policyIDBefore {
+			t.Fatalf("the fixture must keep the policy directory object: %s -> %s", policyIDBefore, policyIDAfter)
+		}
+		if parentIDAfter == parentIDBefore {
+			t.Fatalf("the fixture must replace the parent object: both identities are %s", parentIDAfter)
+		}
+
+		after, _ := adapters.VerifyManagedAgentCannotWritePolicyDomain(policy, nil)
+		if after == before {
+			t.Fatalf("replacing the observed parent must change the observation digest, got %s twice", before)
+		}
+	})
+}
+
+// TestP85F01AssemblyOptionsCarryNoExportedWriteProof is M3: the bypass review r1
+// named ("an exported option accepts any well-formed digest") is closed at COMPILE
+// time, not by a runtime check.
+//
+// Mutation check: rename the field back to the exported ManagedWriteProof => the
+// reflection assertion goes red (and any out-of-package use would then compile, which
+// the source scan below also refuses).
+func TestP85F01AssemblyOptionsCarryNoExportedWriteProof(t *testing.T) {
+	options := reflect.TypeOf(AgentRunnerAssemblyOptions{})
+	if field, found := options.FieldByName("ManagedWriteProof"); found {
+		t.Fatalf("AgentRunnerAssemblyOptions must not expose a write-proof field (found %s, exported=%v)", field.Name, field.PkgPath == "")
+	}
+	field, found := options.FieldByName("managedWriteProof")
+	if !found {
+		t.Fatal("the in-package test seam managedWriteProof must still exist")
+	}
+	if field.PkgPath == "" {
+		t.Fatal("the test seam must stay unexported, otherwise any out-of-package caller can inject a proof")
+	}
+
+	// Compile-surface scan: no production file outside this package may name the
+	// identifier. An out-of-package bypass needs the name, so this is the executable
+	// form of the design's `grep ManagedWriteProof` evidence.
+	moduleRoot := filepath.Join("..", "..")
+	violations := []string{}
+	err := filepath.WalkDir(moduleRoot, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() {
+			switch entry.Name() {
+			case ".git", "tmp", "build", "node_modules":
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		if strings.HasPrefix(filepath.ToSlash(path), filepath.ToSlash(filepath.Join(moduleRoot, "internal", "console"))+"/") {
+			return nil
+		}
+		data, readErr := os.ReadFile(path)
+		if readErr != nil {
+			return readErr
+		}
+		if strings.Contains(string(data), "ManagedWriteProof") {
+			violations = append(violations, path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("scan the module for out-of-package write-proof entries: %v", err)
+	}
+	if len(violations) > 0 {
+		t.Fatalf("only the console package may know the write-proof identifier, found %v", violations)
+	}
+}
diff --git a/internal/console/p85_f02_publish_handle_linux_test.go b/internal/console/p85_f02_publish_handle_linux_test.go
new file mode 100644
index 0000000..8095bd3
--- /dev/null
+++ b/internal/console/p85_f02_publish_handle_linux_test.go
@@ -0,0 +1,81 @@
+//go:build linux
+
+package console
+
+// P85 F02/F06/F20 (design rev 3, section 2 / test row M4): T2's publication must
+// happen inside the VERIFIED directory descriptor, exactly like T3's carrier.
+//
+// The counterexample binds a directory, then renames it away and puts a decoy at the
+// same spelling. A path-based publication (the pre-fix shape: os.CreateTemp +
+// os.Link) writes into the decoy; a handle-based publication writes into the object
+// the binding produced, which is the whole point of the identity chain.
+//
+// Mutation check: revert publishAgentRunnerPolicyFileIn to the path-based
+// CreateTemp + Link form => the payload lands in the decoy directory and both
+// assertions below go red.
+//
+// Windows note: the Windows half is deliberately path-based (Go cannot create or
+// link relative to a directory handle there) and its final-name residue is the
+// registered F04 exemption, so this leg is Linux-only by design.
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+func TestP85F02PublicationStaysInsideTheBoundDirectory(t *testing.T) {
+	root := t.TempDir()
+	live := filepath.Join(root, "agent-runner-policy")
+	if err := os.MkdirAll(live, 0o755); err != nil {
+		t.Fatalf("create the policy directory: %v", err)
+	}
+
+	bound, fileID, err := evidence.OpenBoundDirVerified(live)
+	if err != nil {
+		t.Fatalf("bind the policy directory: %v", err)
+	}
+	defer func() { _ = bound.Close() }()
+
+	// Swap the name AFTER the binding. The handle still addresses the original
+	// object; the spelling now addresses a decoy.
+	retired := live + "-retired"
+	if err := os.Rename(live, retired); err != nil {
+		t.Fatalf("rename the bound directory away: %v", err)
+	}
+	if err := os.MkdirAll(live, 0o755); err != nil {
+		t.Fatalf("create the decoy directory: %v", err)
+	}
+
+	payload := []byte("frozen policy payload")
+	if err := publishAgentRunnerPolicyFileIn(bound, fileID, live, "artifact.json", payload, "frozen policy artifact"); err != nil {
+		t.Fatalf("the publication must succeed inside the bound handle: %v", err)
+	}
+
+	published := filepath.Join(retired, "artifact.json")
+	data, err := os.ReadFile(published)
+	if err != nil {
+		t.Fatalf("the payload must land in the object the binding produced: %v", err)
+	}
+	if string(data) != string(payload) {
+		t.Fatalf("the published payload must be byte-identical, got %q want %q", data, payload)
+	}
+	if _, err := os.Stat(filepath.Join(live, "artifact.json")); !os.IsNotExist(err) {
+		t.Fatalf("nothing may be written through the replaced spelling, stat err=%v", err)
+	}
+	// The decoy must also carry no leftover temporary entry: the whole publication
+	// happens inside the bound descriptor.
+	entries, err := os.ReadDir(live)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		names := make([]string, 0, len(entries))
+		for _, entry := range entries {
+			names = append(names, entry.Name())
+		}
+		t.Fatalf("the replaced spelling must receive no entries, found %v", names)
+	}
+}
diff --git a/internal/console/p85_f06_anchor_domain_tester_test.go b/internal/console/p85_f06_anchor_domain_tester_test.go
new file mode 100644
index 0000000..ff92398
--- /dev/null
+++ b/internal/console/p85_f06_anchor_domain_tester_test.go
@@ -0,0 +1,132 @@
+package console
+
+// P85 review r1 (new Medium), design rev 3 section 6 / test row M10: Review and
+// Publish must re-verify the anchor's managed-identity write proof against a FRESH
+// observation of THIS policy domain, not against the digest's FORMAT.
+//
+// The counterexample has to be a well-formed digest, so that the format check
+// (evidence.ValidHash) cannot be what refuses it: the anchor is rewritten with the
+// observation of ANOTHER directory - a layout this identity can write, so its
+// observation is a real, valid digest of a different write domain.
+//
+// Mutation check: dropping the agentRunnerReverifyManagedWriteProof call from
+// agentRunnerVerifyFrozenPolicyAnchor (back to the ValidHash-only check) makes the
+// review - and the publish - approve, turning both legs red.
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/chain"
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85F06ForeignDomainProof returns a WELL-FORMED digest produced from a different
+// write domain. The observation is taken from the real primitive on a throwaway
+// directory, so the value is a genuine proof of another layout rather than a random
+// hash; hosts where the primitive cannot even produce a digest fall back to a
+// well-formed constant, which still passes the format check.
+func p85F06ForeignDomainProof(t *testing.T) string {
+	t.Helper()
+	directory := filepath.Join(t.TempDir(), "another-policy-domain")
+	if err := os.MkdirAll(directory, 0o755); err != nil {
+		t.Fatalf("create the foreign policy domain: %v", err)
+	}
+	observed, _ := adapters.VerifyManagedAgentCannotWritePolicyDomain(directory, nil)
+	if observed == "" || observed == assemblyManagedWriteProof || !evidence.ValidHash(observed) {
+		observed = "sha256:" + strings.Repeat("3", 64)
+	}
+	return observed
+}
+
+func p85F06RequireAnchorProofMismatch(t *testing.T, err error) {
+	t.Helper()
+	if !errors.Is(err, ErrInvalidConfig) {
+		t.Fatalf("an anchor whose proof describes another domain must be refused with ErrInvalidConfig, got %v", err)
+	}
+	if !strings.Contains(err.Error(), "is not the proof of the domain") {
+		t.Fatalf("the refusal must come from the fresh observation, not from the digest format, got %v", err)
+	}
+}
+
+func TestP85F06AnchorProofFromAnotherDomainRefusesReview(t *testing.T) {
+	runtime, _ := p85FrozenReviewRuntime(t)
+	anchorPath := agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+	foreign := p85F06ForeignDomainProof(t)
+	original, _ := p85RewriteAnchorProof(t, runtime, foreign)
+
+	decision, err := runtime.Review(context.Background(), p85ReviewRequest())
+	p85F06RequireAnchorProofMismatch(t, err)
+	if decision.Outcome != "" || decision.PolicyHash != "" || len(decision.Evidence) != 0 {
+		t.Fatalf("a refused review must produce no decision, got %+v", decision)
+	}
+
+	// The anchor is the sole cause: restoring the bytes approves the same runtime.
+	if err := os.WriteFile(anchorPath, original, 0o600); err != nil {
+		t.Fatalf("restore the frozen policy anchor: %v", err)
+	}
+	restored, err := runtime.Review(context.Background(), p85ReviewRequest())
+	if err != nil {
+		t.Fatalf("the restored anchor must approve, got %v", err)
+	}
+	if restored.Outcome != "approve" {
+		t.Fatalf("restoring the anchor must approve the review, got %+v", restored)
+	}
+}
+
+func TestP85F06AnchorProofFromAnotherDomainRefusesPublish(t *testing.T) {
+	runtime, runRoot := p83PublishRuntime(t)
+	proof, err := claimPublishLease(context.Background(), runRoot, p83RunID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	runtime.publishLease = proof
+	if _, err := runtime.Review(context.Background(), p85ReviewRequest()); err != nil {
+		t.Fatalf("the review must approve before the publish leg: %v", err)
+	}
+	evidenceRoot, err := runtime.evidenceRootHash(p83TaskID, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := chain.PromotionRequest{
+		RunID:                 p83RunID,
+		TaskID:                p83TaskID,
+		Attempt:               1,
+		CandidateSnapshotHash: evidence.Digest("", []byte("candidate")),
+		EvidenceRootHash:      evidenceRoot,
+		ReviewReceiptHash:     evidence.Digest("", []byte("review-receipt")),
+	}
+	anchorPath := agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+	artifactBefore := p85ReadFrozenPolicyBytes(t, runtime)
+	original, _ := p85RewriteAnchorProof(t, runtime, p85F06ForeignDomainProof(t))
+
+	decision, err := runtime.Publish(context.Background(), request)
+	if err != nil {
+		t.Fatalf("a blocked promotion is a decision, not an error: %v", err)
+	}
+	if decision.Outcome != "failed" || decision.AcceptedSnapshotHash != "" || len(decision.LeaseEvidence) != 0 || len(decision.WriterStopEvidence) != 0 {
+		t.Fatalf("an anchor proven for another domain must block the promotion, got %+v", decision)
+	}
+	if len(decision.ErrorEvidence) == 0 {
+		t.Fatal("a blocked promotion must carry error evidence")
+	}
+	if after := p85ReadFrozenPolicyBytes(t, runtime); string(after) != string(artifactBefore) {
+		t.Fatalf("the artifact must stay byte-identical, got %q want %q", after, artifactBefore)
+	}
+
+	if err := os.WriteFile(anchorPath, original, 0o600); err != nil {
+		t.Fatalf("restore the frozen policy anchor: %v", err)
+	}
+	restored, err := runtime.Publish(context.Background(), request)
+	if err != nil {
+		t.Fatalf("the restored anchor must be publishable, got %v", err)
+	}
+	if restored.Outcome != "completed" {
+		t.Fatalf("restoring the anchor must complete the promotion, got %+v", restored)
+	}
+}
diff --git a/internal/console/p85_r4_linux_native_test.go b/internal/console/p85_r4_linux_native_test.go
new file mode 100644
index 0000000..bce6067
--- /dev/null
+++ b/internal/console/p85_r4_linux_native_test.go
@@ -0,0 +1,116 @@
+//go:build linux
+
+package console
+
+// P85 design rev 4, section 6: the Linux-NATIVE legs of M13 and M16.
+//
+// The counterexamples in the platform-independent files reach the same properties
+// through the observation seam. What is only executable on Linux is the kernel-level
+// fact underneath them, and that is what these two legs pin:
+//
+//	M13 - a directory replaced at the same name is a DIFFERENT dev:ino object while
+//	      the bound descriptor keeps addressing the original one, so "the name still
+//	      resolves to the bound object" is a real identity comparison and not a
+//	      spelling comparison;
+//	M16 - the carrier publication on this platform runs entirely inside the bound
+//	      descriptor (create + write + fsync + link + unlink + fsync), so a successful
+//	      first publication leaves no temporary name behind and the re-entry adopts
+//	      the very bytes that were published.
+//
+// These legs are only built for linux, so a Windows host reports them as absent
+// rather than as a silent pass. They are still type-checked on every host through
+// `GOOS=linux go vet ./internal/console`.
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// TestP85R4M13LinuxNativeIdentityIsTheDirectoryObject is the M13 native leg.
+func TestP85R4M13LinuxNativeIdentityIsTheDirectoryObject(t *testing.T) {
+	runtime := p85R4FrozenCreationRuntime(t)
+	directory := agentRunnerPolicyDirectory(runtime.runRoot)
+
+	var before syscall.Stat_t
+	if err := syscall.Lstat(directory, &before); err != nil {
+		t.Fatalf("lstat the policy directory: %v", err)
+	}
+
+	chain, err := bindAgentRunnerPolicyDomain(runtime.runRoot, p83TaskID, p83StepID, 1)
+	if err != nil {
+		t.Fatalf("bind the policy domain chain: %v", err)
+	}
+	defer func() { _ = chain.Close() }()
+
+	if err := p85R4SwapPolicyDirectory(t, runtime); err != nil {
+		t.Fatalf("swap the policy directory for a same-named stand-in: %v", err)
+	}
+
+	var after syscall.Stat_t
+	if err := syscall.Lstat(directory, &after); err != nil {
+		t.Fatalf("lstat the stand-in directory: %v", err)
+	}
+	if before.Dev == after.Dev && before.Ino == after.Ino {
+		t.Fatalf("the fixture must produce a DIFFERENT dev:ino at the same name, got %#x/%d twice", after.Dev, after.Ino)
+	}
+	// The bound handle still addresses the original object: identity is a property of
+	// the descriptor, which is what makes the terminal comparison meaningful.
+	if err := evidence.VerifyBoundDir(chain.dir, chain.dirID); err != nil {
+		t.Fatalf("the bound handle must still address the object it bound, got %v", err)
+	}
+	if err := chain.ReassertIdentities(); err == nil {
+		t.Fatal("a directory replaced at the same name must refuse the terminal identity re-assertion")
+	}
+}
+
+// TestP85R4M16LinuxNativeCarrierPublicationLeavesNoTemporaryName is the M16 native
+// leg.
+func TestP85R4M16LinuxNativeCarrierPublicationLeavesNoTemporaryName(t *testing.T) {
+	executable := p85T3ReentryProvableExecutable(t)
+	root := t.TempDir()
+	carrierPath := p85T3CarrierPath(root)
+
+	published, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", p83Clock())
+	if err != nil {
+		t.Fatalf("a provable source must publish the carrier: %v", err)
+	}
+	if published.ExecutablePath != executable {
+		t.Fatalf("the published facts must describe the probed executable, got %q want %q", published.ExecutablePath, executable)
+	}
+	wire, err := os.ReadFile(carrierPath)
+	if err != nil {
+		t.Fatalf("the published carrier must be readable: %v", err)
+	}
+
+	// The publication is create + write + fsync + link + unlink inside ONE descriptor,
+	// so nothing may be left beside the final name.
+	entries, err := os.ReadDir(filepath.Dir(carrierPath))
+	if err != nil {
+		t.Fatalf("enumerate the carrier directory: %v", err)
+	}
+	for _, entry := range entries {
+		if entry.Name() != filepath.Base(carrierPath) {
+			t.Fatalf("the handle-relative publication must leave no second name, found %q", entry.Name())
+		}
+	}
+
+	adopted, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", p83Clock().Add(time.Hour))
+	if err != nil {
+		t.Fatalf("the re-entry must adopt the published carrier, got %v", err)
+	}
+	if !adopted.MatchesFacts(published) {
+		t.Fatalf("the re-entry must adopt the recorded facts, got %+v want %+v", adopted, published)
+	}
+	again, err := os.ReadFile(carrierPath)
+	if err != nil {
+		t.Fatalf("the adopted carrier must stay readable: %v", err)
+	}
+	if string(again) != string(wire) {
+		t.Fatalf("an adopted carrier must never be rewritten, got %q want %q", again, wire)
+	}
+}
diff --git a/internal/console/p85_r4_m13_chain_tester_test.go b/internal/console/p85_r4_m13_chain_tester_test.go
new file mode 100644
index 0000000..d1d06c6
--- /dev/null
+++ b/internal/console/p85_r4_m13_chain_tester_test.go
@@ -0,0 +1,247 @@
+package console
+
+// P85 design rev 4, section 1 / test row M13: the EVIDENCE HANDLE CHAIN of one
+// frozen-policy task attempt.
+//
+// The r2 review (High, agent_runner_policy.go:558) says the defect is "the object
+// whose write protection was judged" versus "the object the bytes came from": every
+// stage used to resolve the same names again. Design rev 4 replaced that with ONE
+// binding - directory, parent, artifact, anchor - and a terminal
+// ReassertIdentities that re-takes each identity from its handle AND requires each
+// name to still address that very object.
+//
+// The counterexamples below are the cross-segment replacement and the two named
+// mutations:
+//
+//   - a directory renamed away and replaced by a same-named stand-in BETWEEN the
+//     observation segment and the adoption segment => the production load path
+//     refuses on ReassertIdentities (mutation: deleting the name re-assertions
+//     turns it green);
+//   - an artifact replaced by a same-named file after the binding => the chain's
+//     file slot refuses even though the handle still addresses the recorded object
+//     (mutation: keeping only the directory checks - "只对目录不对制品" - turns it
+//     green).
+//
+// The positive control below is the other half of the same fact: the bytes a
+// snapshot read returns are the BOUND object's, not whatever the name addresses at
+// read time, which is what makes the identity comparison meaningful at all.
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/chain"
+)
+
+// p85R4FrozenCreationRuntime freezes one creation-shaped anchor for the task
+// attempt every P85 fixture uses and returns the runtime that reads it back.
+//
+// The freeze installs the constant observation stand-in (p85StubManagedWriteProofObservation)
+// because on this host the assembly and the managed agent share one OS identity;
+// each case below replaces that seam with the stub it needs, so the identity
+// property under test is never measured through the shared-identity host.
+func p85R4FrozenCreationRuntime(t *testing.T) *agentRunnerRuntime {
+	t.Helper()
+	runtime := p83Runtime(t, chain.AuthorizationLedger{})
+	p85FreezeAgentRunnerPolicy(t, runtime, p83TaskID, p83StepID, 1)
+	return runtime
+}
+
+// p85R4LoadFrozen runs the production load path of the fixture's one attempt.
+func p85R4LoadFrozen(t *testing.T, runtime *agentRunnerRuntime) (agentRunnerFrozenPolicy, error) {
+	t.Helper()
+	return loadAgentRunnerFrozenPolicy(runtime.store, runtime.runRoot, p83RunID, p83TaskID, p83StepID, 1)
+}
+
+// p85R4ReplaceArtifact retires the artifact and puts a byte-identical stand-in at
+// the same name, which is a DIFFERENT object behind the same path.
+//
+// Measured on this host: Windows refuses to rename a DIRECTORY while a file inside
+// it is open (ERROR_ACCESS_DENIED), so the directory half of the cross-segment
+// counterexample cannot be staged while the chain holds its file handles. The
+// directory half therefore lives in p85_r4_linux_native_test.go, where renaming a
+// bound directory is allowed and the comparison is a real dev:ino comparison; the
+// artifact half below stages the same fact - a name that no longer addresses the
+// bound object - on both platforms.
+func p85R4ReplaceArtifact(t *testing.T, runtime *agentRunnerRuntime) error {
+	t.Helper()
+	path := agentRunnerFrozenPolicyPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	if err := os.Rename(path, path+".retired"); err != nil {
+		return err
+	}
+	return os.WriteFile(path, payload, 0o600)
+}
+
+// p85R4SwapPolicyDirectory renames the policy directory away and puts a complete
+// stand-in (same names, same bytes, different directory object) at the path. It is
+// used by the Linux-native leg; see the note on p85R4ReplaceArtifact for why the
+// Windows legs stage the artifact instead.
+func p85R4SwapPolicyDirectory(t *testing.T, runtime *agentRunnerRuntime) error {
+	t.Helper()
+	directory := agentRunnerPolicyDirectory(runtime.runRoot)
+	retired := directory + ".retired"
+	if err := os.Rename(directory, retired); err != nil {
+		return err
+	}
+	if err := os.Mkdir(directory, 0o755); err != nil {
+		return err
+	}
+	for _, path := range []string{
+		agentRunnerFrozenPolicyPath(runtime.runRoot, p83TaskID, p83StepID, 1),
+		agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1),
+	} {
+		payload, err := os.ReadFile(filepath.Join(retired, filepath.Base(path)))
+		if err != nil {
+			return err
+		}
+		if err := os.WriteFile(filepath.Join(directory, filepath.Base(path)), payload, 0o600); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// TestP85R4M13TerminalReassertRefusesAStandInSwappedMidEntry is the cross-segment
+// counterexample of M13: the replacement happens AFTER the write-domain observation
+// (the seam runs inside agentRunnerReverifyManagedWriteProof, which is reached after
+// both files have been read through their handles) and BEFORE the adoption. The
+// original implementation - which compared nothing at the end - adopted the
+// artifact; the chain must refuse.
+//
+// Mutation check: deleting the agentRunnerReassertNameIdentity calls from
+// ReassertIdentities - or dropping the artifact/anchor loop ("only the directory,
+// not the artifact") - makes the load adopt the artifact and turns this red.
+func TestP85R4M13TerminalReassertRefusesAStandInSwappedMidEntry(t *testing.T) {
+	runtime := p85R4FrozenCreationRuntime(t)
+
+	previous := agentRunnerObserveManagedWriteProof
+	swapped := false
+	var swapErr error
+	agentRunnerObserveManagedWriteProof = func(*agentRunnerPolicyDomainChain, []adapters.ManagedPolicyDomainBoundFile) (string, error) {
+		if !swapped {
+			swapped = true
+			swapErr = p85R4ReplaceArtifact(t, runtime)
+		}
+		return assemblyManagedWriteProof, nil
+	}
+	t.Cleanup(func() { agentRunnerObserveManagedWriteProof = previous })
+
+	_, err := p85R4LoadFrozen(t, runtime)
+	if swapErr != nil {
+		t.Fatalf("the fixture must be able to replace the artifact: %v", swapErr)
+	}
+	if !swapped {
+		t.Fatal("the observation seam must have run, so the swap happened between the segments and not before them")
+	}
+	if !errors.Is(err, ErrInvalidConfig) {
+		t.Fatalf("an artifact replaced between the segments must refuse the load, got %v", err)
+	}
+	if !strings.Contains(err.Error(), "frozen policy artifact") {
+		t.Fatalf("the refusal must name the artifact slot whose identity moved, got %v", err)
+	}
+	if !strings.Contains(err.Error(), "no longer names the object that was bound") {
+		t.Fatalf("the refusal must come from the terminal identity re-assertion, got %v", err)
+	}
+
+	// The stand-in is byte-identical, so only the OBJECT identity can tell the two
+	// files apart - which is exactly the property the chain provides.
+	path := agentRunnerFrozenPolicyPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+	standIn, statErr := os.Stat(path)
+	if statErr != nil {
+		t.Fatalf("the stand-in artifact must exist: %v", statErr)
+	}
+	retired, statErr := os.Stat(path + ".retired")
+	if statErr != nil {
+		t.Fatalf("the retired artifact must exist: %v", statErr)
+	}
+	if os.SameFile(standIn, retired) {
+		t.Fatal("the fixture must produce a DIFFERENT object at the same name")
+	}
+}
+
+// TestP85R4M13ChainSlotsRefuseAReplacedArtifact is the artifact half of M13: the
+// directory is untouched, so only the file slot can notice. The bound handle keeps
+// reading the recorded object (first assertion), while the name now addresses a new
+// object (second assertion), which is precisely the "取证对象 != 读写对象" shape the
+// finding names.
+//
+// Mutation check: dropping the artifact/anchor loop from ReassertIdentities ("only
+// the directory, not the artifact") makes the final refusal disappear and turns
+// this red.
+func TestP85R4M13ChainSlotsRefuseAReplacedArtifact(t *testing.T) {
+	runtime := p85R4FrozenCreationRuntime(t)
+	bound, err := bindAgentRunnerPolicyDomain(runtime.runRoot, p83TaskID, p83StepID, 1)
+	if err != nil {
+		t.Fatalf("bind the policy domain chain: %v", err)
+	}
+	defer func() { _ = bound.Close() }()
+	if bound.artifact == nil || bound.anchor == nil {
+		t.Fatal("the fixture must bind both files")
+	}
+	recordedID := bound.artifactID
+	original, err := bound.readBound(bound.artifact, bound.artifactPath, "frozen policy artifact")
+	if err != nil {
+		t.Fatalf("read the artifact through its handle: %v", err)
+	}
+
+	retired := bound.artifactPath + ".retired"
+	if err := os.Rename(bound.artifactPath, retired); err != nil {
+		t.Fatalf("retire the artifact: %v", err)
+	}
+	if err := os.WriteFile(bound.artifactPath, original, 0o600); err != nil {
+		t.Fatalf("write the stand-in artifact: %v", err)
+	}
+
+	// The handle still addresses the object that was read: the chain's reads never
+	// follow the name.
+	again, err := bound.readBound(bound.artifact, bound.artifactPath, "frozen policy artifact")
+	if err != nil {
+		t.Fatalf("the bound handle must still read its object: %v", err)
+	}
+	if string(again) != string(original) {
+		t.Fatalf("the bound handle must read the recorded object, got %q want %q", again, original)
+	}
+	identity, err := bound.artifact.FileID()
+	if err != nil {
+		t.Fatalf("re-identify the artifact on its handle: %v", err)
+	}
+	if identity != recordedID {
+		t.Fatalf("the handle identity must not move, got %s want %s", identity, recordedID)
+	}
+
+	// The name, on the other hand, does not address it any more - and the terminal
+	// re-assertion is what turns that into a refusal.
+	err = bound.ReassertIdentities()
+	if !errors.Is(err, ErrInvalidConfig) {
+		t.Fatalf("an artifact replaced after the binding must refuse, got %v", err)
+	}
+	if !strings.Contains(err.Error(), "frozen policy artifact") {
+		t.Fatalf("the refusal must name the artifact slot, got %v", err)
+	}
+}
+
+// TestP85R4M13BoundChainAcceptsAnUntouchedDomain is the positive control of the two
+// legs above: without a replacement the same chain re-asserts cleanly, so the
+// refusals are attributable to the replacement and not to the chain itself.
+func TestP85R4M13BoundChainAcceptsAnUntouchedDomain(t *testing.T) {
+	runtime := p85R4FrozenCreationRuntime(t)
+	bound, err := bindAgentRunnerPolicyDomain(runtime.runRoot, p83TaskID, p83StepID, 1)
+	if err != nil {
+		t.Fatalf("bind the policy domain chain: %v", err)
+	}
+	defer func() { _ = bound.Close() }()
+	if err := bound.ReassertIdentities(); err != nil {
+		t.Fatalf("an untouched domain must re-assert cleanly, got %v", err)
+	}
+	if _, err := p85R4LoadFrozen(t, runtime); err != nil {
+		t.Fatalf("an untouched creation anchor must load, got %v", err)
+	}
+}
diff --git a/internal/console/p85_r4_m14_publish_recheck_windows_test.go b/internal/console/p85_r4_m14_publish_recheck_windows_test.go
new file mode 100644
index 0000000..19c931a
--- /dev/null
+++ b/internal/console/p85_r4_m14_publish_recheck_windows_test.go
@@ -0,0 +1,73 @@
+//go:build windows
+
+package console
+
+// P85 design rev 4, section 3 (publication re-check) / test row M14: the check that
+// runs before and after a path-based publication must be a RE-BIND through the same
+// root-chain walk, not a name-based identity comparison.
+//
+// The discriminating file-system shape is a junction that resolves to the very same
+// object the binding produced (rename the directory away, put a junction at its old
+// name pointing at the new location). A name-based comparison reports the bound
+// identity - it follows the junction and lands on the same object - so it approves;
+// the root chain sees a reparse point in the last component and refuses.
+//
+// Mutation check: replacing the re-bind with evidence.FileIDAt in
+// agentRunnerAssertDirectoryIdentity makes this leg approve and turns it red.
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// TestP85R4M14PublishRecheckRefusesASameObjectJunction is the console half of M14.
+func TestP85R4M14PublishRecheckRefusesASameObjectJunction(t *testing.T) {
+	root := t.TempDir()
+	directory := filepath.Join(root, "agent-runner-policy")
+	if err := os.Mkdir(directory, 0o755); err != nil {
+		t.Fatalf("create the policy directory: %v", err)
+	}
+
+	bound, fileID, err := evidence.OpenBoundDirVerified(directory)
+	if err != nil {
+		t.Skipf("this host's temporary root is not link-free, so the binding half of the fixture cannot be established: %v", err)
+	}
+	defer func() { _ = bound.Close() }()
+
+	// Positive control: the untouched directory passes the re-check.
+	if err := agentRunnerAssertDirectoryIdentity(bound, fileID, directory, "frozen policy artifact"); err != nil {
+		t.Fatalf("an untouched directory must pass the publication re-check, got %v", err)
+	}
+
+	renamed := filepath.Join(root, "agent-runner-policy-renamed")
+	if err := os.Rename(directory, renamed); err != nil {
+		t.Fatalf("rename the policy directory away: %v", err)
+	}
+	if output, err := exec.Command("cmd", "/c", "mklink", "/J", directory, renamed).CombinedOutput(); err != nil {
+		t.Skipf("this host cannot create the junction %s -> %s without elevation: %v (%s)", directory, renamed, err, strings.TrimSpace(string(output)))
+	}
+	t.Cleanup(func() { _ = os.Remove(directory) })
+
+	// The shape the pre-fix re-check accepted: the NAME still reports the bound
+	// identity, because the junction is followed to the same object.
+	named, err := evidence.FileIDAt(directory)
+	if err != nil {
+		t.Fatalf("identify the junction by name: %v", err)
+	}
+	if named != fileID {
+		t.Fatalf("the fixture must make the name-based comparison agree with the binding (%s != %s), otherwise this leg does not discriminate", named, fileID)
+	}
+
+	err = agentRunnerAssertDirectoryIdentity(bound, fileID, directory, "frozen policy artifact")
+	if err == nil {
+		t.Fatal("a directory whose name is now a junction must refuse the publication re-check even though it resolves to the bound object")
+	}
+	if !strings.Contains(err.Error(), "root chain") {
+		t.Fatalf("the refusal must come from the root-chain re-bind, got %v", err)
+	}
+}
diff --git a/internal/console/p85_r4_m15_m17_shape_tester_test.go b/internal/console/p85_r4_m15_m17_shape_tester_test.go
new file mode 100644
index 0000000..e460935
--- /dev/null
+++ b/internal/console/p85_r4_m15_m17_shape_tester_test.go
@@ -0,0 +1,281 @@
+package console
+
+// P85 design rev 4, sections 2 and 5 / test rows M15 and M17: the explicit
+// write-proof SHAPE of the assembly anchor, and the removal of the "a sealed short
+// domain matched, so return" shortcut.
+//
+// Two independent questions were conflated before rev 4:
+//
+//	(a) is the domain still closed for every object that exists NOW? - the current
+//	    write rights of the artifact and the anchor are always judged;
+//	(b) is this anchor's proof the proof of the domain its SHAPE declares? - the
+//	    sealed domain is rebuilt from the shape (creation: both file slots empty;
+//	    reuse: artifact + anchor) and compared byte for byte.
+//
+// On this host the assembly and the managed agent share one OS identity, so the real
+// domain observation can never SUCCEED and the positive legs would be unreachable.
+// The stub below therefore replaces only the platform observation and lets a case
+// state, per domain shape, what the observation says - which is what makes the two
+// questions separable at all:
+//
+//	creationProof - the seal of a creation-shaped domain (no files bound);
+//	fullProof     - the seal of a reuse-shaped domain / of the current object set;
+//	failFullSet   - the current object set is writable NOW (the artifact/anchor are
+//	                owned by this identity while the directory is not).
+//
+// Mutation contracts (design rev 4 section 6, rows M15/M17):
+//   - deleting the current-domain observation from agentRunnerReverifyManagedWriteProof
+//     turns M15's "writable-now" leg - and M17's creation leg - green;
+//   - restoring the short-domain shortcut (return nil as soon as the sealed domain
+//     matches) turns M17's creation leg green.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85R4DomainObservationStub is the shape-aware observation stand-in. It never runs
+// the platform guard; it answers per slot count so a case can separate "the sealed
+// domain still matches" from "the domain is writable now".
+type p85R4DomainObservationStub struct {
+	creationProof     string
+	fullProof         string
+	failFullSet       bool
+	failFirstFullCall bool
+	fullCalls         int
+	calls             int
+}
+
+// install replaces the observation seam for the duration of the test.
+func (stub *p85R4DomainObservationStub) install(t *testing.T) {
+	t.Helper()
+	previous := agentRunnerObserveManagedWriteProof
+	agentRunnerObserveManagedWriteProof = func(_ *agentRunnerPolicyDomainChain, files []adapters.ManagedPolicyDomainBoundFile) (string, error) {
+		stub.calls++
+		if len(files) == 0 {
+			if stub.creationProof == "" {
+				return "", fmt.Errorf("%w: stub refuses the creation domain", adapters.ErrManagedAgentPolicyWriteProof)
+			}
+			return stub.creationProof, nil
+		}
+		stub.fullCalls++
+		if stub.failFullSet || (stub.failFirstFullCall && stub.fullCalls == 1) {
+			return "", fmt.Errorf("%w: stub: an object of the current domain is writable", adapters.ErrManagedAgentPolicyWriteProof)
+		}
+		if stub.fullProof == "" {
+			return "", fmt.Errorf("%w: stub refuses the full domain", adapters.ErrManagedAgentPolicyWriteProof)
+		}
+		return stub.fullProof, nil
+	}
+	t.Cleanup(func() { agentRunnerObserveManagedWriteProof = previous })
+}
+
+// p85R4AnchorPath is the assembly anchor of the fixture's one task attempt.
+func p85R4AnchorPath(runtime *agentRunnerRuntime) string {
+	return agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+}
+
+// p85R4RewriteAnchorShape rewrites ONLY the declared write-proof shape of the
+// anchor. The proof, the digests and the artifact stay byte-identical, so a
+// refusal can only be about the shape.
+func p85R4RewriteAnchorShape(t *testing.T, runtime *agentRunnerRuntime, shape string) {
+	t.Helper()
+	path := p85R4AnchorPath(runtime)
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read the frozen policy anchor: %v", err)
+	}
+	var anchor agentRunnerFrozenPolicyAnchor
+	if err := evidence.DecodeStrictJSON(raw, &anchor); err != nil {
+		t.Fatalf("decode the frozen policy anchor: %v", err)
+	}
+	anchor.ManagedWriteProofShape = shape
+	payload, err := agentRunnerFrozenPolicyAnchorPayload(anchor)
+	if err != nil {
+		t.Fatalf("encode the rewritten anchor: %v", err)
+	}
+	if err := os.WriteFile(path, payload, 0o600); err != nil {
+		t.Fatalf("rewrite the frozen policy anchor: %v", err)
+	}
+}
+
+// p85R4RemoveAnchorShapeField physically removes the shape key, which is the exact
+// on-disk shape of an anchor written BEFORE the field existed. An empty string is a
+// different fact (an unknown shape) and is covered by the rewrite leg above.
+func p85R4RemoveAnchorShapeField(t *testing.T, runtime *agentRunnerRuntime) {
+	t.Helper()
+	path := p85R4AnchorPath(runtime)
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read the frozen policy anchor: %v", err)
+	}
+	var document map[string]any
+	if err := json.Unmarshal(raw, &document); err != nil {
+		t.Fatalf("decode the frozen policy anchor as a document: %v", err)
+	}
+	if _, present := document["managedWriteProofShape"]; !present {
+		t.Fatal("the fixture anchor must carry the shape field before it can be removed")
+	}
+	delete(document, "managedWriteProofShape")
+	rewritten, err := json.Marshal(document)
+	if err != nil {
+		t.Fatalf("re-encode the old-shaped anchor: %v", err)
+	}
+	if err := os.WriteFile(path, append(rewritten, '\n'), 0o600); err != nil {
+		t.Fatalf("write the old-shaped anchor: %v", err)
+	}
+}
+
+// TestP85R4M15ShapeDecidesWhichDomainIsSealed covers M15.
+func TestP85R4M15ShapeDecidesWhichDomainIsSealed(t *testing.T) {
+	t.Run("a-creation-anchor-reenters-unchanged", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		artifact, err := p85R4LoadFrozen(t, runtime)
+		if err != nil {
+			t.Fatalf("an unchanged creation anchor must be adopted on re-entry, got %v", err)
+		}
+		if artifact.PolicyHash == "" {
+			t.Fatal("the adopted artifact must carry its policy hash")
+		}
+	})
+
+	t.Run("a-reuse-anchor-reenters-unchanged", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		p85R4RewriteAnchorShape(t, runtime, agentRunnerPolicyWriteProofShapeReuse)
+		// The constant stand-in reports the recorded proof for every domain, so this
+		// leg measures the SHAPE branch (both files must still be bound) and not the
+		// platform's verdict.
+		p85StubManagedWriteProofObservation(t, assemblyManagedWriteProof)
+		if _, err := p85R4LoadFrozen(t, runtime); err != nil {
+			t.Fatalf("a reuse anchor whose two files are still present must be adopted, got %v", err)
+		}
+	})
+
+	t.Run("a-creation-anchor-rewritten-as-reuse-is-refused", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		p85R4RewriteAnchorShape(t, runtime, agentRunnerPolicyWriteProofShapeReuse)
+		stub := &p85R4DomainObservationStub{
+			creationProof: assemblyManagedWriteProof,
+			fullProof:     "sha256:" + strings.Repeat("b", 64),
+		}
+		stub.install(t)
+
+		_, err := p85R4LoadFrozen(t, runtime)
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("an anchor that declares a domain it did not seal must be refused, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "is not the proof of the domain") {
+			t.Fatalf("the refusal must be the sealed-domain comparison, got %v", err)
+		}
+		// The creation seal was the recorded one, so the mismatch is provably the
+		// shape's doing: the same stub accepts the unmodified anchor.
+		runtime2 := p85R4FrozenCreationRuntime(t)
+		stub2 := &p85R4DomainObservationStub{creationProof: assemblyManagedWriteProof, fullProof: "sha256:" + strings.Repeat("b", 64)}
+		stub2.install(t)
+		if _, err := p85R4LoadFrozen(t, runtime2); err != nil {
+			t.Fatalf("the same stub must accept an unmodified creation anchor, got %v", err)
+		}
+	})
+
+	t.Run("a-domain-that-is-writable-now-is-refused", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		stub := &p85R4DomainObservationStub{
+			creationProof: assemblyManagedWriteProof,
+			failFullSet:   true,
+		}
+		stub.install(t)
+
+		_, err := p85R4LoadFrozen(t, runtime)
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("an artifact writable by this identity must refuse the load even when the sealed domain still matches, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "is not closed to the managed agent identity") {
+			t.Fatalf("the refusal must be the current-domain verification, got %v", err)
+		}
+		// Both questions were asked: the sealed domain was consulted after the
+		// current one, so the check is not "sealed equals recorded, done".
+		if stub.calls < 1 || stub.fullCalls < 1 {
+			t.Fatalf("the current (full) domain must have been observed, got %d call(s) and %d full call(s)", stub.calls, stub.fullCalls)
+		}
+	})
+
+	t.Run("an-anchor-without-a-shape-is-refused", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		p85R4RemoveAnchorShapeField(t, runtime)
+		p85StubManagedWriteProofObservation(t, assemblyManagedWriteProof)
+
+		_, err := p85R4LoadFrozen(t, runtime)
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("an anchor without a declared shape must be refused (fail-closed), got %v", err)
+		}
+		if !strings.Contains(err.Error(), "no recognized write-proof shape") {
+			t.Fatalf("the refusal must name the missing shape, got %v", err)
+		}
+	})
+}
+
+// TestP85R4M17ShortDomainShortcutIsGone covers M17: the sealed-domain comparison
+// may never stand in for the current-domain verification.
+func TestP85R4M17ShortDomainShortcutIsGone(t *testing.T) {
+	t.Run("a-closed-domain-with-a-creation-anchor-is-adopted", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		if _, err := p85R4LoadFrozen(t, runtime); err != nil {
+			t.Fatalf("a creation anchor over a closed domain must be adopted, got %v", err)
+		}
+	})
+
+	t.Run("a-creation-anchor-over-a-writable-object-set-is-refused", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		stub := &p85R4DomainObservationStub{
+			creationProof: assemblyManagedWriteProof,
+			failFullSet:   true,
+		}
+		stub.install(t)
+
+		_, err := p85R4LoadFrozen(t, runtime)
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("a creation anchor must not short-circuit the current-domain verification, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "is not closed to the managed agent identity") {
+			t.Fatalf("the refusal must be the current-domain verification, got %v", err)
+		}
+	})
+
+	t.Run("a-reuse-anchor-over-a-writable-artifact-is-refused", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		p85R4RewriteAnchorShape(t, runtime, agentRunnerPolicyWriteProofShapeReuse)
+		// The FIRST full-domain observation is the current-object-set verification
+		// (the sealed reuse domain is observed second), so this stub states exactly
+		// "the artifact is writable now while the anchor's own seal still matches".
+		stub := &p85R4DomainObservationStub{
+			creationProof:     assemblyManagedWriteProof,
+			fullProof:         assemblyManagedWriteProof,
+			failFirstFullCall: true,
+		}
+		stub.install(t)
+
+		_, err := p85R4LoadFrozen(t, runtime)
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("a reuse anchor must not short-circuit the current-domain verification, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "is not closed to the managed agent identity") {
+			t.Fatalf("the refusal must be the current-domain verification, got %v", err)
+		}
+	})
+
+	t.Run("a-reuse-anchor-over-an-unwritable-artifact-is-adopted", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		p85R4RewriteAnchorShape(t, runtime, agentRunnerPolicyWriteProofShapeReuse)
+		p85StubManagedWriteProofObservation(t, assemblyManagedWriteProof)
+		if _, err := p85R4LoadFrozen(t, runtime); err != nil {
+			t.Fatalf("a reuse anchor over a closed domain must be adopted, got %v", err)
+		}
+	})
+}
diff --git a/internal/console/p85_r4_m16_sync_guard_tester_test.go b/internal/console/p85_r4_m16_sync_guard_tester_test.go
new file mode 100644
index 0000000..82ee69f
--- /dev/null
+++ b/internal/console/p85_r4_m16_sync_guard_tester_test.go
@@ -0,0 +1,133 @@
+package console
+
+// P85 design rev 4, section 4 / test row M16 (rewrite of M8): the re-entry sync
+// guard has to be DISCRIMINATING, so the two implementation facts it protects -
+// "the re-entry syncs the carrier directory" and "a sync failure refuses" - can each
+// be deleted by exactly one leg turning red.
+//
+// The old M8 leg 2 withdrew the guard AND cleared the failure injection in the same
+// step, so it proved nothing about the guard: dropping the re-entry sync, or the
+// guard condition, left it green (r2, F10 counterexample).
+//
+// The three legs below keep the injection orthogonal to the guard:
+//
+//	leg-P  positive control - first publication fails the sync; failSync=false with
+//	       the guard still on adopts the carrier;
+//	leg-R  discriminating red - failSync stays TRUE and the guard stays ON => the
+//	       re-entry must refuse with the injected sync marker;
+//	leg-G  discriminating green - failSync stays TRUE and ONLY the guard is turned
+//	       off => the re-entry must adopt, and the adopted carrier must be the very
+//	       bytes the refused publication left behind.
+//
+// Mutation contracts:
+//   - deleting the re-entry's directory sync call in recordOrConfirmAIInstallSourceProof
+//     makes leg-R adopt and turns this test red;
+//   - deleting the "&& aiInstallSourceReentryRequiresSync" condition makes a failing
+//     sync refuse unconditionally, leg-G refuses and this test turns red.
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// TestP85R4M16ReentrySyncGuardIsDiscriminating is M16.
+func TestP85R4M16ReentrySyncGuardIsDiscriminating(t *testing.T) {
+	// The seam legs measure the RE-ENTRY guard, which is platform-independent, so
+	// they must not inherit the Linux-only durability precondition of the native
+	// leg. The native durability leg of the same entry lives in
+	// p85_r4_linux_native_test.go and is skipped elsewhere.
+	executable := p85F10SeamExecutable(t)
+	now := time.Date(2026, 11, 23, 8, 0, 0, 0, time.UTC)
+
+	previousSync := aiInstallSourceCarrierDirectorySync
+	previousGuard := aiInstallSourceReentryRequiresSync
+	failSync := true
+	aiInstallSourceCarrierDirectorySync = func(bound *evidence.BoundDir) error {
+		if failSync {
+			return fmt.Errorf("%w: %s", ErrAIInstallSourceUnproven, p85F10SyncFailureMarker)
+		}
+		return previousSync(bound)
+	}
+	t.Cleanup(func() {
+		aiInstallSourceCarrierDirectorySync = previousSync
+		aiInstallSourceReentryRequiresSync = previousGuard
+	})
+
+	t.Run("leg-P-positive-control", func(t *testing.T) {
+		root := t.TempDir()
+		carrierPath := p85T3CarrierPath(root)
+
+		failSync = true
+		aiInstallSourceReentryRequiresSync = true
+		if _, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now); !errors.Is(err, ErrAIInstallSourceUnproven) || !strings.Contains(err.Error(), p85F10SyncFailureMarker) {
+			t.Fatalf("the fixture must start from a publication refused by the sync failure, got %v", err)
+		}
+
+		failSync = false
+		if _, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now.Add(time.Hour)); err != nil {
+			t.Fatalf("a re-entry whose sync succeeds must adopt the carrier, got %v", err)
+		}
+	})
+
+	t.Run("leg-R-guard-on-while-sync-still-fails-refuses", func(t *testing.T) {
+		root := t.TempDir()
+		carrierPath := p85T3CarrierPath(root)
+
+		failSync = true
+		aiInstallSourceReentryRequiresSync = true
+		if _, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now); !errors.Is(err, ErrAIInstallSourceUnproven) || !strings.Contains(err.Error(), p85F10SyncFailureMarker) {
+			t.Fatalf("the fixture must start from a publication refused by the sync failure, got %v", err)
+		}
+		if _, statErr := os.Stat(carrierPath); statErr != nil {
+			t.Fatalf("the hard link is published before the sync, so the carrier must be visible: %v", statErr)
+		}
+
+		// The injection is untouched and the guard is ON: the sync fails again, so
+		// this re-entry must refuse - and it must be the SAME injected failure that
+		// refuses it, not the carrier reader.
+		_, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now.Add(time.Hour))
+		if !errors.Is(err, ErrAIInstallSourceUnproven) || !strings.Contains(err.Error(), p85F10SyncFailureMarker) {
+			t.Fatalf("with the guard on and the sync still failing the re-entry must refuse with the sync failure, got %v", err)
+		}
+	})
+
+	t.Run("leg-G-guard-off-while-sync-still-fails-adopts", func(t *testing.T) {
+		root := t.TempDir()
+		carrierPath := p85T3CarrierPath(root)
+
+		failSync = true
+		aiInstallSourceReentryRequiresSync = true
+		if _, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now); !errors.Is(err, ErrAIInstallSourceUnproven) {
+			t.Fatalf("the fixture must start from a refused publication, got %v", err)
+		}
+		published, err := os.ReadFile(carrierPath)
+		if err != nil {
+			t.Fatalf("the carrier published before the failed sync must be readable: %v", err)
+		}
+
+		// ONLY the guard moves: the injection still fails. The re-entry must therefore
+		// adopt, and the adopted object must be the bytes the refused publication
+		// left on disk.
+		aiInstallSourceReentryRequiresSync = false
+		adopted, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now.Add(time.Hour))
+		if err != nil {
+			t.Fatalf("with only the guard withdrawn the unchanged carrier must be adopted, got %v", err)
+		}
+		if adopted.ExecutablePath == "" {
+			t.Fatal("the adopted facts must describe the carrier")
+		}
+		after, err := os.ReadFile(carrierPath)
+		if err != nil {
+			t.Fatalf("the adopted carrier must stay readable: %v", err)
+		}
+		if string(after) != string(published) {
+			t.Fatalf("an adopted carrier must never be rewritten, got %q want %q", after, published)
+		}
+	})
+}
diff --git a/internal/console/p85_r6_slot_order_test.go b/internal/console/p85_r6_slot_order_test.go
new file mode 100644
index 0000000..8448046
--- /dev/null
+++ b/internal/console/p85_r6_slot_order_test.go
@@ -0,0 +1,176 @@
+package console
+
+// P85 R6 (test round 6) / review r3 finding 2, console half: the M15/M17 legs
+// measured the SHAPE decision through a stub that only returns a proof value, so
+// nothing asserted which vector the production seam was actually asked to judge. The
+// two anchors below therefore observe the seam's arguments and rebuild the four-slot
+// vector from the chain's own handles:
+//
+//	creation => [policy directory | parent directory | ∅ | ∅]
+//	reuse    => [policy directory | parent directory | artifact | anchor]
+//
+// Every entry of the rebuilt vector is compared with the identity the chain recorded
+// when it bound the object, so a file slot that carries the wrong handle, or a
+// role-less ordering that puts the anchor third, fails here rather than in a digest
+// nobody can read.
+//
+// Mutation check: dropping the role labels, or handing the two file slots to the seam
+// in path order, makes the rebuilt vector place the anchor third and turns this test
+// red. The slot BUILDER itself (role-to-position folding) is pinned by the white-box
+// sibling in internal/adapters.
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+)
+
+// p85R6EmptyMarker is the canonical rendering of an absent slot (CONTRACTS.md:233).
+const p85R6EmptyMarker = "∅"
+
+// p85R6Observation is one judged vector plus the identities the chain recorded, so a
+// leg can compare slot content with the binding instead of with itself.
+type p85R6Observation struct {
+	Vector     []string
+	DirID      string
+	ParentID   string
+	ArtifactID string
+	AnchorID   string
+}
+
+// p85R6Observe rebuilds the four-slot vector the observation seam received and
+// refuses any vector that is not the contract's order.
+func p85R6Observe(chain *agentRunnerPolicyDomainChain, files []adapters.ManagedPolicyDomainBoundFile) (p85R6Observation, error) {
+	observation := p85R6Observation{ArtifactID: chain.artifactID, AnchorID: chain.anchorID}
+	dirID, err := chain.dir.FileID()
+	if err != nil {
+		return observation, fmt.Errorf("identify the policy directory handle: %v", err)
+	}
+	if dirID != chain.dirID {
+		return observation, fmt.Errorf("the policy directory handle is not the recorded object (%s != %s)", dirID, chain.dirID)
+	}
+	parentID, err := chain.parent.FileID()
+	if err != nil {
+		return observation, fmt.Errorf("identify the parent directory handle: %v", err)
+	}
+	if parentID != chain.parentID {
+		return observation, fmt.Errorf("the parent directory handle is not the recorded object (%s != %s)", parentID, chain.parentID)
+	}
+	observation.DirID = string(dirID)
+	observation.ParentID = string(parentID)
+	observation.Vector = []string{
+		"policy directory:" + string(dirID),
+		"parent directory:" + string(parentID),
+		"artifact:" + p85R6EmptyMarker,
+		"anchor:" + p85R6EmptyMarker,
+	}
+	if len(files) > 2 {
+		return observation, fmt.Errorf("the frozen policy domain carries at most two file slots, got %d", len(files))
+	}
+	for _, file := range files {
+		identity, err := file.Bound.FileID()
+		if err != nil {
+			return observation, fmt.Errorf("identify the %s handle: %v", file.Role, err)
+		}
+		position := -1
+		switch file.Role {
+		case "artifact":
+			position = 2
+			if identity != chain.artifactID {
+				return observation, fmt.Errorf("the artifact slot must carry the bound artifact handle (%s != %s)", identity, chain.artifactID)
+			}
+			if filepath.Clean(file.Path) != filepath.Clean(chain.artifactPath) {
+				return observation, fmt.Errorf("the artifact slot must carry %q, got %q", chain.artifactPath, file.Path)
+			}
+		case "anchor":
+			position = 3
+			if identity != chain.anchorID {
+				return observation, fmt.Errorf("the anchor slot must carry the bound anchor handle (%s != %s)", identity, chain.anchorID)
+			}
+			if filepath.Clean(file.Path) != filepath.Clean(chain.anchorPath) {
+				return observation, fmt.Errorf("the anchor slot must carry %q, got %q", chain.anchorPath, file.Path)
+			}
+		default:
+			return observation, fmt.Errorf("the seam must receive role-labelled file slots, got role %q", file.Role)
+		}
+		if !strings.HasSuffix(observation.Vector[position], p85R6EmptyMarker) {
+			return observation, fmt.Errorf("slot %d is claimed twice (%s)", position+1, observation.Vector[position])
+		}
+		observation.Vector[position] = file.Role + ":" + identity
+	}
+	return observation, nil
+}
+
+// p85R6InstallObservationSeam records every vector the production reverification
+// asks the platform observation to judge, and answers with the frozen proof.
+func p85R6InstallObservationSeam(t *testing.T) *[]p85R6Observation {
+	t.Helper()
+	observations := &[]p85R6Observation{}
+	previous := agentRunnerObserveManagedWriteProof
+	agentRunnerObserveManagedWriteProof = func(chain *agentRunnerPolicyDomainChain, files []adapters.ManagedPolicyDomainBoundFile) (string, error) {
+		observation, err := p85R6Observe(chain, files)
+		if err != nil {
+			t.Fatalf("the seam was handed a vector that is not the contract's four-slot order: %v", err)
+		}
+		*observations = append(*observations, observation)
+		return assemblyManagedWriteProof, nil
+	}
+	t.Cleanup(func() { agentRunnerObserveManagedWriteProof = previous })
+	return observations
+}
+
+// TestP85R6SlotOrderMatchesTheContract pins the real vector of both anchor shapes.
+func TestP85R6SlotOrderMatchesTheContract(t *testing.T) {
+	t.Run("a-creation-anchor-seals-dir-parent-and-two-empty-file-slots", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		observations := p85R6InstallObservationSeam(t)
+
+		if _, err := p85R4LoadFrozen(t, runtime); err != nil {
+			t.Fatalf("an unchanged creation anchor must be adopted, got %v", err)
+		}
+		// The current domain is observed first, the sealed domain second.
+		if len(*observations) != 2 {
+			t.Fatalf("the reverification must observe the current and the sealed domain, got %d observation(s)", len(*observations))
+		}
+		current, sealed := (*observations)[0], (*observations)[1]
+		if len(sealed.Vector) != 4 {
+			t.Fatalf("a creation anchor must seal four slots, got %d: %v", len(sealed.Vector), sealed.Vector)
+		}
+		if sealed.Vector[2] != "artifact:"+p85R6EmptyMarker || sealed.Vector[3] != "anchor:"+p85R6EmptyMarker {
+			t.Fatalf("a creation anchor must seal [dir|parent|∅|∅], got %v", sealed.Vector)
+		}
+		if !strings.HasPrefix(current.Vector[2], "artifact:") || !strings.HasPrefix(current.Vector[3], "anchor:") {
+			t.Fatalf("the current domain must be judged as [dir|parent|artifact|anchor], got %v", current.Vector)
+		}
+		if sealed.DirID != current.DirID || sealed.ParentID != current.ParentID {
+			t.Fatalf("both observations must carry the same directory objects (%v vs %v)", sealed.Vector[:2], current.Vector[:2])
+		}
+	})
+
+	t.Run("a-reuse-anchor-seals-dir-parent-artifact-anchor", func(t *testing.T) {
+		runtime := p85R4FrozenCreationRuntime(t)
+		p85R4RewriteAnchorShape(t, runtime, agentRunnerPolicyWriteProofShapeReuse)
+		observations := p85R6InstallObservationSeam(t)
+
+		if _, err := p85R4LoadFrozen(t, runtime); err != nil {
+			t.Fatalf("a reuse anchor whose two files are still bound must be adopted, got %v", err)
+		}
+		if len(*observations) < 2 {
+			t.Fatalf("a reuse anchor must be observed twice (current and sealed), got %d", len(*observations))
+		}
+		for index, observation := range *observations {
+			if observation.ArtifactID == "" || observation.AnchorID == "" {
+				t.Fatalf("observation %d must bind both file slots", index+1)
+			}
+			if observation.Vector[2] != "artifact:"+observation.ArtifactID {
+				t.Fatalf("observation %d must place the artifact in slot 3, got %v", index+1, observation.Vector)
+			}
+			if observation.Vector[3] != "anchor:"+observation.AnchorID {
+				t.Fatalf("observation %d must place the anchor in slot 4, got %v", index+1, observation.Vector)
+			}
+		}
+	})
+}
diff --git a/internal/console/p85_r6_windows_publish_recheck_test.go b/internal/console/p85_r6_windows_publish_recheck_test.go
new file mode 100644
index 0000000..acf5bb0
--- /dev/null
+++ b/internal/console/p85_r6_windows_publish_recheck_test.go
@@ -0,0 +1,114 @@
+//go:build windows
+
+package console
+
+// P85 R6 (test round 6) / review r3 finding 3, console half: the carrier
+// publication re-check.
+//
+// aiInstallSourceAssertDirectoryIdentity used to compare the directory by name with
+// evidence.FileIDAt, whose stat FOLLOWS a reparse point. A chain that became a
+// junction after the binding therefore still reported the approved identity, and the
+// re-check approved a directory the kernel would walk differently. It now re-BINDS
+// the name through the same root-chain walk the initial binding uses.
+//
+// The counterexample is a junction that resolves to the very object the binding
+// produced (rename the directory away, put a junction at its old name). Only the
+// re-bind can tell the difference, because both the name-based comparison and the
+// handle comparison land on the approved object.
+//
+// Mutation check (design rev 4 section 6, mutation 3): replacing the re-bind with
+// evidence.FileIDAt makes the re-check approve, the publication proceed, and this
+// test red.
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// TestP85R6WindowsCarrierPublishRecheckRefusesAReparse carries the publication half
+// of the T3 binding (the executable-forensics half lives in internal/adapters, which
+// owns openInstallSourceLeaf).
+func TestP85R6WindowsCarrierPublishRecheckRefusesAReparse(t *testing.T) {
+	root := t.TempDir()
+	payload := []byte("{\"carrier\":\"p85-r6\"}\n")
+
+	t.Run("an-untouched-directory-publishes-the-carrier", func(t *testing.T) {
+		directory := filepath.Join(root, "publish-ok")
+		if err := os.Mkdir(directory, 0o755); err != nil {
+			t.Fatalf("create the publication directory: %v", err)
+		}
+		bound, fileID, err := evidence.OpenBoundDirVerified(directory)
+		if err != nil {
+			t.Skipf("this host's temporary root is not link-free, so the binding cannot be established: %v", err)
+		}
+		defer func() { _ = bound.Close() }()
+
+		target := filepath.Join(directory, "install-source-proof.json")
+		if err := writeAIInstallSourceProofFileIn(bound, fileID, target, payload); err != nil {
+			t.Fatalf("an untouched directory must accept the publication, got %v", err)
+		}
+		published, err := os.ReadFile(target)
+		if err != nil {
+			t.Fatalf("read the published carrier: %v", err)
+		}
+		if string(published) != string(payload) {
+			t.Fatalf("the published carrier must be the payload, got %q", published)
+		}
+	})
+
+	t.Run("a-junction-inserted-after-the-binding-refuses-the-recheck", func(t *testing.T) {
+		directory := filepath.Join(root, "publish-link")
+		if err := os.Mkdir(directory, 0o755); err != nil {
+			t.Fatalf("create the publication directory: %v", err)
+		}
+		bound, fileID, err := evidence.OpenBoundDirVerified(directory)
+		if err != nil {
+			t.Skipf("this host's temporary root is not link-free, so the binding cannot be established: %v", err)
+		}
+		defer func() { _ = bound.Close() }()
+
+		renamed := filepath.Join(root, "publish-link-renamed")
+		if err := os.Rename(directory, renamed); err != nil {
+			t.Fatalf("rename the publication directory away: %v", err)
+		}
+		if output, err := exec.Command("cmd", "/c", "mklink", "/J", directory, renamed).CombinedOutput(); err != nil {
+			t.Skipf("this host cannot create the junction %s -> %s without elevation: %v (%s)", directory, renamed, err, strings.TrimSpace(string(output)))
+		}
+		t.Cleanup(func() { _ = os.Remove(directory) })
+
+		// The shape the pre-fix re-check accepted: the name-based comparison reports
+		// the bound identity because the junction is followed to the same object.
+		named, err := evidence.FileIDAt(directory)
+		if err != nil {
+			t.Fatalf("identify the junction by name: %v", err)
+		}
+		if named != fileID {
+			t.Fatalf("the fixture must make the name-based comparison agree with the binding (%s != %s), otherwise this leg does not discriminate", named, fileID)
+		}
+
+		target := filepath.Join(directory, "install-source-proof.json")
+		err = writeAIInstallSourceProofFileIn(bound, fileID, target, payload)
+		if err == nil {
+			t.Fatal("a directory whose name became a junction must refuse the publication, even when it resolves to the bound object")
+		}
+		if !errors.Is(err, ErrAIInstallSourceUnproven) {
+			t.Fatalf("the refusal must be the install-source sentinel, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "re-bound without following a link") {
+			t.Fatalf("the refusal must come from the root-chain re-bind, got %v", err)
+		}
+		// A refused publication leaves no carrier, neither through the junction nor
+		// behind it.
+		for _, path := range []string{target, filepath.Join(renamed, "install-source-proof.json")} {
+			if _, statErr := os.Stat(path); !errors.Is(statErr, os.ErrNotExist) {
+				t.Fatalf("a refused publication must leave no carrier at %s (stat error %v)", path, statErr)
+			}
+		}
+	})
+}
diff --git a/internal/console/p85_t2_frozen_policy_tester_test.go b/internal/console/p85_t2_frozen_policy_tester_test.go
new file mode 100644
index 0000000..800fa4d
--- /dev/null
+++ b/internal/console/p85_t2_frozen_policy_tester_test.go
@@ -0,0 +1,781 @@
+package console
+
+// P85 T2 (finding F3): the counterexamples and the mutation targets of the
+// durable FROZEN policy artifact.
+//
+// The design (tmp/P85-SECURITY-PROOF-SUBSYSTEM/01-design.md §2.4-§2.6) names
+// three counterexample classes and two mutations:
+//
+//	missing          - the artifact does not exist when Review/Publish reread it;
+//	unreadable       - the artifact exists but cannot be decoded (strict JSON);
+//	well-formed but mismatched
+//	                 - the artifact is internally consistent yet names another
+//	                   policy than the operator grant, and the same class covers an
+//	                   artifact replaced between Review and Publish.
+//
+// Mutation contracts:
+//   - dropping the artifact comparison from operatorApprovedPolicyHashForAttempt
+//     (runtime_agent.go) turns TestP85T2ReviewRefusesPolicyArtifactThatIsNotTheGrantedOne
+//     green;
+//   - dropping the disk reread from verifyReviewPolicyBinding (runtime_agent.go)
+//     turns TestP85T2PublishRefusesArtifactReplacedAfterReview green.
+//
+// Every refusal assertion below states three facts, never just "some error came
+// back": no approve decision, no accepted snapshot / no lease evidence, and the
+// evidence that was on disk is still byte-identical.
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	goruntime "runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/chain"
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85PolicyBody builds the policy body of the shape preview.go produces, so a
+// fixture can state exactly the policy a run was previewed under.
+func p85PolicyBody(chainID string, taskIDs ...string) previewPolicy {
+	tasks := make([]previewPolicyTask, 0, len(taskIDs))
+	for _, taskID := range taskIDs {
+		tasks = append(tasks, previewPolicyTask{
+			TaskID:              taskID,
+			Review:              "required",
+			DocumentationPolicy: "required",
+		})
+	}
+	return previewPolicy{
+		ChainID:            chainID,
+		ChainProfile:       "standard",
+		ChainDocumentation: "required",
+		Tasks:              tasks,
+	}
+}
+
+// p85AttachFrozenPolicyStore binds the run root and the replay store the T2
+// ports read the artifact through. Each test owns its run root, so the fixture
+// never shares state with another test.
+func p85AttachFrozenPolicyStore(t *testing.T, runtime *agentRunnerRuntime) {
+	t.Helper()
+	if runtime.runRoot == "" {
+		runtime.runRoot = t.TempDir()
+	}
+	if err := ensureAgentRunnerEventLogMarker(runEventLogPath(runtime.runRoot)); err != nil {
+		t.Fatal(err)
+	}
+	if runtime.store == nil {
+		store, err := adapters.NewAgentRunnerReplayStoreForRun(runtime.runRoot, runtime.runID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		runtime.store = store
+	}
+}
+
+// p85FreezeAgentRunnerPolicy persists one frozen policy artifact for the runtime
+// and returns the policy body plus the hash an operator grant must carry to be
+// comparable with it.
+func p85FreezeAgentRunnerPolicy(t *testing.T, runtime *agentRunnerRuntime, taskID, stepID string, attempt int) (previewPolicy, string) {
+	t.Helper()
+	p85AttachFrozenPolicyStore(t, runtime)
+	body := p85PolicyBody(runtime.runID+"-chain", taskID)
+	// F01 (P85 fix round 3): the freeze also proves the managed identity cannot
+	// write the policy directory. That proof cannot succeed on this platform (the
+	// assembly and the managed agent share one OS identity), so the fixture injects
+	// the same test seam the production assembly fixture uses; the production
+	// fail-closed path is pinned by the "without proof" counterexample below.
+	//
+	// P85 review r1 (new Medium): every load/Review/Publish of this artifact
+	// re-observes the write domain and requires the anchor's value to be THAT
+	// observation. The fixture therefore installs the matching stand-in, so the
+	// cases below keep measuring their own property instead of the shared-identity
+	// host; the real primitive is exercised by the M1/M2/M10 counterexamples.
+	p85StubManagedWriteProofObservation(t, assemblyManagedWriteProof)
+	persisted, err := persistAgentRunnerFrozenPolicyProven(runtime.store, runtime.runRoot, runtime.runID, taskID, stepID, attempt, body, assemblyManagedWriteProof)
+	if err != nil {
+		t.Fatalf("freeze the policy of task %q step %q attempt %d: %v", taskID, stepID, attempt, err)
+	}
+	return persisted.PolicyBody, persisted.PolicyHash
+}
