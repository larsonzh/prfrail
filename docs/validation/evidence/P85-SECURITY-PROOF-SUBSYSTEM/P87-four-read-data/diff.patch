+// p85AssertAssemblyRefusedWithoutWriteProof pins the fail-closed shape of a
+// policy freeze that could not prove the managed identity is unable to write the
+// policy directory: zero summary, zero frozen artifacts, no managed-process
+// identity mirror and no dispatch transition.
+func p85AssertAssemblyRefusedWithoutWriteProof(t *testing.T, runRoot string, summary RunSummary, err error) {
+	t.Helper()
+	if !errors.Is(err, ErrInvalidConfig) {
+		t.Fatalf("an assembly that cannot prove the policy write domain closed must be refused, got %+v, %v", summary, err)
+	}
+	if summary.ChainState != "" || summary.RunID != "" {
+		t.Fatalf("a refused assembly must return no summary, got %+v", summary)
+	}
+	if entries := agentRunnerDirEntries(t, agentRunnerPolicyDirectory(runRoot)); len(entries) != 0 {
+		t.Fatalf("a refused assembly must freeze no policy artifact, found %v", entries)
+	}
+	if _, statErr := os.Stat(filepath.Join(runRoot, managedProcessIdentityFileName)); !errors.Is(statErr, os.ErrNotExist) {
+		t.Fatalf("a refused assembly must leave no managed-process identity mirror (stat err=%v)", statErr)
+	}
+	data, readErr := os.ReadFile(runEventLogPath(runRoot))
+	if readErr != nil && !errors.Is(readErr, os.ErrNotExist) {
+		t.Fatal(readErr)
+	}
+	if strings.Contains(string(data), "agent-dispatched") || strings.Contains(string(data), "TERMINAL_PENDING") {
+		t.Fatalf("a policy-freeze refusal must record no dispatch transition: %s", data)
+	}
+}
+
+// p85RewriteAnchorProof rewrites ONLY the managed-write proof field of the
+// assembly anchor of the one task attempt the T2 fixtures use. The anchor stays
+// strict-decodable and the artifact is not touched, so the mutation isolates the
+// anchor as the single varying fact.
+func p85RewriteAnchorProof(t *testing.T, runtime *agentRunnerRuntime, proof string) (original, rewritten []byte) {
+	t.Helper()
+	anchorPath := agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+	original, err := os.ReadFile(anchorPath)
+	if err != nil {
+		t.Fatalf("read the frozen policy anchor: %v", err)
+	}
+	var anchor agentRunnerFrozenPolicyAnchor
+	if err := evidence.DecodeStrictJSON(original, &anchor); err != nil {
+		t.Fatalf("decode the frozen policy anchor: %v", err)
+	}
+	anchor.ManagedWriteProof = proof
+	rewritten, err = agentRunnerFrozenPolicyAnchorPayload(anchor)
+	if err != nil {
+		t.Fatalf("encode the rewritten frozen policy anchor: %v", err)
+	}
+	if err := os.WriteFile(anchorPath, rewritten, 0o600); err != nil {
+		t.Fatalf("rewrite the frozen policy anchor: %v", err)
+	}
+	return original, rewritten
+}
+
+// TestP85T2AssemblyRefusesWithoutManagedWriteProof is the F01 (P85 fix round 3)
+// fail-closed counterexample: without the injected test seam the real platform
+// guard runs, and on this platform it can never prove the managed identity is
+// unable to write the directory the assembly itself created. The assembly must
+// therefore refuse before any dispatch and freeze nothing.
+//
+// Mutation check: returning a constant from agentRunnerProvePolicyWriteProtection
+// instead of running the guard turns this refusal green.
+func TestP85T2AssemblyRefusesWithoutManagedWriteProof(t *testing.T) {
+	fixture := newAssemblyFixture(t, assemblyKnobs{})
+	fixture.options.managedWriteProof = ""
+	summary, err := ExecuteAgentRunnerRun(context.Background(), fixture.options)
+	if err == nil || !strings.Contains(err.Error(), "cannot be proven unwritable") {
+		t.Fatalf("the refusal must name the unproven write domain, got %v", err)
+	}
+	p85AssertAssemblyRefusedWithoutWriteProof(t, fixture.runRoot, summary, err)
+}
+
+// TestP85T2AssemblyRefusesInvalidManagedWriteProof is the F01 counterexample of
+// the test seam itself: an injected value that is not a valid evidence digest
+// proves nothing, so the assembly refuses instead of adopting it as a proof.
+//
+// Mutation check: dropping the evidence.ValidHash check of the injected value in
+// agentRunnerProvePolicyWriteProtection lets this assembly freeze and turns the
+// refusal green.
+func TestP85T2AssemblyRefusesInvalidManagedWriteProof(t *testing.T) {
+	fixture := newAssemblyFixture(t, assemblyKnobs{})
+	fixture.options.managedWriteProof = "not-a-hash"
+	summary, err := ExecuteAgentRunnerRun(context.Background(), fixture.options)
+	if err == nil || !strings.Contains(err.Error(), "not a valid proof digest") {
+		t.Fatalf("the refusal must name the invalid proof digest, got %v", err)
+	}
+	p85AssertAssemblyRefusedWithoutWriteProof(t, fixture.runRoot, summary, err)
+}
+
+// TestP85T2PublishRefusesAnchorRewrittenAlone is the F01 counterexample that
+// isolates the ANCHOR: the frozen artifact is left byte-identical and the grant
+// still binds the same policy hash, so the only mutated fact is the anchor.
+//
+// Two legs state the contract:
+//  1. a reopened assembly (a resumed run adopting the existing artifact) refuses
+//     on the anchor byte comparison - confirmAgentRunnerFrozenPolicyAnchor - even
+//     when the rewritten proof is itself a valid digest, because the anchor is
+//     never replaced;
+//  2. Publish refuses when the rewritten anchor no longer carries a valid
+//     managed-write proof, because the load path requires that proof to reach the
+//     artifact.
+//
+// Mutation check: dropping the confirmAgentRunnerFrozenPolicyAnchor call from the
+// reuse branch turns leg 1 green; dropping the ManagedWriteProof check from
+// agentRunnerVerifyFrozenPolicyAnchor turns leg 2 green.
+func TestP85T2PublishRefusesAnchorRewrittenAlone(t *testing.T) {
+	t.Run("a rewritten anchor refuses the reopening assembly", func(t *testing.T) {
+		runtime, _ := p85FrozenReviewRuntime(t)
+		body := p85PolicyBody(runtime.runID+"-chain", p83TaskID)
+		artifactBefore := p85ReadFrozenPolicyBytes(t, runtime)
+		// A different but still valid proof digest: the anchor stays decodable and
+		// semantically plausible, so only the byte comparison can catch the rewrite.
+		otherProof := "sha256:" + strings.Repeat("2", 64)
+		original, rewritten := p85RewriteAnchorProof(t, runtime, otherProof)
+		if string(original) == string(rewritten) {
+			t.Fatal("the fixture never changed the anchor")
+		}
+		_, err := persistAgentRunnerFrozenPolicyProven(runtime.store, runtime.runRoot, p83RunID, p83TaskID, p83StepID, 1, body, assemblyManagedWriteProof)
+		if !errors.Is(err, ErrInvalidConfig) {
+			t.Fatalf("a reopened assembly must refuse a rewritten anchor, got %v", err)
+		}
+		if !strings.Contains(err.Error(), "anchor") || !strings.Contains(err.Error(), "different content") {
+			t.Fatalf("the refusal must come from the anchor byte comparison, got %v", err)
+		}
+		if after := p85ReadFrozenPolicyBytes(t, runtime); string(after) != string(artifactBefore) {
+			t.Fatalf("the artifact must stay byte-identical, got %q want %q", after, artifactBefore)
+		}
+		anchorPath := agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+		if after, readErr := os.ReadFile(anchorPath); readErr != nil || string(after) != string(rewritten) {
+			t.Fatalf("the refusal must not repair the anchor (read err=%v)", readErr)
+		}
+	})
+
+	t.Run("a rewritten anchor refuses publish", func(t *testing.T) {
+		runtime, runRoot := p83PublishRuntime(t)
+		proof, err := claimPublishLease(context.Background(), runRoot, p83RunID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		runtime.publishLease = proof
+		if _, err := runtime.Review(context.Background(), p85ReviewRequest()); err != nil {
+			t.Fatalf("the review must approve before the publish leg: %v", err)
+		}
+		evidenceRoot, err := runtime.evidenceRootHash(p83TaskID, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		request := chain.PromotionRequest{
+			RunID:                 p83RunID,
+			TaskID:                p83TaskID,
+			Attempt:               1,
+			CandidateSnapshotHash: evidence.Digest("", []byte("candidate")),
+			EvidenceRootHash:      evidenceRoot,
+			ReviewReceiptHash:     evidence.Digest("", []byte("review-receipt")),
+		}
+		artifactBefore := p85ReadFrozenPolicyBytes(t, runtime)
+		anchorPath := agentRunnerFrozenPolicyAnchorPath(runtime.runRoot, p83TaskID, p83StepID, 1)
+		original, _ := p85RewriteAnchorProof(t, runtime, "not-a-hash")
+
+		decision, err := runtime.Publish(context.Background(), request)
+		if err != nil {
+			t.Fatalf("a blocked promotion is a decision, not an error: %v", err)
+		}
+		if decision.Outcome != "failed" {
+			t.Fatalf("an anchor without a valid write proof must block the promotion, got %+v", decision)
+		}
+		if decision.AcceptedSnapshotHash != "" || len(decision.LeaseEvidence) != 0 || len(decision.WriterStopEvidence) != 0 {
+			t.Fatalf("a blocked promotion must accept no snapshot and bind no lease/writer evidence, got %+v", decision)
+		}
+		if len(decision.ErrorEvidence) == 0 {
+			t.Fatal("a blocked promotion must carry error evidence")
+		}
+		if after := p85ReadFrozenPolicyBytes(t, runtime); string(after) != string(artifactBefore) {
+			t.Fatalf("the artifact must stay byte-identical, got %q want %q", after, artifactBefore)
+		}
+
+		// The anchor is the sole cause: restoring it completes the same runtime.
+		if err := os.WriteFile(anchorPath, original, 0o600); err != nil {
+			t.Fatalf("restore the frozen policy anchor: %v", err)
+		}
+		restored, err := runtime.Publish(context.Background(), request)
+		if err != nil {
+			t.Fatalf("the restored anchor must be publishable, got %v", err)
+		}
+		if restored.Outcome != "completed" {
+			t.Fatalf("restoring the anchor must complete the promotion, got %+v", restored)
+		}
+	})
+}
diff --git a/internal/console/p85_t3_reentry_tester_test.go b/internal/console/p85_t3_reentry_tester_test.go
new file mode 100644
index 0000000..0b8fd36
--- /dev/null
+++ b/internal/console/p85_t3_reentry_tester_test.go
@@ -0,0 +1,241 @@
+package console
+
+// P85 T3 (finding F10, final review) - the re-entry half of the carrier publication.
+//
+// The publish path hard-links the carrier into place and THEN syncs the directory. If
+// the link became visible but that sync failed, the first call refused - and a
+// re-entry used to adopt the visible carrier without repeating the sync, silently
+// undoing the refusal. F10 requires the re-entry to confirm and re-sync the directory
+// BEFORE it may adopt an existing carrier.
+//
+// The branch under test is the `if found { ... }` half of
+// recordOrConfirmAIInstallSourceProof. It has exactly one return that hands back the
+// carrier's facts, and that return sits after aiInstallSourceConfirmDirectory and
+// aiInstallSourceSyncDirectory - so "adopted" implies "both ran on this entry" by
+// construction. The tests below measure the consequence that is observable from
+// outside: a carrier that cannot be confirmed is never adopted, and a carrier that can
+// be confirmed is adopted from its recorded bytes (never re-derived).
+//
+// P85 F10 (design rev 3, section 4.5 / test row M8): the exact injection this file
+// used to register as EXEMPT is now executable. The directory fsync is a package
+// seam (aiInstallSourceCarrierDirectorySync) and the re-entry guard is a package
+// flag (aiInstallSourceReentryRequiresSync), so BOTH halves of the counterexample
+// run natively:
+//
+//	A. the first publication's hard link is visible but its directory sync fails =>
+//	   the publication refuses, and a re-entry whose sync succeeds adopts;
+//	B. with the carrier reading cleanly, withdrawing ONLY the sync guard
+//	   (aiInstallSourceReentryRequiresSync=false) makes the same re-entry adopt =>
+//	   the earlier refusal is attributable to the sync guard, not to the carrier
+//	   reader that the link counterexample would trip first.
+//
+// The EXEMPT-REGISTERED P85/F10 note that lived here is therefore retired: the
+// behaviour is covered by TestP85F10ReentryRefusesToAdoptWhenTheSameHandleSyncFails
+// below (carried-by: the same-handle confirmation + sync of the `found` branch).
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85T3ReentryProvableExecutable returns an executable whose installation source the
+// live check can prove on this host, or skips the caller.
+//
+// P85 final review (F18) consequence: the interpreter rule now proves the ORIGINAL
+// name chain, so a merged-/usr host refuses /bin/sh (a link) instead of proving its
+// target. The candidate list therefore tries several system binaries and reports why
+// none was provable, instead of assuming /bin/sh.
+func p85T3ReentryProvableExecutable(t *testing.T) string {
+	t.Helper()
+	if runtime.GOOS != "linux" {
+		t.Skipf("the re-entry durability leg is Linux-only: on %s the publish grants no directory durability at all (atomic visibility only)", runtime.GOOS)
+	}
+	candidates := []string{"/usr/bin/true", "/bin/true", "/usr/bin/busybox", "/bin/sh"}
+	var lastErr error
+	for _, candidate := range candidates {
+		if _, err := os.Stat(candidate); err != nil {
+			continue
+		}
+		if _, err := adapters.VerifyAIInstallSource(candidate); err != nil {
+			lastErr = err
+			continue
+		}
+		return candidate
+	}
+	t.Skipf("no provable probe executable on this host (last refusal: %v); this leg needs a native non-root Ubuntu run whose install layout is link-free", lastErr)
+	return ""
+}
+
+// TestP85T3ReentryConfirmsDirectoryDurabilityBeforeAdoptingCarrier pins the F10
+// consequence at the re-entry branch: adoption is only reachable through the
+// confirmation (and sync) the re-entry performs, so a carrier the entry cannot confirm
+// is refused and left byte-identical, while a confirmable one is adopted from the
+// carrier's own facts rather than from a fresh observation.
+//
+// Mutation checks: deleting the aiInstallSourceConfirmDirectory call from the `found`
+// branch turns "a-carrier-behind-a-link-is-never-adopted" red (the entry would adopt a
+// directory it never bound); replacing the returned carrier facts with `facts` (the
+// fresh observation) turns "the-adopted-facts-are-the-recorded-facts" red.
+func TestP85T3ReentryConfirmsDirectoryDurabilityBeforeAdoptingCarrier(t *testing.T) {
+	executable := p85T3ReentryProvableExecutable(t)
+
+	t.Run("the-adopted-facts-are-the-recorded-facts", func(t *testing.T) {
+		root := t.TempDir()
+		carrierPath := p85T3CarrierPath(root)
+		now := time.Date(2026, 11, 23, 8, 0, 0, 0, time.UTC)
+
+		published, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now)
+		if err != nil {
+			t.Fatalf("a provable source must publish the carrier: %v", err)
+		}
+		wire, err := os.ReadFile(carrierPath)
+		if err != nil {
+			t.Fatalf("the published carrier must be readable: %v", err)
+		}
+		recorded, err := adapters.DecodeAIInstallSourceProof(wire)
+		if err != nil {
+			t.Fatalf("the published carrier must decode: %v", err)
+		}
+
+		// The re-entry: the carrier is already visible, so this takes the `found`
+		// branch - the one that must confirm the directory before adopting.
+		reentered, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now.Add(time.Hour))
+		if err != nil {
+			t.Fatalf("a confirmable carrier must be adopted: %v", err)
+		}
+		if !reentered.Matches(recorded) || reentered.ExecutablePath != published.ExecutablePath {
+			t.Fatalf("the re-entry must adopt the RECORDED facts, got %+v want %+v", reentered, recorded.Facts())
+		}
+		again, err := os.ReadFile(carrierPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(again) != string(wire) {
+			t.Fatalf("an adopted carrier must never be rewritten, got %q and %q", string(wire), string(again))
+		}
+	})
+
+	t.Run("a-carrier-behind-a-link-is-never-adopted", func(t *testing.T) {
+		root := t.TempDir()
+		store := filepath.Join(root, "carrier-store")
+		if err := os.MkdirAll(store, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		carrierPath := filepath.Join(store, adapters.AIInstallSourceProofFileName)
+		if _, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", time.Now().UTC()); err != nil {
+			t.Fatalf("a provable source must publish the carrier: %v", err)
+		}
+		published, err := os.ReadFile(carrierPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// The carrier is visible and its bytes MATCH the live observation, which is
+		// exactly the state the pre-fix re-entry adopted. The directory that must be
+		// confirmed is now reachable only through a link, so the link-free binding the
+		// re-entry performs before adoption cannot describe it.
+		link := filepath.Join(root, "carrier-link")
+		if err := os.Symlink(store, link); err != nil {
+			t.Skipf("this host cannot create the directory link the leg needs: %v", err)
+		}
+		linkedPath := filepath.Join(link, adapters.AIInstallSourceProofFileName)
+
+		_, err = recordOrConfirmAIInstallSourceProof(linkedPath, executable, "", time.Now().UTC())
+		if err == nil {
+			t.Fatal("a carrier whose directory cannot be confirmed must never be adopted")
+		}
+		if !errors.Is(err, ErrAIInstallSourceUnproven) {
+			t.Fatalf("the refusal must be the install-source classification, got %v", err)
+		}
+		if strings.Contains(err.Error(), executable) {
+			t.Fatalf("the refusal must not echo the executable path, got %q", err)
+		}
+		after, readErr := os.ReadFile(carrierPath)
+		if readErr != nil {
+			t.Fatalf("the carrier must stay readable after a refusal: %v", readErr)
+		}
+		if string(after) != string(published) {
+			t.Fatal("a refusal must never rewrite the published carrier")
+		}
+	})
+}
+
+// p85F10SyncFailureMarker is the stable text the injected sync failure carries, so
+// both halves (the first publication's raw propagation and the re-entry's wrapped
+// refusal) can be asserted without depending on either wrapper's wording.
+const p85F10SyncFailureMarker = "injected same-handle directory sync failure"
+
+// p85F10SeamExecutable names an executable whose install source this host can prove.
+// The seam test below measures the RE-ENTRY guard, which is platform-independent, so
+// it must not inherit the Linux-only durability precondition of the native leg.
+func p85F10SeamExecutable(t *testing.T) string {
+	t.Helper()
+	if runtime.GOOS != "windows" {
+		return p85T3ReentryProvableExecutable(t)
+	}
+	root := os.Getenv("SystemRoot")
+	if root == "" {
+		root = `C:\Windows`
+	}
+	shell := filepath.Join(root, "System32", "cmd.exe")
+	if _, err := adapters.VerifyAIInstallSource(shell); err != nil {
+		t.Skipf("the shell %s is not a provable install source on this host: %v", shell, err)
+	}
+	return shell
+}
+
+// TestP85F10ReentryRefusesToAdoptWhenTheSameHandleSyncFails is M8. See the file
+// header for the two legs and the mutation check.
+func TestP85F10ReentryRefusesToAdoptWhenTheSameHandleSyncFails(t *testing.T) {
+	executable := p85F10SeamExecutable(t)
+	now := time.Date(2026, 11, 23, 8, 0, 0, 0, time.UTC)
+
+	previousSync := aiInstallSourceCarrierDirectorySync
+	previousGuard := aiInstallSourceReentryRequiresSync
+	failSync := true
+	aiInstallSourceCarrierDirectorySync = func(bound *evidence.BoundDir) error {
+		if failSync {
+			return fmt.Errorf("%w: %s", ErrAIInstallSourceUnproven, p85F10SyncFailureMarker)
+		}
+		return previousSync(bound)
+	}
+	t.Cleanup(func() {
+		aiInstallSourceCarrierDirectorySync = previousSync
+		aiInstallSourceReentryRequiresSync = previousGuard
+	})
+
+	t.Run("a-failed-sync-refuses-the-first-publication", func(t *testing.T) {
+		root := t.TempDir()
+		carrierPath := p85T3CarrierPath(root)
+		failSync = true
+		_, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now)
+		if !errors.Is(err, ErrAIInstallSourceUnproven) || !strings.Contains(err.Error(), p85F10SyncFailureMarker) {
+			t.Fatalf("a same-handle directory sync failure must refuse the publication, got %v", err)
+		}
+		if _, statErr := os.Stat(carrierPath); statErr != nil {
+			t.Fatalf("the hard link is published before the sync, so the carrier must be visible: %v", statErr)
+		}
+
+		// Positive control: the very same carrier is adopted once the handle sync
+		// succeeds, so the refusal above is caused by the sync and nothing else.
+		failSync = false
+		if _, err := recordOrConfirmAIInstallSourceProof(carrierPath, executable, "", now.Add(time.Hour)); err != nil {
+			t.Fatalf("a re-entry whose same-handle sync succeeds must adopt the carrier, got %v", err)
+		}
+	})
+
+	// The former second leg withdrew the guard AND cleared the failure injection in
+	// one step, which made it non-discriminating (P85 review r2, F10): deleting the
+	// re-entry sync or the guard condition left it green. It is superseded by the
+	// three orthogonal legs of TestP85R4M16ReentrySyncGuardIsDiscriminating
+	// (p85_r4_m16_sync_guard_tester_test.go): leg-R keeps the injection failing with
+	// the guard ON, leg-G keeps it failing with ONLY the guard OFF.
+}
diff --git a/internal/console/p85_t3_tester_test.go b/internal/console/p85_t3_tester_test.go
new file mode 100644
index 0000000..1a5e2e6
--- /dev/null
+++ b/internal/console/p85_t3_tester_test.go
@@ -0,0 +1,277 @@
+package console
+
+// P85 T3 (finding F6) - the install source counterexamples at the command boundary.
+//
+// `ai check` admits an agent-runner-cli probe only after it has PROVEN that the
+// probe executable's installation source is immutable: a stable absolute path whose
+// install directory denies this user write, delete and permission changes
+// (Windows DACL) or whose every path component is unwritable and foreign-owned
+// (Linux). The proof is memoised into the store-local carrier
+// `ai-install-source-proof.json` under the chain-config directory, but the verdict
+// always comes from a fresh observation - so a missing, unreadable or stale carrier
+// can only ever REFUSE, never admit.
+//
+// The counterexamples below assert the three refusals named by the design (§3.4)
+// plus the positive control that the carrier is published and then converges. Each
+// one asserts the full consequence, not just a non-zero exit: no credential is
+// resolved, the availability checker is never entered, no availability record is
+// published, and the carrier on disk is either absent (nothing was proven) or
+// byte-identical to what the test wrote (a published proof is never repaired).
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/adapters"
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// p85T3ImmutableProbeExecutable returns an executable whose installation source the
+// live check can actually prove on this host, or skips the caller.
+//
+// The console gate is hardwired to the platform observation (there is no injectable
+// verifier), so a positive fixtures has only two honest choices: a binary shipped by
+// the OS in an unwritable directory, or a skip. A stub written into t.TempDir() is
+// exactly the shape T3 refuses - that is the finding, not a test artefact.
+func p85T3ImmutableProbeExecutable(t *testing.T) string {
+	t.Helper()
+	var candidate string
+	switch runtime.GOOS {
+	case "windows":
+		root := os.Getenv("SystemRoot")
+		if root == "" {
+			root = `C:\Windows`
+		}
+		candidate = filepath.Join(root, "System32", "cmd.exe")
+	case "linux":
+		candidate = "/bin/sh"
+	default:
+		t.Skipf("the install source proof has a platform rule only for windows and linux, not %s", runtime.GOOS)
+	}
+	if _, err := adapters.VerifyAIInstallSource(candidate); err != nil {
+		// euid 0 cannot prove immutability by design (see ai_install_proof_unix.go),
+		// so a root CI leg must skip the positive path instead of failing it.
+		t.Skipf("the fixture executable %s is not provably immutable for the executing user on this host (%v); this positive path needs a native non-root Ubuntu run", candidate, err)
+	}
+	return candidate
+}
+
+// p85T3CarrierPath is the carrier location the command derives on its own: the
+// trusted root of the chain configuration. A test never passes this as a flag,
+// because the command does not accept one - that is the self-approval hole T3
+// closes.
+func p85T3CarrierPath(root string) string {
+	return filepath.Join(root, adapters.AIInstallSourceProofFileName)
+}
+
+// p85T3CheckOutcome is what one `ai check` invocation did, from the outside.
+type p85T3CheckOutcome struct {
+	code         int
+	output       string
+	checkerCalls int
+	resolveCalls int
+	outputPath   string
+}
+
+// p85T3RunCheck runs `ai check` against the shared configured chain with an
+// instrumented secret store and an availability checker that never spawns anything.
+func p85T3RunCheck(t *testing.T, root, configPath, executablePath, outName string) p85T3CheckOutcome {
+	t.Helper()
+	secrets := &recordingProbeSecrets{credential: []byte("p85-t3-probe-credential")}
+	cli := newTestCLI(root)
+	cli.secretManager = secrets
+	entries := 0
+	cli.checkAIAvailability = func(_ context.Context, profile adapters.AIProviderProfile, channel string, _ int, _ aiProbeReceiver, _ string) (adapters.AIAvailabilityRecord, error) {
+		entries++
+		if _, resolveErr := cli.secretManager.Resolve(context.Background(), profile.SecretRef); resolveErr != nil {
+			return adapters.AIAvailabilityRecord{}, resolveErr
+		}
+		return adapters.NewAIAvailabilityRecord(adapters.AIAvailability{
+			ProbeID:           "p85-t3-probe",
+			ProfileID:         profile.ProfileID,
+			ProfileConfigHash: mustAIProfileHash(t, profile),
+			Channel:           channel,
+			ProbedAt:          "2026-09-11T08:00:00.000Z",
+			Status:            "available",
+			RequestsUsed:      1,
+			Evidence:          []string{"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
+		})
+	}
+	outputPath := filepath.Join(root, outName)
+	code, stdout, stderr := runCLI(t, cli,
+		"ai", "check", "--chain", configPath, "--channel", "agent-runner-cli",
+		"--copilot", executablePath, "--max-requests", "1", "--out", outputPath, "--json",
+	)
+	return p85T3CheckOutcome{
+		code:         code,
+		output:       stdout + stderr,
+		checkerCalls: entries,
+		resolveCalls: secrets.resolveCalls,
+		outputPath:   outputPath,
+	}
+}
+
+// p85T3AssertRefusedBeforeAnyCredential pins the whole consequence of a refusal.
+func p85T3AssertRefusedBeforeAnyCredential(t *testing.T, outcome p85T3CheckOutcome, carrierPath string) {
+	t.Helper()
+	if outcome.code != exitFailure {
+		t.Fatalf("an unproven install source must fail closed, got code=%d output=%q", outcome.code, outcome.output)
+	}
+	if !strings.Contains(outcome.output, "install source") {
+		t.Fatalf("the install source gate must be the refusing guard, got %q", outcome.output)
+	}
+	if outcome.checkerCalls != 0 {
+		t.Fatalf("the availability checker must not be entered, entries=%d", outcome.checkerCalls)
+	}
+	if outcome.resolveCalls != 0 {
+		t.Fatalf("no credential may be resolved, resolutions=%d", outcome.resolveCalls)
+	}
+	if _, statErr := os.Lstat(outcome.outputPath); !os.IsNotExist(statErr) {
+		t.Fatalf("no availability record may be published, stat err=%v", statErr)
+	}
+	if _, statErr := os.Lstat(carrierPath); statErr != nil && !os.IsNotExist(statErr) {
+		t.Fatalf("unexpected carrier state: %v", statErr)
+	}
+}
+
+// TestP85T3RefusesUnprovableInstallSourceWithoutPublishingCarrier is the "carrier
+// missing and the live observation cannot replace it" counterexample: the probe
+// executable sits in a directory this user can write, so nothing can be proven and
+// nothing may be memoised.
+//
+// Mutation check: dropping the ACL capability probe (Windows) or the mode/owner
+// check (Linux) makes the observation succeed, the checker run and this red.
+func TestP85T3RefusesUnprovableInstallSourceWithoutPublishingCarrier(t *testing.T) {
+	root := t.TempDir()
+	configPath := writeAIProbeTestChain(t, root)
+	executablePath := filepath.Join(root, "copilot.exe")
+	// A writable directory this user owns: writable on every platform T3 supports.
+	if err := os.WriteFile(executablePath, []byte("p85-t3-unprovable-probe"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	// The operator grant exists, so the refusal below is attributable to the install
+	// source gate and not to an unapproved receiver.
+	writeAIProbeApprovedLedger(t, root, executablePath)
+	carrierPath := p85T3CarrierPath(root)
+
+	outcome := p85T3RunCheck(t, root, configPath, executablePath, "p85-t3-unprovable.json")
+	p85T3AssertRefusedBeforeAnyCredential(t, outcome, carrierPath)
+	if _, statErr := os.Lstat(carrierPath); !os.IsNotExist(statErr) {
+		t.Fatalf("an unproven source must not publish a carrier, stat err=%v", statErr)
+	}
+}
+
+// TestP85T3RefusesMalformedCarrierInsteadOfRecomputing is the "carrier unreadable"
+// counterexample: a carrier that cannot be decoded is a refusal, never a cue to
+// recompute and continue. The carrier bytes must survive untouched, so an operator
+// can still see what was rejected.
+func TestP85T3RefusesMalformedCarrierInsteadOfRecomputing(t *testing.T) {
+	root := t.TempDir()
+	configPath := writeAIProbeTestChain(t, root)
+	executablePath := p85T3ImmutableProbeExecutable(t)
+	writeAIProbeApprovedLedger(t, root, executablePath)
+
+	carrierPath := p85T3CarrierPath(root)
+	const malformed = `{"schemaVersion":1,"executablePath":`
+	if err := os.WriteFile(carrierPath, []byte(malformed), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	outcome := p85T3RunCheck(t, root, configPath, executablePath, "p85-t3-malformed.json")
+	p85T3AssertRefusedBeforeAnyCredential(t, outcome, carrierPath)
+	wire, err := os.ReadFile(carrierPath)
+	if err != nil {
+		t.Fatalf("the rejected carrier must stay readable: %v", err)
+	}
+	if string(wire) != malformed {
+		t.Fatalf("a malformed carrier must never be rewritten, got %q", string(wire))
+	}
+}
+
+// TestP85T3RefusesCarrierThatNoLongerDescribesTheSource is the "well-formed but
+// mismatched" counterexample: the carrier parses and validates, but it describes a
+// different object (a different digest and identity), so the live observation does
+// not match it. The refusal must happen without touching the file.
+func TestP85T3RefusesCarrierThatNoLongerDescribesTheSource(t *testing.T) {
+	root := t.TempDir()
+	configPath := writeAIProbeTestChain(t, root)
+	executablePath := p85T3ImmutableProbeExecutable(t)
+	writeAIProbeApprovedLedger(t, root, executablePath)
+
+	facts, err := adapters.VerifyAIInstallSource(executablePath)
+	if err != nil {
+		t.Fatalf("the fixture executable must be provable: %v", err)
+	}
+	stale := facts
+	stale.ExecutableHash = evidence.Digest("", []byte("p85-t3-a-different-approved-object"))
+	proof := adapters.NewAIInstallSourceProof(stale, time.Date(2026, 9, 8, 10, 0, 0, 0, time.UTC))
+	carrierPath := p85T3CarrierPath(root)
+	payload, err := adapters.EncodeAIInstallSourceProof(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(carrierPath, payload, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	outcome := p85T3RunCheck(t, root, configPath, executablePath, "p85-t3-stale.json")
+	p85T3AssertRefusedBeforeAnyCredential(t, outcome, carrierPath)
+	published, err := os.ReadFile(carrierPath)
+	if err != nil {
+		t.Fatalf("the stale carrier must stay readable: %v", err)
+	}
+	if string(published) != string(payload) {
+		t.Fatalf("a carrier that no longer describes the source must never be rewritten")
+	}
+}
+
+// TestP85T3PublishesTheCarrierAndConverges is the positive control: a provable
+// source publishes the carrier once, and a second run with the same source converges
+// on the published bytes instead of replacing them. Without this control the three
+// refusals above could be satisfied by refusing everything.
+func TestP85T3PublishesTheCarrierAndConverges(t *testing.T) {
+	root := t.TempDir()
+	configPath := writeAIProbeTestChain(t, root)
+	executablePath := p85T3ImmutableProbeExecutable(t)
+	writeAIProbeApprovedLedger(t, root, executablePath)
+	carrierPath := p85T3CarrierPath(root)
+
+	first := p85T3RunCheck(t, root, configPath, executablePath, "p85-t3-available-1.json")
+	if first.code != exitSuccess || first.checkerCalls != 1 || first.resolveCalls != 1 {
+		t.Fatalf("a provable source must be admitted, got code=%d checker=%d resolve=%d output=%q",
+			first.code, first.checkerCalls, first.resolveCalls, first.output)
+	}
+	published, err := os.ReadFile(carrierPath)
+	if err != nil {
+		t.Fatalf("an admitted probe must publish the carrier: %v", err)
+	}
+	decoded, err := adapters.DecodeAIInstallSourceProof(published)
+	if err != nil {
+		t.Fatalf("the published carrier must decode: %v", err)
+	}
+	facts, err := adapters.VerifyAIInstallSource(executablePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !facts.Matches(decoded) {
+		t.Fatalf("the published carrier must describe the live source, got %+v", decoded)
+	}
+
+	second := p85T3RunCheck(t, root, configPath, executablePath, "p85-t3-available-2.json")
+	if second.code != exitSuccess || second.checkerCalls != 1 {
+		t.Fatalf("a converged carrier must still admit the probe, got code=%d checker=%d output=%q",
+			second.code, second.checkerCalls, second.output)
+	}
+	again, err := os.ReadFile(carrierPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(again) != string(published) {
+		t.Fatalf("a converged carrier must be byte-identical, got %q and %q", string(published), string(again))
+	}
+}
