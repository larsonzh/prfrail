diff --git a/internal/adapters/ai_install_proof.go b/internal/adapters/ai_install_proof.go
new file mode 100644
index 0000000..f300630
--- /dev/null
+++ b/internal/adapters/ai_install_proof.go
@@ -0,0 +1,496 @@
+package adapters
+
+// T3 (finding F6): a durable proof that the probe executable's INSTALLATION
+// SOURCE is immutable.
+//
+// The P83 identity-plus-digest binding proves that the object that is executed is
+// the object that was approved, but it only spans the window between the bound
+// open and the spawn. It says nothing about who may REPLACE the object at that
+// path between two checks (Windows) or rewrite its bytes in place while keeping
+// the inode (Linux). This file owns the store-local carrier
+// `ai-install-source-proof.json` and the platform-neutral observation that fills
+// it:
+//
+//   - the carrier is written by `ai check` after the receiver is approved and
+//     before the probe starts, and it is re-read - and re-verified LIVE - by the
+//     check command and by the probe executor before every start;
+//   - the carrier is a MEMO of a fact that was true when it was recorded, never a
+//     verdict: every judgement is made from a fresh observation, so a stale
+//     carrier cannot admit a probe;
+//   - the observation is platform-specific (Windows DACL vs Unix mode/owner) and
+//     every platform that cannot prove it fails closed.
+//
+// The body is store-local protocol: no schema and no wire record depends on it.
+// Its bytes enter the proofrail:ai-install-source-proof:1\n domain digest, which
+// is the only digest this file publishes.
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+const (
+	// AIInstallSourceProofFileName is the carrier name inside the trusted root
+	// derived from the chain-config directory. A caller never chooses the path.
+	AIInstallSourceProofFileName = "ai-install-source-proof.json"
+	// AIInstallSourceProofByteBound bounds one carrier read. A carrier larger than
+	// this is already far past anything this file produces, so an oversized one is
+	// a refusal, never a silently truncated read.
+	AIInstallSourceProofByteBound int64 = 1 << 20
+	// AIInstallSourceProofDomain is the digest domain of the carrier bytes. The
+	// platform-specific evidence digests use their own domains (declared in the
+	// platform files), so a value observed on one platform can never be replayed
+	// as another platform's fact.
+	AIInstallSourceProofDomain = "proofrail:ai-install-source-proof:1\n"
+
+	aiInstallSourceProofSchemaVersion = 1
+	aiInstallSourcePlatformDomain     = "proofrail:ai-install-source-platform:1\n"
+)
+
+// ErrAIInstallSourceProof reports an installation source whose immutability could
+// not be proven. It is raised before any credential is resolved and again before
+// the spawn; the check command classifies it as cli_unavailable.
+var ErrAIInstallSourceProof = errors.New("AI install source is not proven immutable")
+
+// AIInstallSourcePlatform names the evaluation environment the proof was taken
+// in. A proof is only valid for the platform that produced it.
+type AIInstallSourcePlatform struct {
+	OS           string `json:"os"`
+	Arch         string `json:"arch"`
+	PlatformHash string `json:"platformHash"`
+}
+
+// AIInstallSourceWindowsFacts is the Windows observation: the DACL of the install
+// directory (and of the executable itself) grants this user's token no write,
+// delete or permission-changing right.
+type AIInstallSourceWindowsFacts struct {
+	DirACLDeniesWriteDelete bool   `json:"dirAclDeniesWriteDelete"`
+	ACLEvidenceHash         string `json:"aclEvidenceHash"`
+}
+
+// AIInstallSourceInterpreter is the interpreter a script executable (or a dynamic
+// ELF loader) delegates to. The kernel re-resolves that name at exec time, so the
+// proof records the interpreter's identity and digest and every start re-verifies
+// them.
+//
+// P85 F07: the chain is recursive, and every level of it is executed by the kernel
+// in turn. A script whose interpreter is itself a script (or a dynamic loader) used
+// to be verified to depth but only the FIRST level was recorded - the inner
+// identity was checked and then discarded, so a carrier could not describe the fact
+// the check had established. Interpreter carries that level, and a nil value means
+// "this object is exec'd directly" (a static ELF object).
+type AIInstallSourceInterpreter struct {
+	Path        string                      `json:"path"`
+	Hash        string                      `json:"hash"`
+	FileID      string                      `json:"fileID"`
+	Interpreter *AIInstallSourceInterpreter `json:"interpreter,omitempty"`
+}
+
+// AIInstallSourceLinuxFacts is the Linux observation: every component of the
+// executable's path (install directory included) and of its shebang interpreter
+// is unwritable by the executing user and not owned by that user.
+type AIInstallSourceLinuxFacts struct {
+	UnwritablePath        bool                        `json:"unwritablePath"`
+	OwnershipEvidenceHash string                      `json:"ownershipEvidenceHash"`
+	Interpreter           *AIInstallSourceInterpreter `json:"interpreter,omitempty"`
+}
+
+// AIInstallSourceImmutability carries the platform observation. Exactly one field
+// is set, matching the proof's platform: os, so a carrier cannot claim a Windows
+// fact on Linux or the other way round.
+type AIInstallSourceImmutability struct {
+	Windows *AIInstallSourceWindowsFacts `json:"windows,omitempty"`
+	Linux   *AIInstallSourceLinuxFacts   `json:"linux,omitempty"`
+}
+
+// AIInstallSourceFacts is one live observation of an executable's installation
+// source: what it is (path, digest, object identity), where it was observed, and
+// why it cannot be replaced.
+type AIInstallSourceFacts struct {
+	ExecutablePath string
+	ExecutableHash string
+	FileID         string
+	Platform       AIInstallSourcePlatform
+	Immutability   AIInstallSourceImmutability
+}
+
+// AIInstallSourceProof is the persisted carrier. It is store-local protocol: no
+// schema and no wire record depends on it.
+type AIInstallSourceProof struct {
+	SchemaVersion  int                         `json:"schemaVersion"`
+	ExecutablePath string                      `json:"executablePath"`
+	ExecutableHash string                      `json:"executableHash"`
+	FileID         string                      `json:"fileID"`
+	Platform       AIInstallSourcePlatform     `json:"platform"`
+	Immutability   AIInstallSourceImmutability `json:"immutability"`
+	RecordedAt     string                      `json:"recordedAt"`
+}
+
+// AIInstallSourcePlatformHash digests the running platform identity. It is the
+// probe's own measurement of the evaluation environment.
+func AIInstallSourcePlatformHash() string {
+	return evidence.Digest(aiInstallSourcePlatformDomain, []byte(runtime.GOOS+"\n"+runtime.GOARCH))
+}
+
+// AIInstallSourcePlatformFor returns the platform identity of one os/arch pair.
+func AIInstallSourcePlatformFor(osName, arch string) AIInstallSourcePlatform {
+	return AIInstallSourcePlatform{
+		OS:           osName,
+		Arch:         arch,
+		PlatformHash: evidence.Digest(aiInstallSourcePlatformDomain, []byte(osName+"\n"+arch)),
+	}
+}
+
+// NewAIInstallSourceProof turns one live observation into the carrier body. The
+// caller decides when to record it; this function never observes anything.
+func NewAIInstallSourceProof(facts AIInstallSourceFacts, recordedAt time.Time) AIInstallSourceProof {
+	return AIInstallSourceProof{
+		SchemaVersion:  aiInstallSourceProofSchemaVersion,
+		ExecutablePath: facts.ExecutablePath,
+		ExecutableHash: facts.ExecutableHash,
+		FileID:         facts.FileID,
+		Platform:       facts.Platform,
+		Immutability:   facts.Immutability,
+		RecordedAt:     recordedAt.UTC().Format(TimestampLayout),
+	}
+}
+
+// Facts is the observation one carrier describes. P85 F05: the carrier - not a
+// fresh re-derivation of the executable at spawn time - is the normative
+// description of the object the operator approved, so the console hands the
+// carrier's facts to the executor and the executor compares its live observation
+// against them. The mapping is a pure field copy; it observes nothing.
+func (proof AIInstallSourceProof) Facts() AIInstallSourceFacts {
+	return AIInstallSourceFacts{
+		ExecutablePath: proof.ExecutablePath,
+		ExecutableHash: proof.ExecutableHash,
+		FileID:         proof.FileID,
+		Platform:       proof.Platform,
+		Immutability:   proof.Immutability,
+	}
+}
+
+// EncodeAIInstallSourceProof returns the exact carrier bytes: canonical JSON plus
+// the document newline, never a BOM.
+func EncodeAIInstallSourceProof(proof AIInstallSourceProof) ([]byte, error) {
+	canonical, err := evidence.EncodeCanonical(proof)
+	if err != nil {
+		return nil, fmt.Errorf("%w: the install source proof cannot be canonicalized: %v", ErrAIInstallSourceProof, err)
+	}
+	return append(append([]byte(nil), canonical...), '\n'), nil
+}
+
+// DecodeAIInstallSourceProof decodes and validates one carrier body. A body that
+// is malformed, carries unknown fields or fails validation is an error: a carrier
+// that cannot be read is a refusal, never "recompute and continue".
+func DecodeAIInstallSourceProof(wire []byte) (AIInstallSourceProof, error) {
+	var proof AIInstallSourceProof
+	if err := evidence.DecodeStrictJSON(wire, &proof); err != nil {
+		return AIInstallSourceProof{}, fmt.Errorf("%w: the install source proof is malformed: %v", ErrAIInstallSourceProof, err)
+	}
+	if err := proof.Validate(); err != nil {
+		return AIInstallSourceProof{}, err
+	}
+	return proof, nil
+}
+
+// AIInstallSourceProofDigest is the domain digest of one carrier body. It answers
+// "are these two carrier bodies byte-identical?"; it is never a verdict.
+func AIInstallSourceProofDigest(wire []byte) string {
+	return evidence.Digest(AIInstallSourceProofDomain, wire)
+}
+
+// Validate refuses a carrier that cannot describe a proven install source. The
+// platform fact has to match the recorded platform exactly, so the carrier cannot
+// mix a Windows claim with a Linux one.
+func (proof AIInstallSourceProof) Validate() error {
+	if proof.SchemaVersion != aiInstallSourceProofSchemaVersion {
+		return fmt.Errorf("%w: unsupported schema version %d", ErrAIInstallSourceProof, proof.SchemaVersion)
+	}
+	if !filepath.IsAbs(proof.ExecutablePath) {
+		return fmt.Errorf("%w: the recorded executable %q is not an absolute path", ErrAIInstallSourceProof, proof.ExecutablePath)
+	}
+	if !evidence.ValidHash(proof.ExecutableHash) || proof.FileID == "" {
+		return fmt.Errorf("%w: the recorded executable carries no valid digest or identity", ErrAIInstallSourceProof)
+	}
+	if !validAIInstallSourcePlatform(proof.Platform) {
+		return fmt.Errorf("%w: the recorded platform %q/%q is not valid", ErrAIInstallSourceProof, proof.Platform.OS, proof.Platform.Arch)
+	}
+	if _, err := time.Parse(TimestampLayout, proof.RecordedAt); err != nil {
+		return fmt.Errorf("%w: the recorded timestamp %q is not valid: %v", ErrAIInstallSourceProof, proof.RecordedAt, err)
+	}
+	switch proof.Platform.OS {
+	case "windows":
+		if proof.Immutability.Windows == nil || proof.Immutability.Linux != nil {
+			return fmt.Errorf("%w: a windows proof must carry exactly the windows facts", ErrAIInstallSourceProof)
+		}
+		if !proof.Immutability.Windows.DirACLDeniesWriteDelete {
+			return fmt.Errorf("%w: the recorded windows facts do not deny write and delete", ErrAIInstallSourceProof)
+		}
+		if !evidence.ValidHash(proof.Immutability.Windows.ACLEvidenceHash) {
+			return fmt.Errorf("%w: the recorded windows ACL evidence carries no valid digest", ErrAIInstallSourceProof)
+		}
+	case "linux":
+		if proof.Immutability.Linux == nil || proof.Immutability.Windows != nil {
+			return fmt.Errorf("%w: a linux proof must carry exactly the linux facts", ErrAIInstallSourceProof)
+		}
+		if !proof.Immutability.Linux.UnwritablePath {
+			return fmt.Errorf("%w: the recorded linux facts do not prove an unwritable path", ErrAIInstallSourceProof)
+		}
+		if !evidence.ValidHash(proof.Immutability.Linux.OwnershipEvidenceHash) {
+			return fmt.Errorf("%w: the recorded linux ownership evidence carries no valid digest", ErrAIInstallSourceProof)
+		}
+		if interpreter := proof.Immutability.Linux.Interpreter; interpreter != nil {
+			if err := validateAIInstallSourceInterpreter(interpreter, 1); err != nil {
+				return err
+			}
+		}
+	default:
+		return fmt.Errorf("%w: %q cannot carry an install source proof", ErrAIInstallSourceProof, proof.Platform.OS)
+	}
+	return nil
+}
+
+// aiInstallSourceInterpreterDepthLimit bounds how many nested interpreter levels a
+// carrier may describe. It matches the observation limit of the Linux walk: a
+// chain deeper than that is refused there, so a deeper carrier could only be
+// forged, and a forged deeper chain is a refusal.
+const aiInstallSourceInterpreterDepthLimit = 8
+
+// validateAIInstallSourceInterpreter refuses an incomplete or over-deep
+// interpreter level. Every recorded level is normative: the executor compares the
+// live observation against it level by level, so a level that cannot be described
+// must not be admitted (P85 F07).
+func validateAIInstallSourceInterpreter(interpreter *AIInstallSourceInterpreter, depth int) error {
+	if interpreter == nil {
+		return fmt.Errorf("%w: the recorded interpreter chain carries an empty level", ErrAIInstallSourceProof)
+	}
+	if depth > aiInstallSourceInterpreterDepthLimit {
+		return fmt.Errorf("%w: the recorded interpreter chain is deeper than %d levels", ErrAIInstallSourceProof, aiInstallSourceInterpreterDepthLimit)
+	}
+	if !filepath.IsAbs(interpreter.Path) || !evidence.ValidHash(interpreter.Hash) || interpreter.FileID == "" {
+		return fmt.Errorf("%w: the recorded shebang interpreter is incomplete", ErrAIInstallSourceProof)
+	}
+	if interpreter.Interpreter != nil {
+		return validateAIInstallSourceInterpreter(interpreter.Interpreter, depth+1)
+	}
+	return nil
+}
+
+// Matches reports whether a live observation still describes the carrier. The
+// executable path is compared the way the host filesystem compares it; every
+// other field is compared exactly, because a changed digest, identity, platform or
+// permission fact is exactly what the proof exists to detect.
+func (facts AIInstallSourceFacts) Matches(proof AIInstallSourceProof) bool {
+	return facts.MatchesFacts(proof.Facts())
+}
+
+// MatchesFacts compares two observations item by item under the same rules Matches
+// uses. P85 F05 needs it because the spawn boundary compares a LIVE observation
+// against the CARRIER's facts (the approved object), not against a carrier body.
+func (facts AIInstallSourceFacts) MatchesFacts(other AIInstallSourceFacts) bool {
+	if !aiInstallSourcePathEqual(facts.ExecutablePath, other.ExecutablePath) {
+		return false
+	}
+	if facts.ExecutableHash != other.ExecutableHash || facts.FileID != other.FileID {
+		return false
+	}
+	if facts.Platform != other.Platform {
+		return false
+	}
+	return aiInstallSourceImmutabilityEqual(facts.Immutability, other.Immutability)
+}
+
+// VerifyAIInstallSource observes the installation source of one executable: the
+// name has to be a stable absolute path, the object identity and digest come from
+// ONE bound open, and the platform observation has to prove that this user cannot
+// write, delete or re-permission the object.
+//
+// P85 F06: the leaf is opened the way the frozen-policy artifacts are opened - the
+// derived directory is bound to a handle (evidence.OpenBoundDir) and the leaf name
+// is resolved INSIDE that handle (evidence.OpenBoundDirFile, O_NOFOLLOW on Linux
+// and an explicit reparse classification on Windows). A symlink or reparse point at
+// the leaf therefore refuses instead of being followed, and the identity, digest
+// and (on Linux) the interpreter/ELF header are all taken from that one handle.
+func VerifyAIInstallSource(executable string) (AIInstallSourceFacts, error) {
+	path := strings.TrimSpace(executable)
+	if path == "" {
+		return AIInstallSourceFacts{}, fmt.Errorf("%w: no executable was named", ErrAIInstallSourceProof)
+	}
+	if !filepath.IsAbs(path) {
+		return AIInstallSourceFacts{}, fmt.Errorf("%w: %q is not a stable absolute path", ErrAIInstallSourceProof, path)
+	}
+	file, err := openInstallSourceLeaf(path)
+	if err != nil {
+		return AIInstallSourceFacts{}, err
+	}
+	defer func() { _ = file.Close() }()
+	fileID, err := file.FileID()
+	if err != nil {
+		return AIInstallSourceFacts{}, fmt.Errorf("%w: identify the executable %q: %v", ErrAIInstallSourceProof, path, err)
+	}
+	digest, err := file.Hash(copilotCLIExecutableDomain)
+	if err != nil {
+		return AIInstallSourceFacts{}, fmt.Errorf("%w: digest the executable %q: %v", ErrAIInstallSourceProof, path, err)
+	}
+	immutability, err := verifyInstallSourceImmutability(path, file)
+	if err != nil {
+		return AIInstallSourceFacts{}, err
+	}
+	return AIInstallSourceFacts{
+		ExecutablePath: path,
+		ExecutableHash: digest,
+		FileID:         fileID,
+		Platform:       AIInstallSourcePlatformFor(runtime.GOOS, runtime.GOARCH),
+		Immutability:   immutability,
+	}, nil
+}
+
+// installSourceRequireCanonicalSpelling refuses any path whose spelling is not
+// already the canonical, cleaned form (P85 F07, design rev 3 section 3).
+//
+// The kernel does not clean the name it executes: an exec of "/a/../b" walks "/a"
+// (following a link there if one exists) and then "..", so the object that runs is
+// NOT the object "/b" names. Resolving such a spelling ourselves would prove one
+// name chain and hand the kernel another. The only honest rule for a chain this
+// layer cannot describe byte for byte is to refuse it, so every non-canonical
+// shape - a "." or ".." component, a doubled separator, a trailing separator
+// outside the root, a NUL - is rejected before anything is opened.
+//
+// On a canonical spelling filepath.Clean/Dir/Base are all IDENTITY operations, so
+// the callers below may keep using them without changing a single component: that
+// is exactly what makes "the string this rule proves" and "the string the kernel
+// walks" the same string.
+func installSourceRequireCanonicalSpelling(path string) error {
+	if path == "" {
+		return fmt.Errorf("%w: an empty path names no install source", ErrAIInstallSourceProof)
+	}
+	if strings.ContainsRune(path, 0) {
+		return fmt.Errorf("%w: %q carries a NUL byte, so its spelling cannot be canonical", ErrAIInstallSourceProof, path)
+	}
+	if !filepath.IsAbs(path) {
+		return fmt.Errorf("%w: %q is not a stable absolute path", ErrAIInstallSourceProof, path)
+	}
+	if cleaned := filepath.Clean(path); cleaned != path {
+		return fmt.Errorf("%w: %q is not the canonical spelling %q, so the name chain this rule would prove is not the chain the kernel walks",
+			ErrAIInstallSourceProof, path, cleaned)
+	}
+	return nil
+}
+
+// openInstallSourceLeaf opens one executable relative to a BOUND directory handle.
+// The caller's path is only used to open the directory; the leaf name is resolved
+// inside that handle, so a directory replaced between the two steps cannot redirect
+// the open and a symlink or reparse point at the leaf is refused by the primitive.
+//
+// P85 F02/F06/F07: the directory handle itself is opened WITHOUT following a link
+// at any component. The kernel walks the ORIGINAL name chain at exec time, so a
+// chain that carries a symbolic link is a chain this rule cannot describe: the link
+// target would be the object that runs while a different name was verified.
+// Refusing the link is the fail-closed half; a link-free chain is verified exactly
+// as the kernel would walk it.
+//
+// P85 R6 (review r3 finding): the binding is evidence.OpenBoundDirVerified, whose
+// Windows half IS the root-chain walk (openBoundDirChainHandle): every component
+// below the volume root is opened as itself and classified, and a reparse point -
+// junction, symbolic link or any other tag - refuses. The previous call,
+// evidence.OpenBoundDirNoFollow, fell through to a plain OpenBoundDir on Windows,
+// which follows a reparse point and then judged the target. The identity returned
+// by the SAME resolution is kept here, so the classification, the directory the
+// leaf is resolved in and the digest below are one handle chain - not a
+// classification followed by a separate by-name open.
+//
+// P85 F07 (fix round 3): the ORIGINAL spelling is what is split - never a cleaned
+// one. The spelling is first required to be canonical, and the Dir/Base split is
+// then asserted to be an identity (Dir+Base reproduce the original bytes), so a
+// resolver can no longer fold "..", ".", doubled or trailing separators away
+// before the directory is bound while the kernel still walks the folded-away form.
+func openInstallSourceLeaf(path string) (*evidence.BoundFile, error) {
+	if err := installSourceRequireCanonicalSpelling(path); err != nil {
+		return nil, err
+	}
+	directory, leaf := filepath.Dir(path), filepath.Base(path)
+	// On a canonical spelling this is an identity; the assertion makes it a proven
+	// property rather than an assumption of filepath, and it fires if a future
+	// refactor reintroduces a cleaning step upstream.
+	if rebuilt := filepath.Join(directory, leaf); rebuilt != path {
+		return nil, fmt.Errorf("%w: the split of %q into %q and %q is not an identity, so the opened chain would differ from the named one",
+			ErrAIInstallSourceProof, path, directory, leaf)
+	}
+	boundDirectory, directoryID, err := evidence.OpenBoundDirVerified(directory)
+	if err != nil {
+		return nil, fmt.Errorf("%w: bind the directory of %q: %v", ErrAIInstallSourceProof, path, err)
+	}
+	defer func() { _ = boundDirectory.Close() }()
+	file, err := evidence.OpenBoundDirFile(boundDirectory, leaf, copilotCLIExecutableMaxBytes)
+	if err != nil {
+		return nil, fmt.Errorf("%w: open the executable %q inside its bound directory (object %s): %v", ErrAIInstallSourceProof, path, directoryID, err)
+	}
+	return file, nil
+}
+
+func validAIInstallSourcePlatform(platform AIInstallSourcePlatform) bool {
+	if platform.OS == "" || platform.Arch == "" || !evidence.ValidHash(platform.PlatformHash) {
+		return false
+	}
+	derived := evidence.Digest(aiInstallSourcePlatformDomain, []byte(platform.OS+"\n"+platform.Arch))
+	return derived == platform.PlatformHash
+}
+
+// aiInstallSourcePathEqual compares two resolved paths the way the host
+// filesystem does: case-insensitively on Windows, byte-exactly elsewhere.
+func aiInstallSourcePathEqual(left, right string) bool {
+	left, right = filepath.Clean(left), filepath.Clean(right)
+	if runtime.GOOS == "windows" {
+		return strings.EqualFold(left, right)
+	}
+	return left == right
+}
+
+// aiInstallSourceImmutabilityEqual compares two platform observations exactly,
+// including the optional shebang interpreter.
+func aiInstallSourceImmutabilityEqual(left, right AIInstallSourceImmutability) bool {
+	if (left.Windows == nil) != (right.Windows == nil) {
+		return false
+	}
+	if left.Windows != nil && *left.Windows != *right.Windows {
+		return false
+	}
+	if (left.Linux == nil) != (right.Linux == nil) {
+		return false
+	}
+	if left.Linux == nil {
+		return true
+	}
+	if left.Linux.UnwritablePath != right.Linux.UnwritablePath ||
+		left.Linux.OwnershipEvidenceHash != right.Linux.OwnershipEvidenceHash {
+		return false
+	}
+	if (left.Linux.Interpreter == nil) != (right.Linux.Interpreter == nil) {
+		return false
+	}
+	if left.Linux.Interpreter != nil && !aiInstallSourceInterpreterEqual(left.Linux.Interpreter, right.Linux.Interpreter) {
+		return false
+	}
+	return true
+}
+
+// aiInstallSourceInterpreterEqual compares two interpreter chains level by level.
+// The struct is compared field by field rather than with == because the nested
+// pointer makes it non-comparable; a chain of different depth is a difference, so
+// an inner level can never be dropped from the comparison (P85 F07).
+func aiInstallSourceInterpreterEqual(left, right *AIInstallSourceInterpreter) bool {
+	if left == nil || right == nil {
+		return left == nil && right == nil
+	}
+	if left.Path != right.Path || left.Hash != right.Hash || left.FileID != right.FileID {
+		return false
+	}
+	return aiInstallSourceInterpreterEqual(left.Interpreter, right.Interpreter)
+}
diff --git a/internal/adapters/ai_install_proof_unix.go b/internal/adapters/ai_install_proof_unix.go
new file mode 100644
index 0000000..3bfde15
--- /dev/null
+++ b/internal/adapters/ai_install_proof_unix.go
@@ -0,0 +1,621 @@
+//go:build linux
+
+package adapters
+
+// T3 (finding F6), Linux half: the install source is immutable when EVERY
+// component of the executable's absolute path (the installation directory
+// included) and of its interpreter is non-writable by the executing user AND not
+// owned by that user, and the executable object itself satisfies the same rule.
+//
+// Two facts are needed and neither alone is enough: "not writable" rejects an
+// in-place rewrite of the bytes (which keeps the inode, so the identity check in
+// requireSameExecutableFile cannot see it), and "not owned by this user" rejects a
+// chmod-in-progress that would restore write access. Ownership is therefore
+// required to be root or a foreign user, exactly as the contract states.
+//
+// P85 additions to the same walk:
+//   - F06: every component is inspected with os.Lstat, so a symbolic link in the
+//     NAME chain is refused instead of being followed to its target; the leaf
+//     itself is opened through a bound directory handle with O_NOFOLLOW, and the
+//     identity, digest and shebang/ELF header all come from that one handle.
+//   - F08: "writable" is the EFFECTIVE permission of the executing user (owner,
+//     other-write, or group-write for a group the user belongs to), not "some
+//     subject carries a write bit": a 0775 root:root directory on a host where
+//     this user is not in the group is not writable by this user.
+//   - F07: an "/usr/bin/env" shebang is refused (the interpreter it picks depends
+//     on the executing PATH, which the rule does not cover), the shebang chain is
+//     verified recursively up to a fixed depth, and a dynamic ELF's PT_INTERP
+//     loader is verified exactly like a shebang interpreter.
+//
+// P85 final-review additions (this round):
+//   - F06: the leaf's mode and ownership are read from the BOUND HANDLE (Identity
+//     and Owner), not from a second Lstat of the name, so path, mode, owner,
+//     digest, identity and header are one observation of one object.
+//   - F07: the interpreter's ORIGINAL name chain is what gets proven. There is no
+//     EvalSymlinks that resolves the name and then checks only the target: the
+//     chain is bound with openat2 RESOLVE_NO_SYMLINKS, so a link in any component
+//     is refused instead of being followed, and the kernel-shebang split is
+//     reproduced byte for byte (space and tab only, never strings.Fields).
+//   - F07: every recursively verified interpreter level is recorded in the carrier
+//     (AIInstallSourceInterpreter.Interpreter), so the inner identity is no longer
+//     checked and then discarded.
+//   - F08: an object that carries a POSIX access ACL is refused (fail-closed): a
+//     mode/owner rule cannot exclude a named ACL grant, so it must not claim "this
+//     user cannot write it".
+//   - F07 (fix round 3): the name chain is proven in its ORIGINAL spelling. Every
+//     path this file walks (the executable and every interpreter level) must
+//     already be canonical - ".", "..", doubled separators and a trailing
+//     separator are refused before anything is opened - and the shebang line is
+//     parsed out of the kernel's own 256-byte window, which includes the "#!"
+//     prefix, instead of the length of the remainder after it.
+//
+// Linux is the only supported Unix target. Every other Unix - darwin included -
+// is compiled through ai_install_proof_unsupported.go and returns "cannot prove"
+// instead of inventing an equivalent rule, so the probe fails closed there.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"slices"
+	"strings"
+	"syscall"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+const (
+	// aiInstallSourceOwnershipDomain is the digest domain of the Unix ownership
+	// evidence recorded in the carrier. Declared here, not in the shared file,
+	// because only the Unix half produces and consumes it.
+	aiInstallSourceOwnershipDomain = "proofrail:ai-install-source-ownership:1\n"
+	// aiInstallSourceInterpreterDomain is the digest domain of the interpreter
+	// evidence recorded in the carrier. Declared here for the same reason as the
+	// ownership domain.
+	aiInstallSourceInterpreterDomain = "proofrail:ai-install-source-interpreter:1\n"
+)
+
+// installSourceShebangHeaderLength bounds the bytes inspected for a shebang and for
+// the PT_INTERP entry of an ELF object. The kernel limits an interpreter line to a
+// few hundred bytes; reading more would only describe a line the kernel will not use.
+const installSourceShebangHeaderLength int64 = 4096
+
+// installSourceInterpreterDepthLimit bounds the recursive shebang chain. The kernel
+// has no such limit, so the depth cap is a fail-closed decision: a chain deeper than
+// this cannot be proven from here and is refused (registered as a residual).
+const installSourceInterpreterDepthLimit = 4
+
+// installSourceShebangWindow is BINPRM_BUF_SIZE. The kernel copies at most this
+// many bytes of the script - including the two bytes of "#!" - into its own
+// buffer and parses the interpreter out of THAT window, so this rule inspects the
+// same window: anything beyond it is a line the kernel will never look at.
+const installSourceShebangWindow = 256
+
+// installSourceELFMagic is the first four bytes of an ELF object.
+const installSourceELFMagic = "\x7fELF"
+
+// verifyInstallSourceImmutability observes the executable's path components and,
+// when it is a script or a dynamic ELF, its interpreter. leaf is the ONE handle the
+// executable was opened through; every header-based fact is taken from it.
+func verifyInstallSourceImmutability(executable string, leaf *evidence.BoundFile) (AIInstallSourceImmutability, error) {
+	// Second line of defence: the file is only compiled for linux, but a future
+	// refactor that moves it must still refuse instead of inventing a rule.
+	if runtime.GOOS != "linux" {
+		return AIInstallSourceImmutability{}, fmt.Errorf("%w: %s has no install source rule, so immutability cannot be proven",
+			ErrAIInstallSourceProof, runtime.GOOS)
+	}
+	path := executable
+	if err := installSourceRequireCanonicalSpelling(path); err != nil {
+		return AIInstallSourceImmutability{}, err
+	}
+	// The superuser can rewrite any path regardless of mode and ownership, so the
+	// same three-component rule cannot prove anything for it.
+	if os.Geteuid() == 0 {
+		return AIInstallSourceImmutability{}, fmt.Errorf("%w: the root user can write every path, so %q cannot be proven immutable",
+			ErrAIInstallSourceProof, path)
+	}
+	ownershipEvidence, err := verifyUnwritableInstallPathAgainstLeaf(path, leaf)
+	if err != nil {
+		return AIInstallSourceImmutability{}, err
+	}
+	interpreter, err := installSourceInterpreterFromBound(leaf, path, 0)
+	if err != nil {
+		return AIInstallSourceImmutability{}, err
+	}
+	return AIInstallSourceImmutability{Linux: &AIInstallSourceLinuxFacts{
+		UnwritablePath:        true,
+		OwnershipEvidenceHash: ownershipEvidence,
+		Interpreter:           interpreter,
+	}}, nil
+}
+
+// verifyUnwritableInstallPath proves every component of one absolute path (the root
+// slash included, the final object included) is non-writable by this user and not
+// owned by this user. It returns the domain digest of the observed facts, which is
+// what the carrier records.
+//
+// P85 F06: os.Lstat, not os.Stat - a component that is a symbolic link is refused,
+// because the NAME chain is what the kernel walks and the link target is not the
+// object the rule would then describe.
+//
+// The path-only form opens the leaf itself (link-free) so it describes the same
+// object the handle-based walk describes; production callers already hold the leaf
+// handle and use verifyUnwritableInstallPathAgainstLeaf directly.
+func verifyUnwritableInstallPath(path string) (string, error) {
+	leaf, err := openInstallSourceLeaf(path)
+	if err != nil {
+		return "", err
+	}
+	defer func() { _ = leaf.Close() }()
+	return verifyUnwritableInstallPathAgainstLeaf(path, leaf)
+}
+
+// verifyUnwritableInstallPathAgainstLeaf is the bound form: every ancestor is
+// inspected by name (a link component is refused), and the LEAF is described by
+// the handle the caller already read the digest and header from (P85 F06), so the
+// permissions that are recorded cannot belong to a different object than the bytes
+// that are recorded.
+func verifyUnwritableInstallPathAgainstLeaf(path string, leaf *evidence.BoundFile) (string, error) {
+	if leaf == nil {
+		return "", fmt.Errorf("%w: %q has no bound handle, so its permissions cannot be observed", ErrAIInstallSourceProof, path)
+	}
+	components, err := installSourcePathComponents(path)
+	if err != nil {
+		return "", err
+	}
+	if len(components) == 0 {
+		return "", fmt.Errorf("%w: %q has no path components", ErrAIInstallSourceProof, path)
+	}
+	observed := make([]string, 0, len(components))
+	for index, component := range components {
+		if index == len(components)-1 {
+			// The leaf: mode and owner come from the bound handle's own stat.
+			_, _, mode := leaf.Identity()
+			uid, gid, ok := leaf.Owner()
+			if !ok {
+				return "", fmt.Errorf("%w: %q carries no ownership information on its bound handle", ErrAIInstallSourceProof, component)
+			}
+			if err := installSourceDenyAccessACLHandle(leaf, component); err != nil {
+				return "", err
+			}
+			if err := installSourceEffectiveWritability(component, mode, uid, gid); err != nil {
+				return "", err
+			}
+			observed = append(observed, fmt.Sprintf("%s:%04o:%d:%d", component, mode.Perm(), uid, gid))
+			continue
+		}
+		info, err := os.Lstat(component)
+		if err != nil {
+			return "", fmt.Errorf("%w: lstat %q: %v", ErrAIInstallSourceProof, component, err)
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return "", fmt.Errorf("%w: %q is a symbolic link, so the name chain cannot be proven", ErrAIInstallSourceProof, component)
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok {
+			return "", fmt.Errorf("%w: %q carries no ownership information", ErrAIInstallSourceProof, component)
+		}
+		if err := installSourceDenyAccessACLPath(component); err != nil {
+			return "", err
+		}
+		if err := installSourceEffectiveWritability(component, info.Mode(), int(stat.Uid), int(stat.Gid)); err != nil {
+			return "", err
+		}
+		observed = append(observed, fmt.Sprintf("%s:%04o:%d:%d", component, info.Mode().Perm(), stat.Uid, stat.Gid))
+	}
+	return evidence.Digest(aiInstallSourceOwnershipDomain, []byte(strings.Join(observed, "\n"))), nil
+}
+
+// installSourceDenyAccessACLPath refuses an ancestor that carries a POSIX access
+// ACL (P85 F08). A named ACL entry can grant this user write access that the
+// mode/owner rule never sees, so an object whose ACL cannot be excluded from the
+// verdict is not provable by that verdict.
+func installSourceDenyAccessACLPath(component string) error {
+	present, err := evidence.AccessACLPath(component)
+	if err != nil {
+		return fmt.Errorf("%w: the access ACL of %q cannot be read: %v", ErrAIInstallSourceProof, component, err)
+	}
+	if present {
+		return fmt.Errorf("%w: %q carries a POSIX access ACL, so a named grant to this user cannot be excluded", ErrAIInstallSourceProof, component)
+	}
+	return nil
+}
+
+// installSourceDenyAccessACLHandle is the leaf form: the ACL is read from the same
+// bound object the digest and identity come from (P85 F06/F08).
+func installSourceDenyAccessACLHandle(leaf *evidence.BoundFile, component string) error {
+	present, err := leaf.AccessACL()
+	if err != nil {
+		return fmt.Errorf("%w: the access ACL of %q cannot be read on its bound handle: %v", ErrAIInstallSourceProof, component, err)
+	}
+	if present {
+		return fmt.Errorf("%w: %q carries a POSIX access ACL, so a named grant to this user cannot be excluded", ErrAIInstallSourceProof, component)
+	}
+	return nil
+}
+
+// installSourceEffectiveWritability refuses one component that the EXECUTING user
+// can make writable (P85 F08):
+//
+//   - the user owns it: an owner restores any permission with chmod, so the mode
+//     bits do not matter;
+//   - it is other-writable: every user writes it directly;
+//   - it is group-writable AND the user is in that group (effective gid or the
+//     supplementary groups): a group member writes it directly.
+//
+// The owner write bit is deliberately NOT a separate criterion: when the owner is
+// this user the first rule already refuses, and when the owner is someone else the
+// owner bit grants this user nothing. Judging "any subject carries a write bit"
+// refused a 0775 root:root path that this user cannot write at all.
+//
+// This is a mode/ownership rule, not a revocation of an already-open write handle by
+// the same OS user: that case is outside the S1 threat model (SECURITY.md) and is
+// registered, never claimed. Named POSIX ACL grants are excluded separately, by
+// refusing any component that carries an access ACL (installSourceDenyAccessACL*).
+func installSourceEffectiveWritability(component string, mode os.FileMode, uid, gid int) error {
+	euid := os.Geteuid()
+	if uid == euid {
+		return fmt.Errorf("%w: %q is owned by the executing user (mode %04o, owner %d), so the mode bits can be restored",
+			ErrAIInstallSourceProof, component, mode.Perm(), uid)
+	}
+	if mode.Perm()&0o002 != 0 {
+		return fmt.Errorf("%w: %q is writable by every user (mode %04o)", ErrAIInstallSourceProof, component, mode.Perm())
+	}
+	if mode.Perm()&0o020 == 0 {
+		return nil
+	}
+	inGroup, err := installSourceEuidInGroup(gid)
+	if err != nil {
+		return fmt.Errorf("%w: %q carries a group write bit and the executing user's groups cannot be read: %v",
+			ErrAIInstallSourceProof, component, err)
+	}
+	if inGroup {
+		return fmt.Errorf("%w: %q grants write access to group %d, which the executing user belongs to (mode %04o)",
+			ErrAIInstallSourceProof, component, gid, mode.Perm())
+	}
+	return nil
+}
+
+// installSourceEuidInGroup reports whether the effective user is a member of gid,
+// through the effective group id or the supplementary groups. An unreadable group
+// list is an error, never "not a member": the verdict has to be fail-closed.
+func installSourceEuidInGroup(gid int) (bool, error) {
+	if gid == os.Getegid() || gid == syscall.Getegid() {
+		return true, nil
+	}
+	groups, err := syscall.Getgroups()
+	if err != nil {
+		return false, err
+	}
+	return slices.Contains(groups, gid), nil
+}
+
+// installSourcePathComponents walks one absolute path from the filesystem root down
+// to the object itself, so a writable ancestor cannot hide behind a clean leaf.
+//
+// P85 F07 (fix round 3): the components come from the ORIGINAL spelling, and the
+// spelling is required to be canonical first. The previous form cleaned the path
+// and walked the cleaned form, so a chain carrying ".." or a doubled separator was
+// proven as its folded spelling while the kernel walked the chain that was written.
+// On a canonical spelling filepath.Join is an identity for one component, so the
+// walk describes exactly the bytes that were named.
+func installSourcePathComponents(path string) ([]string, error) {
+	if err := installSourceRequireCanonicalSpelling(path); err != nil {
+		return nil, err
+	}
+	separator := string(filepath.Separator)
+	if path == separator {
+		// The root itself: one component, the only spelling with a trailing
+		// separator that is canonical.
+		return []string{separator}, nil
+	}
+	components := []string{separator}
+	current := separator
+	for _, part := range strings.Split(strings.TrimPrefix(path, separator), separator) {
+		if part == "" {
+			// Unreachable on a canonical spelling; refuse rather than skip, because
+			// skipping would drop a component from the proof.
+			return nil, fmt.Errorf("%w: %q carries an empty component, so its components cannot be proven", ErrAIInstallSourceProof, path)
+		}
+		current = filepath.Join(current, part)
+		components = append(components, current)
+	}
+	return components, nil
+}
+
+// installSourceInterpreter returns the interpreter identity when the executable is
+// a script or a dynamic ELF, and nil when it is a static ELF object. It is the thin
+// wrapper kept for tests and for callers that only have a path; the production path
+// goes through installSourceInterpreterFromBound so the header and the identity come
+// from the SAME handle the digest came from (P85 F06).
+func installSourceInterpreter(path string) (*AIInstallSourceInterpreter, error) {
+	bound, err := openInstallSourceLeaf(path)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = bound.Close() }()
+	return installSourceInterpreterFromBound(bound, path, 0)
+}
+
+// installSourceInterpreterFromBound classifies one already-bound executable from its
+// own bytes and returns the interpreter the kernel would re-resolve at exec time:
+//
+//   - "#!" script: the shebang interpreter (an env form is refused, see below);
+//   - ELF object: the PT_INTERP loader of a dynamic object, nil for a static one;
+//   - anything else: refused, because no rule this adapter can observe would exec it.
+//
+// depth counts the shebang chain already verified; an interpreter that is itself a
+// script is verified one level deeper (the kernel re-resolves that chain too), up to
+// installSourceInterpreterDepthLimit.
+func installSourceInterpreterFromBound(bound *evidence.BoundFile, path string, depth int) (*AIInstallSourceInterpreter, error) {
+	if bound == nil {
+		return nil, fmt.Errorf("%w: %q has no bound handle, so its interpreter cannot be observed", ErrAIInstallSourceProof, path)
+	}
+	if depth > installSourceInterpreterDepthLimit {
+		return nil, fmt.Errorf("%w: the interpreter chain of %q is deeper than %d levels", ErrAIInstallSourceProof, path, installSourceInterpreterDepthLimit)
+	}
+	data, truncated, err := bound.ReadAll()
+	if err != nil {
+		return nil, fmt.Errorf("%w: read %q: %v", ErrAIInstallSourceProof, path, err)
+	}
+	if truncated {
+		// A partial object cannot describe the header the kernel would read: refuse
+		// instead of parsing a prefix.
+		return nil, fmt.Errorf("%w: %q exceeds the bound used to inspect it", ErrAIInstallSourceProof, path)
+	}
+	if len(data) < 4 {
+		// Too short to carry either header: no shebang and no ELF magic, so how the
+		// kernel would exec this file cannot be observed. Fail closed.
+		return nil, fmt.Errorf("%w: %q carries neither an ELF header nor a shebang", ErrAIInstallSourceProof, path)
+	}
+	if string(data[:4]) == installSourceELFMagic {
+		loader, err := installSourceELFInterpreter(data, path)
+		if err != nil {
+			return nil, err
+		}
+		if loader == "" {
+			// A static ELF object is exec'd directly; the path and ownership checks
+			// already cover the object itself.
+			return nil, nil
+		}
+		return installSourceVerifyInterpreter(loader, path, depth)
+	}
+	if data[0] != '#' || data[1] != '!' {
+		// The contract proves a probe executable either as an ELF object or through a
+		// shebang interpreter that satisfies the same immutability rule. A file with
+		// neither property is exec'd by no rule this adapter can observe, so it must
+		// not be treated as runnable: refuse it instead of assuming.
+		return nil, fmt.Errorf("%w: %q is neither an ELF object nor a shebang script", ErrAIInstallSourceProof, path)
+	}
+	return installSourceShebangInterpreter(data, path, depth)
+}
+
+// installSourceShebangInterpreter parses the shebang line the way the kernel does
+// and resolves the interpreter it names.
+//
+// P85 F07: the split is the kernel's, not strings.Fields'. binfmt_script skips
+// leading spaces and tabs, takes every byte up to the next space or tab as the
+// interpreter, and keeps the rest of the line as ONE optional argument. It never
+// tokenizes on \v, \f or a non-ASCII space - and strings.Fields does, so a path that
+// carried one of those bytes used to be truncated to a prefix the kernel would
+// never exec, and that prefix could be a different, acceptable object.
+//
+// P85 F07: an "/usr/bin/env" interpreter is REFUSED. The kernel execs env, and env
+// then resolves the real interpreter through the executing PATH, which this rule
+// does not cover; re-implementing env's option and PATH semantics would drift from
+// the kernel and reopen the same hole. The shipped probe is an ELF object, so the
+// only thing refused here is an unusual external layout.
+// P85 F07 (fix round 3): the limit is the kernel's own WINDOW, counted over the
+// bytes the kernel buffers - "#!" included - not the length of the remainder after
+// the two magic bytes. The interpreter is parsed out of the first
+// installSourceShebangWindow bytes of the file only: a line whose terminating
+// newline does not fall inside that window is a line the kernel never terminates,
+// so the object it would exec cannot be described from here and is refused.
+func installSourceShebangInterpreter(data []byte, path string, depth int) (*AIInstallSourceInterpreter, error) {
+	if len(data) < 2 || data[0] != '#' || data[1] != '!' {
+		return nil, fmt.Errorf("%w: %q does not open with a shebang", ErrAIInstallSourceProof, path)
+	}
+	window := data
+	if len(window) > installSourceShebangWindow {
+		window = window[:installSourceShebangWindow]
+	}
+	// The newline has to be INSIDE the window (file offset <= 255). A window with no
+	// newline is a shebang the kernel would parse as a truncated line - the object
+	// that runs would be the prefix, which this rule cannot describe.
+	newline := bytes.IndexByte(window, '\n')
+	if newline < 0 {
+		return nil, fmt.Errorf("%w: the shebang of %q carries no newline within the kernel's %d-byte window, so what the kernel would execute cannot be proven",
+			ErrAIInstallSourceProof, path, installSourceShebangWindow)
+	}
+	// window[2:newline] is the interpreter line WITHOUT the "#!" prefix: newline <= 255
+	// bounds it at 253 bytes, exactly what the kernel keeps of it.
+	line := window[2:newline]
+	// Kernel rule: leading spaces and tabs only.
+	specification := strings.TrimLeft(string(line), " \t")
+	if specification == "" {
+		return nil, fmt.Errorf("%w: %q carries an empty shebang", ErrAIInstallSourceProof, path)
+	}
+	interpreterPath := specification
+	if index := strings.IndexAny(specification, " \t"); index >= 0 {
+		// The remainder is the kernel's single optional argument (trailing blanks
+		// trimmed). It is passed verbatim to the interpreter, never a second path,
+		// so it does not change which object is exec'd.
+		interpreterPath = specification[:index]
+	}
+	if interpreterPath == "" {
+		return nil, fmt.Errorf("%w: %q carries an empty shebang interpreter", ErrAIInstallSourceProof, path)
+	}
+	if filepath.Base(interpreterPath) == "env" {
+		return nil, fmt.Errorf("%w: %q delegates to env, whose interpreter depends on the executing PATH and cannot be proven",
+			ErrAIInstallSourceProof, path)
+	}
+	if !filepath.IsAbs(interpreterPath) {
+		return nil, fmt.Errorf("%w: the shebang interpreter %q of %q is not an absolute path",
+			ErrAIInstallSourceProof, interpreterPath, path)
+	}
+	return installSourceVerifyInterpreter(interpreterPath, path, depth)
+}
+
+// installSourceVerifyInterpreter proves one interpreter: the ORIGINAL name chain is
+// bound link-free from the filesystem root, every component of that chain is
+// unwritable by this user, the leaf's identity, digest, permissions and ACL all come
+// from that one handle, and (when the interpreter is itself a script or a dynamic
+// object) its own interpreter is verified one level deeper and RECORDED.
+//
+// P85 F07 removed the EvalSymlinks step this function used to start with. Resolving
+// the name and then checking only the resolved target described an object the kernel
+// would reach through a chain this rule never inspected, so rewriting a link
+// component silently changed what ran while the recorded target stayed provable.
+// The kernel walks the ORIGINAL chain, so that chain is what has to be proven:
+// openat2 with RESOLVE_NO_SYMLINKS refuses a link at any component, and when the
+// chain carries no link the original spelling IS the real chain (there is nothing
+// left for a resolver to change), which is why Path records the original spelling
+// rather than a post-resolution target.
+//
+// Refusing a linked layout is the fail-closed branch the review allows: a chain this
+// rule cannot describe is not admitted. It is a real behaviour change on hosts whose
+// PT_INTERP or /bin/sh lives behind a link (merged-/usr distributions), where a
+// dynamic object now refuses instead of being proven through its link target.
+func installSourceVerifyInterpreter(interpreterPath, path string, depth int) (*AIInstallSourceInterpreter, error) {
+	// P85 F07 (fix round 3): the interpreter's ORIGINAL spelling is validated before
+	// anything is bound. A shebang or PT_INTERP entry that carries "..", ".", a
+	// doubled separator or a trailing separator names a chain the kernel walks
+	// literally and this rule would otherwise fold away, so it is refused whole.
+	if err := installSourceRequireCanonicalSpelling(interpreterPath); err != nil {
+		return nil, fmt.Errorf("%w: the interpreter %q of %q: %v", ErrAIInstallSourceProof, interpreterPath, path, err)
+	}
+	if !filepath.IsAbs(interpreterPath) {
+		return nil, fmt.Errorf("%w: the interpreter %q of %q is not an absolute path",
+			ErrAIInstallSourceProof, interpreterPath, path)
+	}
+	bound, err := openInstallSourceLeaf(interpreterPath)
+	if err != nil {
+		return nil, fmt.Errorf("%w: the interpreter %q of %q cannot be opened without following a symbolic link: %v",
+			ErrAIInstallSourceProof, interpreterPath, path, err)
+	}
+	defer func() { _ = bound.Close() }()
+	if _, err := verifyUnwritableInstallPathAgainstLeaf(interpreterPath, bound); err != nil {
+		return nil, err
+	}
+	fileID, err := bound.FileID()
+	if err != nil {
+		return nil, fmt.Errorf("%w: identify the interpreter %q: %v", ErrAIInstallSourceProof, interpreterPath, err)
+	}
+	digest, err := bound.Hash(aiInstallSourceInterpreterDomain)
+	if err != nil {
+		return nil, fmt.Errorf("%w: digest the interpreter %q: %v", ErrAIInstallSourceProof, interpreterPath, err)
+	}
+	// P85 F07: the inner level is not just checked, it is RECORDED. The carrier has
+	// to describe every interpreter the kernel will exec in turn, otherwise the
+	// inner identity is verified and then dropped.
+	inner, err := installSourceInterpreterFromBound(bound, interpreterPath, depth+1)
+	if err != nil {
+		return nil, err
+	}
+	return &AIInstallSourceInterpreter{Path: interpreterPath, Hash: digest, FileID: fileID, Interpreter: inner}, nil
+}
+
+// installSourceELFInterpreter reads the PT_INTERP program header of one ELF object
+// from the bytes of the SAME handle the digest came from (P85 F07). It returns the
+// absolute loader path, "" for a static object (no PT_INTERP), and an error for any
+// malformed header: every offset and size is range-checked before it is used, so a
+// crafted header is a refusal and never an out-of-range read.
+func installSourceELFInterpreter(data []byte, path string) (string, error) {
+	const (
+		elfClass32             = 1
+		elfClass64             = 2
+		elfDataLSB             = 1
+		elfDataMSB             = 2
+		elfProgramHeaderInterp = 3
+	)
+	malformed := func(detail string) (string, error) {
+		return "", fmt.Errorf("%w: the ELF header of %q is malformed (%s)", ErrAIInstallSourceProof, path, detail)
+	}
+	if len(data) < 16 {
+		return malformed("truncated identification")
+	}
+	var order binary.ByteOrder
+	switch data[5] {
+	case elfDataLSB:
+		order = binary.LittleEndian
+	case elfDataMSB:
+		order = binary.BigEndian
+	default:
+		return malformed("unknown data encoding")
+	}
+	class := data[4]
+	var programOffset uint64
+	var entrySize, entryCount uint16
+	switch class {
+	case elfClass64:
+		if len(data) < 64 {
+			return malformed("truncated 64-bit header")
+		}
+		programOffset = order.Uint64(data[32:40])
+		entrySize = order.Uint16(data[54:56])
+		entryCount = order.Uint16(data[56:58])
+	case elfClass32:
+		if len(data) < 52 {
+			return malformed("truncated 32-bit header")
+		}
+		programOffset = uint64(order.Uint32(data[28:32]))
+		entrySize = order.Uint16(data[42:44])
+		entryCount = order.Uint16(data[44:46])
+	default:
+		return malformed("unknown class")
+	}
+	if entryCount == 0 {
+		return "", nil
+	}
+	if entrySize == 0 || programOffset > uint64(len(data)) {
+		return malformed("program header table outside the object")
+	}
+	for index := 0; index < int(entryCount); index++ {
+		offset := programOffset + uint64(index)*uint64(entrySize)
+		if offset > uint64(len(data)) || uint64(entrySize) > uint64(len(data))-offset {
+			return malformed("program header entry outside the object")
+		}
+		entry := data[offset : offset+uint64(entrySize)]
+		var kind uint32
+		var fileOffset, fileSize uint64
+		if class == elfClass64 {
+			if entrySize < 56 {
+				return malformed("short 64-bit program header entry")
+			}
+			kind = order.Uint32(entry[0:4])
+			fileOffset = order.Uint64(entry[8:16])
+			fileSize = order.Uint64(entry[32:40])
+		} else {
+			if entrySize < 32 {
+				return malformed("short 32-bit program header entry")
+			}
+			kind = order.Uint32(entry[0:4])
+			fileOffset = uint64(order.Uint32(entry[4:8]))
+			fileSize = uint64(order.Uint32(entry[16:20]))
+		}
+		if kind != elfProgramHeaderInterp {
+			continue
+		}
+		if fileSize == 0 || fileSize > uint64(installSourceShebangHeaderLength) {
+			return malformed("implausible PT_INTERP length")
+		}
+		if fileOffset > uint64(len(data)) || fileSize > uint64(len(data))-fileOffset {
+			return malformed("PT_INTERP path outside the object")
+		}
+		raw := data[fileOffset : fileOffset+fileSize]
+		end := bytes.IndexByte(raw, 0)
+		if end <= 0 {
+			return malformed("unterminated PT_INTERP path")
+		}
+		interpreter := string(raw[:end])
+		if !filepath.IsAbs(interpreter) {
+			return "", fmt.Errorf("%w: the PT_INTERP loader %q of %q is not an absolute path",
+				ErrAIInstallSourceProof, interpreter, path)
+		}
+		return interpreter, nil
+	}
+	return "", nil
+}
diff --git a/internal/adapters/ai_install_proof_unsupported.go b/internal/adapters/ai_install_proof_unsupported.go
new file mode 100644
index 0000000..670b125
--- /dev/null
+++ b/internal/adapters/ai_install_proof_unsupported.go
@@ -0,0 +1,31 @@
+//go:build !windows && !linux
+
+package adapters
+
+// P85 F21, platform stub: the install source rule is implemented for Windows and
+// Linux only. Every other Unix - darwin included - refuses instead of inventing an
+// equivalent rule: a probe on a platform whose immutability rule is unknown must
+// fail closed, not fall back to "assume immutable".
+//
+// The two symbols below are the ones the shared files and the platform-tagged tests
+// reference, so an unsupported host still compiles and every entry point refuses at
+// run time.
+
+import (
+	"fmt"
+	"runtime"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// verifyInstallSourceImmutability always refuses on an unsupported platform.
+func verifyInstallSourceImmutability(executable string, leaf *evidence.BoundFile) (AIInstallSourceImmutability, error) {
+	return AIInstallSourceImmutability{}, fmt.Errorf("%w: %s has no install source rule, so %q cannot be proven immutable",
+		ErrAIInstallSourceProof, runtime.GOOS, executable)
+}
+
+// installSourceInterpreter always refuses on an unsupported platform.
+func installSourceInterpreter(path string) (*AIInstallSourceInterpreter, error) {
+	return nil, fmt.Errorf("%w: %s has no interpreter rule, so %q cannot be proven",
+		ErrAIInstallSourceProof, runtime.GOOS, path)
+}
diff --git a/internal/adapters/ai_install_proof_windows.go b/internal/adapters/ai_install_proof_windows.go
new file mode 100644
index 0000000..f2a448b
--- /dev/null
+++ b/internal/adapters/ai_install_proof_windows.go
@@ -0,0 +1,410 @@
+//go:build windows
+
+package adapters
+
+// T3 (finding F6), Windows half: the install source is immutable when this user's
+// token cannot obtain write, append, delete, delete-child or permission-changing
+// access to the executable, to its installation directory, AND to every ancestor
+// directory up to the volume root, and when no component of the name chain is a
+// reparse point.
+//
+// The verdict is taken from the OS itself: one CreateFile per RIGHT PER OBJECT asks
+// for exactly that single mutation right, and a refusal (ERROR_ACCESS_DENIED) is the
+// proof we want, while a granted handle - closed immediately, nothing is written -
+// means the source is mutable. The DACL is additionally fingerprinted through
+// GetNamedSecurityInfoW so the carrier records WHICH security descriptor was
+// observed, and a later change of that descriptor is visible as a changed fact.
+//
+// P85 F03: the earlier form asked for all mutation rights in ONE access check, and a
+// single ERROR_ACCESS_DENIED only proved "not all rights at once". An ACL that grants
+// just WRITE_OWNER (or just DELETE) was therefore reported as immutable. The rights
+// are now enumerated one at a time (see installSourceFileMutationRights /
+// installSourceDirectoryMutationRights) so any single granted right refuses.
+//
+// P85 F04: the observed chain is the FULL ancestor chain, not just the direct parent.
+// The volume root is part of the chain but is anchored by IDENTITY (the P84 proof
+// that the bound handle is the root of a fixed local NTFS volume) instead of by
+// mutation rights - excluding it would miss "a token that may delete or re-permission
+// the drive root replaces the first-level ancestor".
+//
+// The verdict deliberately does NOT come from GetEffectiveRightsFromAclW: that
+// function does not resolve CREATOR OWNER correctly and reports GENERIC_ALL for an
+// inherited CREATOR OWNER ace, which nearly every Windows directory carries. It
+// would therefore refuse every legitimate install under %ProgramFiles% as
+// "writable". Asking the same access check the OS will run for the actual token is
+// both stronger and cheaper than reimplementing ACE semantics here. Every outcome
+// that is neither "granted" nor "ACCESS_DENIED" is a refusal (fail-closed), never
+// "assume immutable".
+//
+// Every errno is read directly from the Go syscall result (errors.Is on
+// syscall.ERROR_ACCESS_DENIED). No site re-derives a Windows error from a
+// translated/last-error value across a language or library boundary: a translated
+// errno is exactly how a "denied" can silently arrive as "granted".
+//
+// No third-party dependency: GetNamedSecurityInfoW, GetSecurityDescriptorLength
+// and LocalFree are declared here; the token and the access check come from the
+// standard syscall package.
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+const (
+	// aiInstallSourceACLDomain is the digest domain of the Windows ACL evidence
+	// recorded in the carrier. Declared here, not in the shared file, because only
+	// the Windows half produces and consumes it.
+	aiInstallSourceACLDomain = "proofrail:ai-install-source-acl:1\n"
+
+	// installSourceSEFileObject is SE_FILE_OBJECT: the security descriptor of a
+	// file or directory.
+	installSourceSEFileObject = 1
+	// installSourceDACLSecurityInformation asks for the DACL only; the descriptor
+	// fingerprint therefore covers the ACEs and not the owner or group.
+	installSourceDACLSecurityInformation = 0x00000004
+	// installSourceFileFlagOpenReparsePoint opens a reparse point AS ITSELF instead
+	// of following it, so the name chain can be classified (P85 F04).
+	installSourceFileFlagOpenReparsePoint = 0x00200000
+	// installSourceFileReadAttributes is FILE_READ_ATTRIBUTES, the least access that
+	// still answers "what kind of object is this name".
+	installSourceFileReadAttributes = 0x00000080
+)
+
+// P85 F03: the mutation rights are enumerated ONE BY ONE. A merged mask asked the
+// kernel "may I obtain all of these at once", and a denial of that single question
+// proved nothing about any individual right.
+//
+// File table (unchanged by the F04 ruling): writing content, appending, writing
+// extended attributes, writing attributes, deleting the object, changing the DACL,
+// changing the owner.
+var installSourceFileMutationRights = []uint32{
+	installSourceFileWriteData,       // 0x00000002 FILE_WRITE_DATA
+	installSourceFileAppendData,      // 0x00000004 FILE_APPEND_DATA
+	installSourceFileWriteEA,         // 0x00000010 FILE_WRITE_EA
+	installSourceFileWriteAttributes, // 0x00000100 FILE_WRITE_ATTRIBUTES
+	installSourceStandardDelete,      // 0x00010000 DELETE
+	installSourceStandardWriteDAC,    // 0x00040000 WRITE_DAC
+	installSourceStandardWriteOwner,  // 0x00080000 WRITE_OWNER
+}
+
+// Directory table: the full seven rights of the rev2 design (FILE_ADD_FILE,
+// FILE_ADD_SUBDIRECTORY, FILE_DELETE_CHILD, FILE_WRITE_ATTRIBUTES, DELETE,
+// WRITE_DAC, WRITE_OWNER). A non-root ancestor directory that lets the user
+// create a child CAN be swapped: create a sibling, delete the entry
+// (FILE_DELETE_CHILD) and rename the sibling into place. So creation rights
+// stay in the table for every directory EXCEPT the true volume root, which
+// the operating system reserves and cannot be renamed, swapped or deleted.
+var installSourceDirectoryMutationRights = []uint32{
+	installSourceFileWriteData,       // 0x00000002 FILE_ADD_FILE (directory spelling)
+	installSourceFileAppendData,      // 0x00000004 FILE_ADD_SUBDIRECTORY
+	installSourceFileDeleteChild,     // 0x00000040 FILE_DELETE_CHILD
+	installSourceFileWriteAttributes, // 0x00000100 FILE_WRITE_ATTRIBUTES
+	installSourceStandardDelete,      // 0x00010000 DELETE
+	installSourceStandardWriteDAC,    // 0x00040000 WRITE_DAC
+	installSourceStandardWriteOwner,  // 0x00080000 WRITE_OWNER
+}
+
+// Volume-root table: the directory table minus the two CREATION rights. The
+// operator's F04 ruling (2026-11-23, advisor-triggered, ① single-round) removes
+// FILE_ADD_FILE and FILE_ADD_SUBDIRECTORY ONLY for a volume root whose identity
+// is anchored by the P84 primitive (FileIndexLow==5). Measured on this host with
+// a NON-ELEVATED medium token: C:\ grants FILE_ADD_SUBDIRECTORY (the default
+// "Authenticated Users:(AD)" ace; "AD" is append-data/add-subdirectory, no
+// inheritance) while FILE_ADD_FILE and GENERIC_WRITE are ACCESS_DENIED. A
+// creation right on the reserved root says nothing about whether an EXISTING
+// object on the chain can be replaced, rewritten or deleted. When the identity
+// anchor FAILS, the root is judged by the full directory table instead - the
+// exclusion is a privilege, never an assumption.
+var installSourceVolumeRootMutationRights = []uint32{
+	installSourceFileDeleteChild,     // 0x00000040 FILE_DELETE_CHILD
+	installSourceFileWriteAttributes, // 0x00000100 FILE_WRITE_ATTRIBUTES
+	installSourceStandardDelete,      // 0x00010000 DELETE
+	installSourceStandardWriteDAC,    // 0x00040000 WRITE_DAC
+	installSourceStandardWriteOwner,  // 0x00080000 WRITE_OWNER
+}
+
+const (
+	installSourceFileWriteData       = 0x00000002
+	installSourceFileAppendData      = 0x00000004
+	installSourceFileWriteEA         = 0x00000010
+	installSourceFileDeleteChild     = 0x00000040
+	installSourceFileWriteAttributes = 0x00000100
+	installSourceStandardDelete      = 0x00010000
+	installSourceStandardWriteDAC    = 0x00040000
+	installSourceStandardWriteOwner  = 0x00080000
+)
+
+var (
+	installSourceKernel32 = syscall.NewLazyDLL("kernel32.dll")
+	installSourceAdvapi32 = syscall.NewLazyDLL("advapi32.dll")
+
+	procInstallSourceLocalFree                = installSourceKernel32.NewProc("LocalFree")
+	procInstallSourceGetNamedSecurityInfoW    = installSourceAdvapi32.NewProc("GetNamedSecurityInfoW")
+	procInstallSourceGetSecurityDescriptorLen = installSourceAdvapi32.NewProc("GetSecurityDescriptorLength")
+)
+
+// verifyInstallSourceImmutability observes the whole ancestor chain of the
+// executable for this user's token: every directory above the leaf is judged by its
+// per-right mutation grants, the volume root is anchored by identity, and the leaf
+// is judged by the file table. leaf is the handle the executable was opened through
+// (P85 F06); the Windows rule needs no fact from its bytes, so it is not read here.
+func verifyInstallSourceImmutability(executable string, leaf *evidence.BoundFile) (AIInstallSourceImmutability, error) {
+	_ = leaf
+	// P85 F07: the ORIGINAL spelling is judged. A path that is not already
+	// canonical names a chain the kernel walks literally and this rule would
+	// otherwise fold away ("\..", ".", doubled or trailing separators), so it is
+	// refused before any component is inspected.
+	path := executable
+	if err := installSourceRequireCanonicalSpelling(path); err != nil {
+		return AIInstallSourceImmutability{}, err
+	}
+	sidText, err := installSourceCurrentUserSIDText()
+	if err != nil {
+		return AIInstallSourceImmutability{}, err
+	}
+	components := installSourceWindowsComponents(path)
+	objectStates := make([]string, 0, len(components))
+	denies := true
+	for index, component := range components {
+		// P85 F04: a reparse point anywhere on the chain - junction above the install
+		// directory included - means the name the kernel walks is not the name that was
+		// judged. Refuse instead of following.
+		reparse, err := installSourceComponentIsReparse(component)
+		if err != nil {
+			return AIInstallSourceImmutability{}, err
+		}
+		if reparse {
+			return AIInstallSourceImmutability{}, fmt.Errorf("%w: %q on the install source chain is a reparse point",
+				ErrAIInstallSourceProof, component)
+		}
+		if index == 0 {
+			// Volume root: identity-anchored by the P84 primitive. The operator's
+			// F04 ruling removes the two creation rights ONLY for an anchored true
+			// volume root; an anchor failure falls back to the full directory
+			// table (fail-closed, the exclusion is never assumed).
+			anchored, err := installSourceAnchorsFixedVolumeRoot(component)
+			if err != nil {
+				return AIInstallSourceImmutability{}, err
+			}
+			rights := installSourceDirectoryMutationRights
+			anchorTag := "anchor:unproven"
+			if anchored {
+				rights = installSourceVolumeRootMutationRights
+				anchorTag = "anchor:fixed-volume"
+			}
+			granted, denied, err := installSourceMutationAccess(component, true, rights)
+			if err != nil {
+				return AIInstallSourceImmutability{}, err
+			}
+			descriptor, err := installSourceDescriptorDigest(component)
+			if err != nil {
+				return AIInstallSourceImmutability{}, err
+			}
+			objectStates = append(objectStates, fmt.Sprintf("%s|%s|denied:%s|dacl:%s",
+				component, anchorTag, installSourceRightsText(denied), descriptor))
+			if len(granted) > 0 {
+				denies = false
+				break
+			}
+			continue
+		}
+		isLeaf := index == len(components)-1
+		rights := installSourceDirectoryMutationRights
+		if isLeaf {
+			rights = installSourceFileMutationRights
+		}
+		granted, denied, err := installSourceMutationAccess(component, !isLeaf, rights)
+		if err != nil {
+			return AIInstallSourceImmutability{}, err
+		}
+		descriptor, err := installSourceDescriptorDigest(component)
+		if err != nil {
+			return AIInstallSourceImmutability{}, err
+		}
+		objectStates = append(objectStates, fmt.Sprintf("%s|denied:%s|dacl:%s",
+			component, installSourceRightsText(denied), descriptor))
+		if len(granted) > 0 {
+			denies = false
+			break
+		}
+	}
+	facts := AIInstallSourceImmutability{Windows: &AIInstallSourceWindowsFacts{
+		DirACLDeniesWriteDelete: denies,
+		ACLEvidenceHash: evidence.Digest(aiInstallSourceACLDomain, []byte(strings.ToLower(path)+"\n"+
+			"objects="+strings.Join(objectStates, ";")+"\n"+
+			"trustee="+sidText)),
+	}}
+	if !denies {
+		return facts, fmt.Errorf("%w: the install source %q grants this user a mutation right somewhere on its chain (see the recorded object states)",
+			ErrAIInstallSourceProof, path)
+	}
+	return facts, nil
+}
+
+// installSourceWindowsComponents splits one absolute Windows path into its chain
+// from the volume root down to the leaf: `C:\` first, the executable last.
+func installSourceWindowsComponents(path string) []string {
+	volume := filepath.VolumeName(path)
+	root := volume + string(filepath.Separator)
+	components := []string{root}
+	current := root
+	remainder := strings.TrimPrefix(path, root)
+	for _, part := range strings.Split(remainder, string(filepath.Separator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		components = append(components, current)
+	}
+	return components
+}
+
+// installSourceAnchorsFixedVolumeRoot proves, on a handle this call opens, that the
+// volume root name addresses the root directory of a fixed local NTFS volume. It
+// reuses the P84 handle-based anchor (evidence.BoundDir.IsFixedVolumeRoot) instead of
+// inventing a path-string rule.
+func installSourceAnchorsFixedVolumeRoot(root string) (bool, error) {
+	bound, err := evidence.OpenBoundDir(root)
+	if err != nil {
+		return false, fmt.Errorf("%w: bind the volume root %q: %v", ErrAIInstallSourceProof, root, err)
+	}
+	defer func() { _ = bound.Close() }()
+	return bound.IsFixedVolumeRoot(), nil
+}
+
+// installSourceComponentIsReparse classifies one name on the chain WITHOUT following
+// it: the object is opened as itself (FILE_FLAG_OPEN_REPARSE_POINT) and its
+// attributes are read from the handle. A directory, a file and a reparse point are
+// all openable this way; an object that cannot be opened at all is a refusal.
+func installSourceComponentIsReparse(name string) (bool, error) {
+	namePointer, err := syscall.UTF16PtrFromString(name)
+	if err != nil {
+		return false, fmt.Errorf("%w: encode the path %q: %v", ErrAIInstallSourceProof, name, err)
+	}
+	share := uint32(syscall.FILE_SHARE_READ | syscall.FILE_SHARE_WRITE | syscall.FILE_SHARE_DELETE)
+	attributes := uint32(syscall.FILE_FLAG_BACKUP_SEMANTICS | installSourceFileFlagOpenReparsePoint)
+	handle, err := syscall.CreateFile(namePointer, uint32(installSourceFileReadAttributes), share, nil, syscall.OPEN_EXISTING, attributes, 0)
+	if err != nil {
+		return false, fmt.Errorf("%w: classify %q: %v", ErrAIInstallSourceProof, name, err)
+	}
+	defer func() { _ = syscall.CloseHandle(handle) }()
+	var info syscall.ByHandleFileInformation
+	if err := syscall.GetFileInformationByHandle(handle, &info); err != nil {
+		return false, fmt.Errorf("%w: read the attributes of %q: %v", ErrAIInstallSourceProof, name, err)
+	}
+	return info.FileAttributes&syscall.FILE_ATTRIBUTE_REPARSE_POINT != 0, nil
+}
+
+// installSourceMutationAccess probes each right in the table with its OWN access
+// check and returns the granted and the denied rights, both in table order. A
+// granted handle is closed immediately and nothing is written, so the probe leaves
+// no footprint. Only ERROR_ACCESS_DENIED counts as a denial; every other failure is
+// "cannot tell" and therefore a refusal, never "assume denied".
+func installSourceMutationAccess(name string, directory bool, rights []uint32) ([]uint32, []uint32, error) {
+	namePointer, err := syscall.UTF16PtrFromString(name)
+	if err != nil {
+		return nil, nil, fmt.Errorf("%w: encode the path %q: %v", ErrAIInstallSourceProof, name, err)
+	}
+	share := uint32(syscall.FILE_SHARE_READ | syscall.FILE_SHARE_WRITE | syscall.FILE_SHARE_DELETE)
+	attributes := uint32(syscall.FILE_ATTRIBUTE_NORMAL)
+	if directory {
+		// A directory can only be opened with FILE_FLAG_BACKUP_SEMANTICS.
+		attributes = syscall.FILE_FLAG_BACKUP_SEMANTICS
+	}
+	granted := make([]uint32, 0, len(rights))
+	denied := make([]uint32, 0, len(rights))
+	for _, right := range rights {
+		handle, err := syscall.CreateFile(namePointer, right, share, nil, syscall.OPEN_EXISTING, attributes, 0)
+		if err == nil {
+			_ = syscall.CloseHandle(handle)
+			granted = append(granted, right)
+			continue
+		}
+		if errors.Is(err, syscall.ERROR_ACCESS_DENIED) {
+			denied = append(denied, right)
+			continue
+		}
+		return granted, denied, fmt.Errorf("%w: determine right 0x%08x of %q: %v", ErrAIInstallSourceProof, right, name, err)
+	}
+	return granted, denied, nil
+}
+
+// installSourceRightsText renders one rights vector in table order, so the carrier
+// evidence distinguishes WHICH rights were denied and not merely how many.
+func installSourceRightsText(rights []uint32) string {
+	parts := make([]string, 0, len(rights))
+	for _, right := range rights {
+		parts = append(parts, fmt.Sprintf("0x%08x", right))
+	}
+	return strings.Join(parts, ",")
+}
+
+// installSourceCurrentUserSIDText renders the invoking token's user SID. It is the
+// trustee the access check runs for, so it belongs in the recorded evidence.
+func installSourceCurrentUserSIDText() (string, error) {
+	process, err := syscall.GetCurrentProcess()
+	if err != nil {
+		return "", fmt.Errorf("%w: obtain the process handle: %v", ErrAIInstallSourceProof, err)
+	}
+	var token syscall.Token
+	if err := syscall.OpenProcessToken(process, syscall.TOKEN_QUERY, &token); err != nil {
+		return "", fmt.Errorf("%w: open the process token: %v", ErrAIInstallSourceProof, err)
+	}
+	defer func() { _ = token.Close() }()
+	user, err := token.GetTokenUser()
+	if err != nil || user == nil || user.User.Sid == nil {
+		return "", fmt.Errorf("%w: read the token user: %v", ErrAIInstallSourceProof, err)
+	}
+	sidText, err := user.User.Sid.String()
+	if err != nil {
+		return "", fmt.Errorf("%w: render the token user SID: %v", ErrAIInstallSourceProof, err)
+	}
+	return sidText, nil
+}
+
+// installSourceDescriptorDigest fingerprints the DACL of one object. A self-
+// relative security descriptor returned by GetNamedSecurityInfoW is a stable byte
+// rendering of that DACL, so a later loosening - or tightening - produces a
+// different digest and the carrier comparison turns red.
+func installSourceDescriptorDigest(name string) (string, error) {
+	namePointer, err := syscall.UTF16PtrFromString(name)
+	if err != nil {
+		return "", fmt.Errorf("%w: encode the path %q: %v", ErrAIInstallSourceProof, name, err)
+	}
+	var dacl uintptr
+	// descriptor is an out-parameter: GetNamedSecurityInfoW writes a pointer to a
+	// self-relative security descriptor, and keeping it as *byte avoids converting a
+	// uintptr back into a pointer (which go vet rightly refuses).
+	var descriptor *byte
+	result, _, _ := procInstallSourceGetNamedSecurityInfoW.Call(
+		uintptr(unsafe.Pointer(namePointer)),
+		uintptr(installSourceSEFileObject),
+		uintptr(installSourceDACLSecurityInformation),
+		0,
+		0,
+		uintptr(unsafe.Pointer(&dacl)),
+		0,
+		uintptr(unsafe.Pointer(&descriptor)),
+	)
+	if descriptor != nil {
+		defer procInstallSourceLocalFree.Call(uintptr(unsafe.Pointer(descriptor)))
+	}
+	if result != 0 {
+		return "", fmt.Errorf("%w: read the security descriptor of %q (win32 error %d)", ErrAIInstallSourceProof, name, result)
+	}
+	if descriptor == nil || dacl == 0 {
+		return "", fmt.Errorf("%w: %q carries no DACL, so immutability cannot be recorded", ErrAIInstallSourceProof, name)
+	}
+	length, _, _ := procInstallSourceGetSecurityDescriptorLen.Call(uintptr(unsafe.Pointer(descriptor)))
+	if length == 0 || length > 1<<20 {
+		return "", fmt.Errorf("%w: the security descriptor of %q reports an unusable length %d", ErrAIInstallSourceProof, name, length)
+	}
+	descriptorBytes := unsafe.Slice(descriptor, int(length))
+	return evidence.Digest(aiInstallSourceACLDomain, descriptorBytes), nil
+}
