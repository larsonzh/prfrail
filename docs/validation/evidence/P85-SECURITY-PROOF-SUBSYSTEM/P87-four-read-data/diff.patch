+//go:build !windows && !linux
+
+package adapters
+
+// F01, remaining platforms: there is no reviewed mutation-rights primitive here,
+// so the layout is unprovable. An unprovable layout is a refusal - the assembly
+// must never dispatch on "probably fine".
+
+import "fmt"
+
+// managedAgentPolicyDomainWriteProofSlots is the fail-closed half for every
+// platform without a reviewed mutation-rights primitive (P85 F01, design rev 3
+// section 1; shape per design rev 4 section 2).
+func managedAgentPolicyDomainWriteProofSlots(slots []managedAgentPolicyDomainSlot) (string, error) {
+	return "", fmt.Errorf("%w: no managed-identity write proof exists on this platform, so the policy domain of %d observed slot(s) cannot be proven closed", ErrManagedAgentPolicyWriteProof, len(slots))
+}
diff --git a/internal/adapters/agent_runner_policy_write_guard_unix.go b/internal/adapters/agent_runner_policy_write_guard_unix.go
new file mode 100644
index 0000000..79d18a0
--- /dev/null
+++ b/internal/adapters/agent_runner_policy_write_guard_unix.go
@@ -0,0 +1,262 @@
+//go:build linux
+
+package adapters
+
+// F01, Linux half: the managed agent runs under this process's uid/gid, so the
+// proof is the F08 verdict of the install-source proof applied to the policy
+// directory itself:
+//
+//   - a directory owned by the executing user is refused, because the owner can
+//     restore any permission with chmod, so its mode bits prove nothing;
+//   - other-writable is refused directly; group-writable is refused when the
+//     executing user is in that group;
+//   - a directory that carries a POSIX access ACL is refused, because a named
+//     entry can grant this user write access that the mode/owner rule never sees.
+//
+// The symbolic-link classification comes from os.Lstat: the NAME chain is what the
+// kernel walks, so a link component would make the judged object differ from the
+// object a write would reach.
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"syscall"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// managedAgentPolicyDomainWriteProofSlots is the Linux half of F01 (design rev 3
+// section 1) with the fixed four-slot vector of design rev 4 section 2. Every
+// PRESENT slot - the policy directory, its parent and each existing
+// artifact/anchor file - is judged with the same three rules the directory alone
+// used to get:
+//
+//   - a symbolic link is refused, because the judged name would not be the object
+//     a write reaches (the name form only; the handle form was opened without
+//     following one);
+//   - a POSIX access ACL is refused, because a named entry can grant this user
+//     write access the mode/owner rule never sees;
+//   - effective writability (owner, other-write, group-write in group) is refused,
+//     because an owner restores any permission with chmod.
+//
+// A slot that is not present contributes the canonical empty marker, so the vector
+// shape is stable. The observation line of each object carries dev:ino, so
+// replacing the directory, its parent or a file changes the digest.
+func managedAgentPolicyDomainWriteProofSlots(slots []managedAgentPolicyDomainSlot) (string, error) {
+	// The superuser writes every path regardless of mode and ownership, so the
+	// mode/owner rule can prove nothing for it.
+	if os.Geteuid() == 0 {
+		return "", fmt.Errorf("%w: the root user can write every path, so the policy domain cannot be proven closed", ErrManagedAgentPolicyWriteProof)
+	}
+	observed := make([]string, 0, len(slots))
+	var failures []error
+	for _, slot := range slots {
+		if !slot.present {
+			observed = append(observed, managedAgentPolicyDomainEmptySlot)
+			continue
+		}
+		line, objectErr := managedAgentPolicyDomainSlotObservation(slot)
+		if line != "" {
+			observed = append(observed, line)
+		}
+		if objectErr != nil {
+			failures = append(failures, objectErr)
+		}
+	}
+	digest := evidence.Digest(managedAgentPolicyWriteProofDomain, []byte(strings.Join(observed, "\n")))
+	if len(failures) > 0 {
+		return digest, fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, errors.Join(failures...))
+	}
+	return digest, nil
+}
+
+// managedAgentPolicyDomainSlotObservation judges one present slot and renders its
+// observation line. The line is returned even when the verdict refuses, so a
+// refusal records what was observed.
+//
+// P85 design rev 4 section 1: when the slot carries a handle, the permission facts
+// come from fstat(2) on THAT descriptor - the same object the reads and writes go
+// through.
+//
+// P85 R6 (review r3 finding): two fstats on the same descriptor only prove the
+// DESCRIPTOR did not change; they say nothing about which object the NAME-based ACL
+// probe actually read. Every path-based probe therefore runs inside an identity
+// sandwich whose two comparisons are name against handle, literally:
+//
+//	fstat(id0) -> FileIDAt(name) == handle FileID -> ACL probe
+//	           -> fstat(id1) -> FileIDAt(name) == handle FileID
+//
+// so a name that no longer addresses the descriptor's object refuses instead of
+// judging another object, and the caller's terminal ReassertIdentities closes the
+// observation afterwards.
+//
+// The access ACL is the one probe Linux cannot yet ask of a DIRECTORY descriptor:
+// evidence exposes fgetxattr for bound files (BoundFile.AccessACL) but only the
+// name-based AccessACLPath for directories, so a directory slot reads it by name
+// inside that sandwich. File slots do not go through the name at all.
+//
+// Registered residue (S1 boundary): for a DIRECTORY slot the instant between the
+// second comparison and getxattr(2) - and the resolution inside getxattr itself -
+// is a name re-resolution this layer cannot eliminate. A name redirected to another
+// object and restored within that window would deliver that object's ACL. The
+// window is bounded by the two fstats (the descriptor cannot change under them) and
+// by the two name comparisons, and the probe writes nothing; it is recorded as a
+// known boundary instead of being claimed away.
+func managedAgentPolicyDomainSlotObservation(slot managedAgentPolicyDomainSlot) (string, error) {
+	fd, hasHandle, err := managedAgentPolicyDomainSlotDescriptor(slot)
+	if err != nil {
+		return "", err
+	}
+	var handleIdentity evidence.FileID
+	if hasHandle {
+		handleIdentity, err = managedAgentPolicyDomainSlotHandleIdentity(slot)
+		if err != nil {
+			return "", err
+		}
+	}
+	var stat syscall.Stat_t
+	var mode os.FileMode
+	if hasHandle {
+		if err := syscall.Fstat(fd, &stat); err != nil {
+			return "", fmt.Errorf("%w: fstat the %s %q on its handle: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		mode = os.FileMode(stat.Mode)
+	} else {
+		info, err := os.Lstat(slot.path)
+		if err != nil {
+			return "", fmt.Errorf("%w: lstat the %s %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return "", fmt.Errorf("%w: the %s %q is a symbolic link, so the judged name is not the object the writes would reach", ErrManagedAgentPolicyWriteProof, slot.label, slot.path)
+		}
+		owned, ok := info.Sys().(*syscall.Stat_t)
+		if !ok {
+			return "", fmt.Errorf("%w: the %s %q carries no ownership information", ErrManagedAgentPolicyWriteProof, slot.label, slot.path)
+		}
+		stat = *owned
+		mode = info.Mode()
+	}
+	fileType := uint32(stat.Mode) & uint32(syscall.S_IFMT)
+	if slot.isDir && fileType != uint32(syscall.S_IFDIR) {
+		return "", fmt.Errorf("%w: the %s %q is not a directory", ErrManagedAgentPolicyWriteProof, slot.label, slot.path)
+	}
+	if !slot.isDir && fileType != uint32(syscall.S_IFREG) {
+		return "", fmt.Errorf("%w: the %s %q is not a regular file", ErrManagedAgentPolicyWriteProof, slot.label, slot.path)
+	}
+	line := fmt.Sprintf("%s:%d:%d:%04o:%d:%d", slot.path, stat.Dev, stat.Ino, mode.Perm(), stat.Uid, stat.Gid)
+	// The opening name comparison: the ACL probe below must judge the object the
+	// descriptor addresses, and this is the only way to prove the name still reaches
+	// it.
+	if err := managedAgentPolicyDomainAssertNameIdentity(slot, handleIdentity, "before"); err != nil {
+		return line, err
+	}
+	if err := managedAgentPolicyDomainDenyAccessACL(slot); err != nil {
+		return line, err
+	}
+	if hasHandle {
+		var after syscall.Stat_t
+		if err := syscall.Fstat(fd, &after); err != nil {
+			return line, fmt.Errorf("%w: fstat the %s %q after its ACL check: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		if after.Dev != stat.Dev || after.Ino != stat.Ino || after.Mode != stat.Mode || after.Uid != stat.Uid || after.Gid != stat.Gid {
+			return line, fmt.Errorf("%w: the %s %q changed identity between its descriptor observation and the ACL check", ErrManagedAgentPolicyWriteProof, slot.label, slot.path)
+		}
+		// The closing name comparison of the sandwich. Together with the opening one
+		// it proves the name addressed the descriptor on BOTH sides of the probe; the
+		// probe itself is the registered residue (see the function comment), and the
+		// caller's ReassertIdentities is the terminal verdict over the whole domain.
+		if err := managedAgentPolicyDomainAssertNameIdentity(slot, handleIdentity, "after"); err != nil {
+			return line, err
+		}
+	}
+	if err := installSourceEffectiveWritability(slot.path, mode, int(stat.Uid), int(stat.Gid)); err != nil {
+		return line, fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, err)
+	}
+	return line, nil
+}
+
+// managedAgentPolicyDomainSlotHandleIdentity reports the identity of the handle
+// that owns the slot. It is the value every name-based comparison has to reproduce
+// literally.
+func managedAgentPolicyDomainSlotHandleIdentity(slot managedAgentPolicyDomainSlot) (evidence.FileID, error) {
+	if slot.dir != nil {
+		identity, err := slot.dir.FileID()
+		if err != nil {
+			return "", fmt.Errorf("%w: identify the %s handle %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		return identity, nil
+	}
+	if slot.file != nil {
+		identity, err := slot.file.FileID()
+		if err != nil {
+			return "", fmt.Errorf("%w: identify the %s handle %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		return evidence.FileID(identity), nil
+	}
+	return "", nil
+}
+
+// managedAgentPolicyDomainAssertNameIdentity requires the slot's NAME to still
+// address the object its handle addresses (P85 R6). evidence.FileIDAt resolves the
+// name the way the write would, the handle reports its own identity from fstat(2),
+// and the two are compared as strings: an equal pair means the path-based probe and
+// the descriptor describe one object at that instant.
+func managedAgentPolicyDomainAssertNameIdentity(slot managedAgentPolicyDomainSlot, handleIdentity evidence.FileID, when string) error {
+	if handleIdentity == "" {
+		return nil
+	}
+	current, err := evidence.FileIDAt(slot.path)
+	if err != nil {
+		return fmt.Errorf("%w: the %s %q can no longer be observed %s its ACL check: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, when, err)
+	}
+	if current != handleIdentity {
+		return fmt.Errorf("%w: the %s %q no longer addresses the object its handle addresses %s its ACL check (%s != %s)",
+			ErrManagedAgentPolicyWriteProof, slot.label, slot.path, when, current, handleIdentity)
+	}
+	return nil
+}
+
+// managedAgentPolicyDomainDenyAccessACL is the ACL probe of one slot.
+//
+// A bound FILE reads it from its own descriptor through fgetxattr (no name
+// resolution at all). A bound DIRECTORY has no descriptor-based reader in evidence
+// yet, so it falls back to the name-based read - which is exactly why its caller
+// wraps this call in the identity sandwich and registers the residue.
+func managedAgentPolicyDomainDenyAccessACL(slot managedAgentPolicyDomainSlot) error {
+	if slot.file != nil {
+		present, err := slot.file.AccessACL()
+		if err != nil {
+			return fmt.Errorf("%w: the access ACL of the %s %q cannot be read on its handle: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		if present {
+			return fmt.Errorf("%w: the %s %q carries a POSIX access ACL, so a named grant to this user cannot be excluded", ErrManagedAgentPolicyWriteProof, slot.label, slot.path)
+		}
+		return nil
+	}
+	if err := installSourceDenyAccessACLPath(slot.path); err != nil {
+		return fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, err)
+	}
+	return nil
+}
+
+// managedAgentPolicyDomainSlotDescriptor resolves the descriptor of a handle-form
+// slot; hasHandle=false selects the name form.
+func managedAgentPolicyDomainSlotDescriptor(slot managedAgentPolicyDomainSlot) (int, bool, error) {
+	if slot.dir != nil {
+		fd, err := slot.dir.Descriptor()
+		if err != nil {
+			return -1, false, fmt.Errorf("%w: read the descriptor of the %s %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		return int(fd), true, nil
+	}
+	if slot.file != nil {
+		fd, err := slot.file.Descriptor()
+		if err != nil {
+			return -1, false, fmt.Errorf("%w: read the descriptor of the %s %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		return int(fd), true, nil
+	}
+	return -1, false, nil
+}
diff --git a/internal/adapters/agent_runner_policy_write_guard_windows.go b/internal/adapters/agent_runner_policy_write_guard_windows.go
new file mode 100644
index 0000000..d0b84db
--- /dev/null
+++ b/internal/adapters/agent_runner_policy_write_guard_windows.go
@@ -0,0 +1,138 @@
+//go:build windows
+
+package adapters
+
+// F01, Windows half: the managed agent runs under this process's token, so the
+// proof is "can THIS token obtain any mutation right on the policy directory".
+//
+// The probe is the T3 primitive family reused verbatim: one CreateFile per right
+// per object (installSourceMutationAccess with the full directory table), so a
+// directory that grants just one right - FILE_DELETE_CHILD alone, WRITE_DAC
+// alone - is refused instead of being averaged away by a merged mask. A granted
+// handle is closed immediately and nothing is written, so the probe leaves no
+// footprint; only ERROR_ACCESS_DENIED counts as a denial and every other failure
+// refuses.
+//
+// The directory is opened AS ITSELF first: a reparse point would make the name
+// the kernel walks differ from the object that was judged.
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/larsonzh/prfrail/internal/evidence"
+)
+
+// managedAgentPolicyDomainWriteProofSlots is the Windows half of F01 (design rev
+// 3 section 1) with the fixed four-slot vector of design rev 4 section 2: one
+// access check per mutation right, per PRESENT slot of the write domain (the
+// policy directory, its parent, and every existing artifact/anchor file). A single
+// granted right on any object refuses the whole domain, so a layout that grants
+// FILE_DELETE_CHILD on the parent or WRITE_DATA on the artifact is refused instead
+// of being averaged away. A granted handle is closed immediately and nothing is
+// written, so the probe leaves no footprint.
+//
+// Each present object also contributes its identity (volume serial plus file
+// index), so replacing a directory, a parent or a file changes the digest; an
+// absent slot contributes the canonical empty marker and keeps the vector shape.
+func managedAgentPolicyDomainWriteProofSlots(slots []managedAgentPolicyDomainSlot) (string, error) {
+	sidText, err := installSourceCurrentUserSIDText()
+	if err != nil {
+		return "", fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, err)
+	}
+	observed := make([]string, 0, len(slots))
+	var failures []error
+	for _, slot := range slots {
+		if !slot.present {
+			observed = append(observed, managedAgentPolicyDomainEmptySlot)
+			continue
+		}
+		line, granted, objectErr := managedAgentPolicyDomainSlotObservation(slot, sidText)
+		if line != "" {
+			observed = append(observed, line)
+		}
+		if objectErr != nil {
+			failures = append(failures, objectErr)
+			continue
+		}
+		if granted > 0 {
+			failures = append(failures, fmt.Errorf("%w: the managed identity can obtain %d mutation right(s) on the %s %q",
+				ErrManagedAgentPolicyWriteProof, granted, slot.label, slot.path))
+		}
+	}
+	digest := evidence.Digest(managedAgentPolicyWriteProofDomain, []byte(strings.Join(observed, "\n")))
+	if len(failures) > 0 {
+		return digest, fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, errors.Join(failures...))
+	}
+	return digest, nil
+}
+
+// managedAgentPolicyDomainSlotObservation judges one present slot and renders its
+// observation line (which is returned even when the verdict refuses).
+//
+// P85 design rev 4, sections 1 and 3:
+//   - a handle-form slot takes its identity from the handle, and the path must
+//     still address that same object before AND after the probes (the identity
+//     sandwich), so a name that moved off the handle refuses;
+//   - the name CHAIN is classified with the same root-chain walk the verified
+//     binding uses, so a reparse point anywhere in the chain refuses instead of
+//     being followed by the kernel.
+func managedAgentPolicyDomainSlotObservation(slot managedAgentPolicyDomainSlot, sidText string) (string, int, error) {
+	handleIdentity := ""
+	if slot.dir != nil {
+		identity, err := slot.dir.FileID()
+		if err != nil {
+			return "", 0, fmt.Errorf("%w: identify the %s handle %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		handleIdentity = string(identity)
+	} else if slot.file != nil {
+		identity, err := slot.file.FileID()
+		if err != nil {
+			return "", 0, fmt.Errorf("%w: identify the %s handle %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+		}
+		handleIdentity = identity
+	}
+	if err := evidence.ClassifyRootChainNoReparse(slot.path, slot.isDir); err != nil {
+		return "", 0, fmt.Errorf("%w: classify the root chain of the %s %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+	}
+	before, err := evidence.FileIDAt(slot.path)
+	if err != nil {
+		return "", 0, fmt.Errorf("%w: identify the %s %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+	}
+	if handleIdentity != "" && string(before) != handleIdentity {
+		return "", 0, fmt.Errorf("%w: the %s %q no longer names the object its handle addresses (%s != %s)",
+			ErrManagedAgentPolicyWriteProof, slot.label, slot.path, before, handleIdentity)
+	}
+	rights := installSourceFileMutationRights
+	if slot.isDir {
+		rights = installSourceDirectoryMutationRights
+	}
+	granted, denied, err := installSourceMutationAccess(slot.path, slot.isDir, rights)
+	if err != nil {
+		return "", 0, fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, err)
+	}
+	after, err := evidence.FileIDAt(slot.path)
+	if err != nil {
+		return "", 0, fmt.Errorf("%w: re-identify the %s %q: %v", ErrManagedAgentPolicyWriteProof, slot.label, slot.path, err)
+	}
+	if after != before {
+		return "", 0, fmt.Errorf("%w: the %s %q changed identity during its access probes (%s != %s)",
+			ErrManagedAgentPolicyWriteProof, slot.label, slot.path, after, before)
+	}
+	descriptor, err := installSourceDescriptorDigest(slot.path)
+	if err != nil {
+		return "", 0, fmt.Errorf("%w: %v", ErrManagedAgentPolicyWriteProof, err)
+	}
+	identity := handleIdentity
+	if identity == "" {
+		identity = string(before)
+	}
+	line := strings.ToLower(slot.path) + "\n" +
+		"id:" + identity + "\n" +
+		"granted:" + installSourceRightsText(granted) + "\n" +
+		"denied:" + installSourceRightsText(denied) + "\n" +
+		"dacl:" + descriptor + "\n" +
+		"trustee:" + sidText
+	return line, len(granted), nil
+}
