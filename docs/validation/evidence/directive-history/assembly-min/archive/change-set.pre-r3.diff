+func agentRunnerReadArtifact(t *testing.T, store *AgentRunnerReplayStore, requestID, name string) []byte {
+	t.Helper()
+	dir, err := store.RunEvidenceDir(requestID)
+	if err != nil {
+		t.Fatal(err)
