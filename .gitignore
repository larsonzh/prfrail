# Go
/bin/
*.exe
*.test
*.out
vendor/
/tools/contracts/node_modules/

# ProofRail runtime state
/out/
/tmp/*
!/tmp/.gitkeep
# Scratch output belongs in the repo-root tmp/ only; guard against tools writing their own tmp/
/tools/tmp/

# Agent role set: role definitions (*.agent.md) ARE versioned (DELIVERY_DIRECTIVE R2.5);
# only the sol-orchestrator generator toolchain and its artifacts stay ignored.
.github/agents/sol-orchestrator/
.github/agents/*.managed.json
**/__pycache__/

# context-mode runtime state
.github/context-mode/content/
.github/context-mode/sessions/
.github/hooks/context-mode.json.bak

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
