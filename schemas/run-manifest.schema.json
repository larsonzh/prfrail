{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/run-manifest.schema.json",
  "title": "ProofRail frozen run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "manifestHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "manifestHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "jsonPointer": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "sha256Set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectivePointer", "sourceKind", "sourceHash", "sourcePointer"],
      "properties": {
        "effectivePointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "sourceKind": {
          "enum": ["builtin-default", "profile", "chain", "task", "step"]
        },
        "sourceHash": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "sourcePointer": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/jsonPointer"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "sourceKind": {"const": "builtin-default"},
            "sourceHash": {"type": "null"},
            "sourcePointer": {"type": "null"}
          }
        },
        {
          "properties": {
            "sourceKind": {"enum": ["profile", "chain", "task", "step"]},
            "sourceHash": {"$ref": "#/$defs/sha256"},
            "sourcePointer": {"$ref": "#/$defs/jsonPointer"}
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "objectHash", "capabilityEvidence"],
      "properties": {
        "kind": {
          "enum": ["adapter", "harness", "toolchain", "hook", "policy"]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "objectHash": {
          "$ref": "#/$defs/sha256"
        },
        "capabilityEvidence": {
          "$ref": "#/$defs/sha256Set"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "createdAt",
        "runId",
        "chainId",
        "chainDefinitionHash",
        "effectiveChainHash",
        "sourceConfigEvidence",
        "resolution",
        "policyHash",
        "parentSnapshotHash",
        "bindings"
      ],
      "properties": {
        "manifestId": {"$ref": "#/$defs/id"},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "runId": {"$ref": "#/$defs/id"},
        "chainId": {"$ref": "#/$defs/id"},
        "chainDefinitionHash": {"$ref": "#/$defs/sha256"},
        "effectiveChainHash": {"$ref": "#/$defs/sha256"},
        "sourceConfigEvidence": {"$ref": "#/$defs/sha256Set"},
        "resolution": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/resolution"}
        },
        "policyHash": {"$ref": "#/$defs/sha256"},
        "parentSnapshotHash": {"$ref": "#/$defs/sha256"},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    }
  }
}
