{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/agent-runner-capability.schema.json",
  "title": "ProofRail AgentRunner capability report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capability", "recordHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "capability": {"$ref": "#/$defs/capability"},
    "recordHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["verified", "unsupported", "unknown"]},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "probeId", "adapterId", "probedAt", "executableHash", "version", "configHash", "disposition", "matrix", "evidence"],
      "properties": {
        "kind": {"const": "agent-runner-capability"},
        "probeId": {"$ref": "#/$defs/id"},
        "adapterId": {"$ref": "#/$defs/id"},
        "probedAt": {"$ref": "#/$defs/timestamp"},
        "executableHash": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "configHash": {"$ref": "#/$defs/sha256"},
        "disposition": {"enum": ["compatible", "blocked"]},
        "matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["noninteractive", "cwd", "eventStreamOrCompleteLogs", "sessionCreate", "sessionResume", "cancellation", "processTreeStop", "toolControl", "networkControl", "permissionControl", "usage", "unattendedConfirmations"],
          "properties": {
            "noninteractive": {"$ref": "#/$defs/finding"},
            "cwd": {"$ref": "#/$defs/finding"},
            "eventStreamOrCompleteLogs": {"$ref": "#/$defs/finding"},
            "sessionCreate": {"$ref": "#/$defs/finding"},
            "sessionResume": {"$ref": "#/$defs/finding"},
            "cancellation": {"$ref": "#/$defs/finding"},
            "processTreeStop": {"$ref": "#/$defs/finding"},
            "toolControl": {"$ref": "#/$defs/finding"},
            "networkControl": {"$ref": "#/$defs/finding"},
            "permissionControl": {"$ref": "#/$defs/finding"},
            "usage": {"$ref": "#/$defs/finding"},
            "unattendedConfirmations": {"$ref": "#/$defs/finding"}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    }
  }
}