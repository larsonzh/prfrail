{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/change-set.schema.json",
  "title": "ProofRail managed change set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeSet", "changeSetHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "changeSet": {"$ref": "#/$defs/changeSet"},
    "changeSetHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "nullableHash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^[^\\r\\u0000]*$"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "kind", "text", "count"],
      "properties": {
        "phase": {"enum": ["before", "after"]},
        "kind": {"enum": ["exact-occurrences", "absent"]},
        "text": {"$ref": "#/$defs/text"},
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "absent"}}},
          "then": {"properties": {"count": {"const": 0}}}
        }
      ]
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markerId", "text", "beforeCount", "afterCount"],
      "properties": {
        "markerId": {"$ref": "#/$defs/id"},
        "text": {"$ref": "#/$defs/text"},
        "beforeCount": {"const": 0},
        "afterCount": {"const": 1}
      }
    },
    "operationBase": {
      "type": "object",
      "required": ["operationId", "sequence", "kind", "path", "beforeHash", "afterHash", "assertions"],
      "properties": {
        "operationId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["create-file", "delete-file", "replace-exact", "insert-before", "insert-after"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "beforeHash": {"$ref": "#/$defs/nullableHash"},
        "afterHash": {"$ref": "#/$defs/nullableHash"},
        "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/assertion"}}
      }
    },
    "createFile": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "sequence", "kind", "path", "beforeHash", "afterHash", "assertions", "content", "lineEnding"],
          "properties": {
            "operationId": {"$ref": "#/$defs/id"},
            "sequence": {"type": "integer", "minimum": 1},
            "kind": {"const": "create-file"},
            "path": {"$ref": "#/$defs/relativePath"},
            "beforeHash": {"type": "null"},
            "afterHash": {"$ref": "#/$defs/sha256"},
            "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/assertion"}},
            "content": {"type": "string", "maxLength": 1048576, "pattern": "^[^\\r\\u0000]*$"},
            "lineEnding": {"enum": ["lf", "crlf"]}
          }
        }
      ]
    },
    "deleteFile": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "sequence", "kind", "path", "beforeHash", "afterHash", "assertions"],
          "properties": {
            "operationId": {"$ref": "#/$defs/id"},
            "sequence": {"type": "integer", "minimum": 1},
            "kind": {"const": "delete-file"},
            "path": {"$ref": "#/$defs/relativePath"},
            "beforeHash": {"$ref": "#/$defs/sha256"},
            "afterHash": {"type": "null"},
            "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/assertion"}}
          }
        }
      ]
    },
    "replaceExact": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "sequence", "kind", "path", "beforeHash", "afterHash", "assertions", "match", "replacement", "expectedMatches", "lineEnding", "marker"],
          "properties": {
            "operationId": {"$ref": "#/$defs/id"},
            "sequence": {"type": "integer", "minimum": 1},
            "kind": {"const": "replace-exact"},
            "path": {"$ref": "#/$defs/relativePath"},
            "beforeHash": {"$ref": "#/$defs/sha256"},
            "afterHash": {"$ref": "#/$defs/sha256"},
            "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/assertion"}},
            "match": {"$ref": "#/$defs/text"},
            "replacement": {"type": "string", "maxLength": 1048576, "pattern": "^[^\\r\\u0000]*$"},
            "expectedMatches": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "lineEnding": {"const": "preserve-existing"},
            "marker": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/marker"}]}
          }
        }
      ]
    },
    "insert": {
      "allOf": [
        {"$ref": "#/$defs/operationBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "sequence", "kind", "path", "beforeHash", "afterHash", "assertions", "anchor", "content", "expectedMatches", "lineEnding", "marker"],
          "properties": {
            "operationId": {"$ref": "#/$defs/id"},
            "sequence": {"type": "integer", "minimum": 1},
            "kind": {"enum": ["insert-before", "insert-after"]},
            "path": {"$ref": "#/$defs/relativePath"},
            "beforeHash": {"$ref": "#/$defs/sha256"},
            "afterHash": {"$ref": "#/$defs/sha256"},
            "assertions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/assertion"}},
            "anchor": {"$ref": "#/$defs/text"},
            "content": {"$ref": "#/$defs/text"},
            "expectedMatches": {"const": 1},
            "lineEnding": {"const": "preserve-existing"},
            "marker": {"$ref": "#/$defs/marker"}
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/createFile"},
        {"$ref": "#/$defs/deleteFile"},
        {"$ref": "#/$defs/replaceExact"},
        {"$ref": "#/$defs/insert"}
      ]
    },
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeSetId", "createdAt", "runId", "taskId", "attempt", "parentSnapshotHash", "beforeManifestHash", "afterManifestHash", "mode", "operations"],
      "properties": {
        "changeSetId": {"$ref": "#/$defs/id"},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "parentSnapshotHash": {"$ref": "#/$defs/sha256"},
        "beforeManifestHash": {"$ref": "#/$defs/sha256"},
        "afterManifestHash": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "managed-change-set"},
        "operations": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/operation"}}
      }
    }
  }
}