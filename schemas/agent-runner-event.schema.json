{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/agent-runner-event.schema.json",
  "title": "ProofRail AgentRunner event record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "event", "recordHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "event": {"$ref": "#/$defs/event"},
    "recordHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "eventId", "requestId", "requestHash", "runId", "taskId", "stepId", "attempt", "adapterId", "sessionId", "sequence", "occurredAt", "eventType", "payloadHash", "evidence"],
      "properties": {
        "kind": {"const": "agent-runner-event"},
        "eventId": {"$ref": "#/$defs/id"},
        "requestId": {"$ref": "#/$defs/id"},
        "requestHash": {"$ref": "#/$defs/sha256"},
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "stepId": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "adapterId": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "occurredAt": {"$ref": "#/$defs/timestamp"},
        "eventType": {"enum": ["session-created", "output", "tool", "usage", "diagnostic", "operator-action-required", "process"]},
        "payloadHash": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    }
  }
}