{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/hook.schema.json",
  "title": "ProofRail hook registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hooks"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hook"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "managedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "managedGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!!)(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "stringArguments": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "nonEmptyStringArguments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "processRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "executable"],
      "properties": {
        "type": {
          "const": "process"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._+-]*|(?:(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000).+/[^/]+))$"
        },
        "args": {
          "$ref": "#/$defs/stringArguments"
        }
      }
    },
    "containerRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "imageDigest", "entrypoint"],
      "properties": {
        "type": {
          "const": "container"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "imageReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "entrypoint": {
          "$ref": "#/$defs/nonEmptyStringArguments"
        },
        "args": {
          "$ref": "#/$defs/stringArguments"
        }
      }
    },
    "onFail": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": {
              "enum": ["fail-stop", "warn", "manual"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "maxAttempts"],
          "properties": {
            "action": {
              "const": "retry"
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            }
          }
        }
      ]
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryBytes", "outputBytes", "processCount"],
      "properties": {
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "processCount": {
          "type": "integer",
          "minimum": 1
        },
        "cpuTimeMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "networkPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["deny", "loopback"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "hosts"],
          "properties": {
            "mode": {
              "const": "allowlist"
            },
            "hosts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9][a-z0-9.:-]*[a-z0-9]$|^[a-z0-9]$"
              }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "runner", "onFail", "timeoutMs", "resourceLimits", "networkPolicy"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["precheck", "build", "test", "verify", "review", "cleanup"]
        },
        "runner": {
          "oneOf": [
            {"$ref": "#/$defs/processRunner"},
            {"$ref": "#/$defs/containerRunner"}
          ]
        },
        "cwd": {
          "$ref": "#/$defs/managedPath"
        },
        "envAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "onFail": {
          "$ref": "#/$defs/onFail"
        },
        "artifactGlobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/managedGlob"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "resourceLimits": {
          "$ref": "#/$defs/resourceLimits"
        },
        "networkPolicy": {
          "$ref": "#/$defs/networkPolicy"
        }
      }
    }
  }
}