{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/harness.schema.json",
  "title": "ProofRail harness registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harnesses"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/harness"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "idSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "managedGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!!)(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "stringParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "string"},
        "required": {"type": "boolean"},
        "default": {"type": "string", "maxLength": 4096}
      }
    },
    "integerParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "integer"},
        "required": {"type": "boolean"},
        "default": {"type": "integer"}
      }
    },
    "booleanParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "boolean"},
        "required": {"type": "boolean"},
        "default": {"type": "boolean"}
      }
    },
    "parameter": {
      "oneOf": [
        {"$ref": "#/$defs/stringParameter"},
        {"$ref": "#/$defs/integerParameter"},
        {"$ref": "#/$defs/booleanParameter"}
      ]
    },
    "hookBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "hookId", "required"],
      "properties": {
        "phase": {"enum": ["format", "build", "test", "verify", "integration"]},
        "hookId": {"$ref": "#/$defs/id"},
        "required": {"type": "boolean"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "languages", "toolchains", "parameters", "hooks", "artifactGlobs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "languages": {"$ref": "#/$defs/idSet"},
        "toolchains": {"$ref": "#/$defs/idSet"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hookBinding"}
        },
        "artifactGlobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/managedGlob"}
        }
      }
    }
  }
}