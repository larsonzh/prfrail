{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/supervised-report.schema.json",
  "title": "ProofRail supervised-black-box reduced/unknown report",
  "description": "Factual record of what a supervised-black-box run can and cannot prove (contracts section 7.1d). assuranceLevel is permanently reduced and unknownDimensions is non-empty and must contain cost, so an unknown dimension can never be rendered as safe. The canonical record hash domain separator lives in the hash layer, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "record", "recordHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "record": {
      "$ref": "#/$defs/record"
    },
    "recordHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "hashSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nonemptyHashSet": {
      "$ref": "#/$defs/hashSet",
      "minItems": 1
    },
    "systemActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "system"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "unknownDimension": {
      "enum": [
        "tool-use",
        "resource-reads",
        "network-access",
        "cost",
        "background-processes",
        "session-continuity",
        "external-side-effects"
      ]
    },
    "verifiedDimension": {
      "enum": [
        "workspace-isolation",
        "manifest-before",
        "manifest-after",
        "diff",
        "scope-scan",
        "secret-scan",
        "file-type-scan",
        "side-effect-scan",
        "process-stop-proof",
        "independent-gates",
        "independent-review"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reportId",
        "recordedAt",
        "recordedBy",
        "runId",
        "taskId",
        "stepId",
        "attempt",
        "mode",
        "assuranceLevel",
        "verifiedDimensions",
        "unknownDimensions",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "supervised-report"
        },
        "reportId": {
          "$ref": "#/$defs/id"
        },
        "recordedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "recordedBy": {
          "$ref": "#/$defs/systemActor"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "stepId": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "supervised-black-box"
        },
        "assuranceLevel": {
          "const": "reduced"
        },
        "verifiedDimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verifiedDimension"
          }
        },
        "unknownDimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/unknownDimension"
          },
          "contains": {
            "const": "cost"
          },
          "minContains": 1
        },
        "evidence": {
          "$ref": "#/$defs/nonemptyHashSet"
        }
      }
    }
  }
}
