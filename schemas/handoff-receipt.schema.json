{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/handoff-receipt.schema.json",
  "title": "ProofRail manual handoff completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receipt", "receiptHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "receiptHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "hashSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nonemptyHashSet": {
      "$ref": "#/$defs/hashSet",
      "minItems": 1
    },
    "systemActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "system"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "operatorActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "operator"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "recordedBy",
        "operator",
        "runId",
        "taskId",
        "stepId",
        "attempt",
        "handoffPolicyHash",
        "openedAt",
        "closedAt",
        "beforeManifestHash",
        "afterManifestHash",
        "diffHash",
        "leaseEvidence",
        "outcome",
        "hookResultEvidence",
        "evidence"
      ],
      "properties": {
        "receiptId": {"$ref": "#/$defs/id"},
        "recordedBy": {"$ref": "#/$defs/systemActor"},
        "operator": {"$ref": "#/$defs/operatorActor"},
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "stepId": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "handoffPolicyHash": {"$ref": "#/$defs/sha256"},
        "openedAt": {"$ref": "#/$defs/timestamp"},
        "closedAt": {"$ref": "#/$defs/timestamp"},
        "beforeManifestHash": {"$ref": "#/$defs/sha256"},
        "afterManifestHash": {"$ref": "#/$defs/sha256"},
        "diffHash": {"$ref": "#/$defs/sha256"},
        "leaseEvidence": {"$ref": "#/$defs/nonemptyHashSet"},
        "outcome": {"enum": ["complete", "abort", "request-agent"]},
        "hookResultEvidence": {"$ref": "#/$defs/hashSet"},
        "evidence": {"$ref": "#/$defs/nonemptyHashSet"}
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {"const": "complete"},
            "hookResultEvidence": {"minItems": 1}
          }
        },
        {
          "properties": {
            "outcome": {"enum": ["abort", "request-agent"]},
            "hookResultEvidence": {"maxItems": 0}
          }
        }
      ]
    }
  }
}
