{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/adapter-receipt.schema.json",
  "title": "ProofRail adapter dispatch and takeover receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receipt", "receiptHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receipt": {
      "oneOf": [
        {"$ref": "#/$defs/dispatchReceipt"},
        {"$ref": "#/$defs/takeoverReceipt"}
      ]
    },
    "receiptHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "hashSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["system", "operator"]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "$ref": "#/$defs/id"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "transportRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "dispatchReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "receiptId", "occurredAt", "recordedBy", "requestId", "requestHash", "evidence", "errorEvidence", "adapter", "transport", "transportRequestId", "outcome"],
      "properties": {
        "type": {"const": "dispatch"},
        "receiptId": {"$ref": "#/$defs/id"},
        "occurredAt": {"$ref": "#/$defs/timestamp"},
        "recordedBy": {"$ref": "#/$defs/actor"},
        "requestId": {"$ref": "#/$defs/id"},
        "requestHash": {"$ref": "#/$defs/sha256"},
        "evidence": {"$ref": "#/$defs/hashSet"},
        "errorEvidence": {"$ref": "#/$defs/hashSet"},
        "adapter": {"$ref": "#/$defs/id"},
        "transport": {"enum": ["ipc", "file-queue", "sessbridge"]},
        "transportRequestId": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/transportRequestId"}
          ]
        },
        "outcome": {"enum": ["accepted", "rejected", "uncertain"]}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "outcome": {"const": "accepted"},
                "errorEvidence": {"maxItems": 0}
              }
            },
            {
              "properties": {
                "outcome": {"enum": ["rejected", "uncertain"]},
                "errorEvidence": {"minItems": 1}
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "transport": {"const": "file-queue"},
                "transportRequestId": {"type": "null"}
              }
            },
            {
              "properties": {
                "transport": {"const": "sessbridge"},
                "transportRequestId": {"$ref": "#/$defs/transportRequestId"}
              }
            },
            {
              "properties": {
                "transport": {"const": "ipc"}
              }
            }
          ]
        }
      ]
    },
    "takeoverReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "receiptId", "occurredAt", "recordedBy", "requestId", "requestHash", "evidence", "errorEvidence", "previousClaimId", "previousGeneration", "newClaimId", "newGeneration", "oldWriterEvidence", "authorizationEvidence", "reason", "outcome"],
      "properties": {
        "type": {"const": "takeover"},
        "receiptId": {"$ref": "#/$defs/id"},
        "occurredAt": {"$ref": "#/$defs/timestamp"},
        "recordedBy": {"$ref": "#/$defs/actor"},
        "requestId": {"$ref": "#/$defs/id"},
        "requestHash": {"$ref": "#/$defs/sha256"},
        "evidence": {"$ref": "#/$defs/hashSet"},
        "errorEvidence": {"$ref": "#/$defs/hashSet"},
        "previousClaimId": {"$ref": "#/$defs/id"},
        "previousGeneration": {"type": "integer", "minimum": 1},
        "newClaimId": {"$ref": "#/$defs/id"},
        "newGeneration": {"type": "integer", "minimum": 2},
        "oldWriterEvidence": {
          "$ref": "#/$defs/nonemptyHashSet"
        },
        "authorizationEvidence": {
          "$ref": "#/$defs/nonemptyHashSet"
        },
        "reason": {"$ref": "#/$defs/reason"},
        "outcome": {"enum": ["granted", "rejected"]}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "outcome": {"const": "granted"},
                "errorEvidence": {"maxItems": 0}
              }
            },
            {
              "properties": {
                "outcome": {"const": "rejected"},
                "errorEvidence": {"minItems": 1}
              }
            }
          ]
        }
      ]
    },
    "nonemptyHashSet": {
      "allOf": [
        {"$ref": "#/$defs/hashSet"},
        {"minItems": 1}
      ]
    }
  }
}
