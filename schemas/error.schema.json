{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/error.schema.json",
  "title": "ProofRail persistent error record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "error"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["system", "chain", "task", "step", "hook", "adapter", "store"]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorId", "occurredAt", "category", "code", "subject", "evidence", "message", "retryMode", "suggestedAction"],
      "properties": {
        "errorId": {
          "$ref": "#/$defs/id"
        },
        "occurredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "category": {
          "enum": ["schema", "static", "policy", "capability", "transport", "execution", "integrity", "storage", "review", "operator", "internal"]
        },
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryMode": {
          "enum": ["never", "same-request", "new-attempt", "after-reconcile", "after-operator"]
        },
        "suggestedAction": {
          "enum": ["fix-input", "fix-contract", "grant-policy", "install-capability", "retry", "reconcile", "repair", "restore-storage", "review", "operator-action", "report-bug"]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {"properties": {"category": {"const": "schema"}, "code": {"pattern": "^schema\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "static"}, "code": {"pattern": "^static\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "policy"}, "code": {"pattern": "^policy\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "capability"}, "code": {"pattern": "^capability\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "transport"}, "code": {"pattern": "^transport\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "execution"}, "code": {"pattern": "^execution\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "integrity"}, "code": {"pattern": "^integrity\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "storage"}, "code": {"pattern": "^storage\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "review"}, "code": {"pattern": "^review\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "operator"}, "code": {"pattern": "^operator\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}},
            {"properties": {"category": {"const": "internal"}, "code": {"pattern": "^internal\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}}
          ]
        }
      ]
    }
  }
}
