{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/error.schema.json",
  "title": "ProofRail persistent error record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "error"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["system", "chain", "task", "step", "hook", "adapter", "store"]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorId", "occurredAt", "category", "code", "subject", "evidence", "message", "retryMode", "suggestedAction"],
      "properties": {
        "errorId": {
          "$ref": "#/$defs/id"
        },
        "occurredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "category": {
          "enum": ["schema", "static", "policy", "capability", "transport", "execution", "integrity", "storage", "review", "operator", "internal"]
        },
        "code": {
          "enum": [
            "schema.invalid-document",
            "schema.unsupported-version",
            "static.unresolved-reference",
            "static.dependency-cycle",
            "static.path-invalid",
            "static.target-conflict",
            "policy.authorization-denied",
            "policy.budget-exhausted",
            "policy.boundary-violation",
            "capability.unavailable",
            "capability.unsupported-runner",
            "capability.isolation-unavailable",
            "transport.rejected",
            "transport.timeout",
            "transport.result-uncertain",
            "execution.start-failed",
            "execution.exit-nonzero",
            "execution.timed-out",
            "execution.resource-limited",
            "execution.termination-uncertain",
            "execution.artifact-missing",
            "execution.scan-failed",
            "integrity.hash-mismatch",
            "integrity.reference-missing",
            "integrity.sequence-invalid",
            "integrity.signature-invalid",
            "integrity.publication-conflict",
            "storage.write-failed",
            "storage.durability-uncertain",
            "storage.capacity-exhausted",
            "review.rejected",
            "review.waiver-invalid",
            "review.separation-violated",
            "operator.cancelled",
            "operator.action-required",
            "internal.invariant-violated",
            "internal.unexpected"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryMode": {
          "enum": ["never", "same-request", "new-attempt", "after-reconcile", "after-operator"]
        },
        "suggestedAction": {
          "enum": ["fix-input", "fix-contract", "grant-policy", "install-capability", "retry", "reconcile", "repair", "restore-storage", "review", "operator-action", "report-bug"]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {"properties": {"category": {"const": "schema"}, "code": {"const": "schema.invalid-document"}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "fix-input"}}},
            {"properties": {"category": {"const": "schema"}, "code": {"const": "schema.unsupported-version"}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "fix-contract"}}},
            {"properties": {"category": {"const": "static"}, "code": {"enum": ["static.unresolved-reference", "static.dependency-cycle", "static.path-invalid", "static.target-conflict"]}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "fix-contract"}}},
            {"properties": {"category": {"const": "policy"}, "code": {"const": "policy.authorization-denied"}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "grant-policy"}}},
            {"properties": {"category": {"const": "policy"}, "code": {"const": "policy.budget-exhausted"}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "operator-action"}}},
            {"properties": {"category": {"const": "policy"}, "code": {"const": "policy.boundary-violation"}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "fix-input"}}},
            {"properties": {"category": {"const": "capability"}, "code": {"enum": ["capability.unavailable", "capability.isolation-unavailable"]}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "install-capability"}}},
            {"properties": {"category": {"const": "capability"}, "code": {"const": "capability.unsupported-runner"}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "fix-contract"}}},
            {"properties": {"category": {"const": "transport"}, "code": {"const": "transport.rejected"}, "retryMode": {"const": "same-request"}, "suggestedAction": {"const": "retry"}}},
            {"properties": {"category": {"const": "transport"}, "code": {"enum": ["transport.timeout", "transport.result-uncertain"]}, "retryMode": {"const": "after-reconcile"}, "suggestedAction": {"const": "reconcile"}}},
            {"properties": {"category": {"const": "execution"}, "code": {"enum": ["execution.start-failed", "execution.exit-nonzero", "execution.timed-out", "execution.resource-limited", "execution.artifact-missing"]}, "retryMode": {"const": "new-attempt"}, "suggestedAction": {"const": "repair"}}},
            {"properties": {"category": {"const": "execution"}, "code": {"const": "execution.termination-uncertain"}, "retryMode": {"const": "after-reconcile"}, "suggestedAction": {"const": "reconcile"}}},
            {"properties": {"category": {"const": "execution"}, "code": {"const": "execution.scan-failed"}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "operator-action"}}},
            {"properties": {"category": {"const": "integrity"}, "code": {"enum": ["integrity.hash-mismatch", "integrity.reference-missing", "integrity.sequence-invalid", "integrity.signature-invalid"]}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "reconcile"}}},
            {"properties": {"category": {"const": "integrity"}, "code": {"const": "integrity.publication-conflict"}, "retryMode": {"const": "after-reconcile"}, "suggestedAction": {"const": "reconcile"}}},
            {"properties": {"category": {"const": "storage"}, "code": {"enum": ["storage.write-failed", "storage.durability-uncertain"]}, "retryMode": {"const": "after-reconcile"}, "suggestedAction": {"const": "reconcile"}}},
            {"properties": {"category": {"const": "storage"}, "code": {"const": "storage.capacity-exhausted"}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "restore-storage"}}},
            {"properties": {"category": {"const": "review"}, "code": {"const": "review.rejected"}, "retryMode": {"const": "new-attempt"}, "suggestedAction": {"const": "repair"}}},
            {"properties": {"category": {"const": "review"}, "code": {"enum": ["review.waiver-invalid", "review.separation-violated"]}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "review"}}},
            {"properties": {"category": {"const": "operator"}, "code": {"const": "operator.cancelled"}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "operator-action"}}},
            {"properties": {"category": {"const": "operator"}, "code": {"const": "operator.action-required"}, "retryMode": {"const": "after-operator"}, "suggestedAction": {"const": "operator-action"}}},
            {"properties": {"category": {"const": "internal"}, "code": {"enum": ["internal.invariant-violated", "internal.unexpected"]}, "retryMode": {"const": "never"}, "suggestedAction": {"const": "report-bug"}}}
          ]
        }
      ]
    }
  }
}
