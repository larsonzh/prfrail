{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/supervised-risk-confirmation.schema.json",
  "title": "ProofRail supervised-black-box binding risk confirmation",
  "description": "Start-up precondition of the supervised-black-box mode (contracts section 7.1a): a binding acknowledgment that fixes run/task/step/attempt, the isolated-workspace digest, the risk-notice version and hash, the visible delivery fact and the request/response interaction evidence. Its canonical record hash domain separator lives in the hash layer, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "record", "recordHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "record": {
      "$ref": "#/$defs/record"
    },
    "recordHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "hashSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nonemptyHashSet": {
      "$ref": "#/$defs/hashSet",
      "minItems": 1
    },
    "interactionEvidence": {
      "$ref": "#/$defs/hashSet",
      "minItems": 2,
      "maxItems": 2
    },
    "operatorActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "operator"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "transportRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "deliveredAt", "deliveryStatus", "transportRequestId", "errorEvidence"],
      "properties": {
        "channel": {
          "const": "sessionbridge-visible"
        },
        "deliveredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "deliveryStatus": {
          "enum": ["accepted", "unavailable", "unknown"]
        },
        "transportRequestId": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/transportRequestId"}
          ]
        },
        "errorEvidence": {
          "$ref": "#/$defs/hashSet"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recordId",
        "issuedAt",
        "issuedBy",
        "runId",
        "taskId",
        "stepId",
        "attempt",
        "workspaceHash",
        "riskNoticeVersion",
        "riskNoticeHash",
        "selection",
        "delivery",
        "interactionEvidence",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "supervised-risk-confirmation"
        },
        "recordId": {
          "$ref": "#/$defs/id"
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "issuedBy": {
          "$ref": "#/$defs/operatorActor"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "stepId": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceHash": {
          "$ref": "#/$defs/sha256"
        },
        "riskNoticeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "riskNoticeHash": {
          "$ref": "#/$defs/sha256"
        },
        "selection": {
          "const": "confirm"
        },
        "delivery": {
          "$ref": "#/$defs/delivery"
        },
        "interactionEvidence": {
          "$ref": "#/$defs/interactionEvidence"
        },
        "evidence": {
          "$ref": "#/$defs/nonemptyHashSet"
        }
      }
    }
  }
}
