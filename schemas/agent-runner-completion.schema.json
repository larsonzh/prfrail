{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/agent-runner-completion.schema.json",
  "title": "ProofRail AgentRunner completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "completion", "recordHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "completion": {"$ref": "#/$defs/completion"},
    "recordHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "hashSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "completionId", "requestId", "requestHash", "runId", "taskId", "stepId", "attempt", "adapterId", "sessionId", "completedAt", "status", "exitCode", "processTreeStatus", "logsComplete", "usageComplete", "outputManifestHash", "evidence", "errorEvidence"],
      "properties": {
        "kind": {"const": "agent-runner-completion"},
        "completionId": {"$ref": "#/$defs/id"},
        "requestId": {"$ref": "#/$defs/id"},
        "requestHash": {"$ref": "#/$defs/sha256"},
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "stepId": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "adapterId": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "status": {"enum": ["completed", "failed", "cancelled", "operator-action-required", "uncertain"]},
        "exitCode": {"type": ["integer", "null"]},
        "processTreeStatus": {"enum": ["stopped", "unknown"]},
        "logsComplete": {"type": "boolean"},
        "usageComplete": {"type": "boolean"},
        "outputManifestHash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/hashSet"},
        "errorEvidence": {"$ref": "#/$defs/hashSet"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "exitCode": {"const": 0},
              "processTreeStatus": {"const": "stopped"},
              "logsComplete": {"const": true},
              "usageComplete": {"const": true},
              "outputManifestHash": {"$ref": "#/$defs/sha256"},
              "evidence": {"minItems": 1},
              "errorEvidence": {"maxItems": 0}
            }
          },
          "else": {"properties": {"errorEvidence": {"minItems": 1}}}
        }
      ]
    }
  }
}