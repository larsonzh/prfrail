{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/adapter-envelope.schema.json",
  "title": "ProofRail adapter request, claim and result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "message", "recordHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "message": {
      "oneOf": [
        {"$ref": "#/$defs/request"},
        {"$ref": "#/$defs/claim"},
        {"$ref": "#/$defs/result"}
      ]
    },
    "recordHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "hashSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "runId", "taskId", "attempt", "createdAt", "adapter", "contextHash"],
      "properties": {
        "type": {"const": "request"},
        "requestId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "taskId": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "adapter": {"$ref": "#/$defs/id"},
        "contextHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "claimId", "consumerId", "claimedAt", "leaseExpiresAt", "generation", "requestHash", "takeoverReceiptHash"],
      "properties": {
        "type": {"const": "claim"},
        "requestId": {"$ref": "#/$defs/id"},
        "claimId": {"$ref": "#/$defs/id"},
        "consumerId": {"$ref": "#/$defs/id"},
        "claimedAt": {"$ref": "#/$defs/timestamp"},
        "leaseExpiresAt": {"$ref": "#/$defs/timestamp"},
        "generation": {"type": "integer", "minimum": 1},
        "requestHash": {"$ref": "#/$defs/sha256"},
        "takeoverReceiptHash": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "claimId", "generation", "completedAt", "requestHash", "status", "outputEvidence", "errorEvidence"],
      "properties": {
        "type": {"const": "result"},
        "requestId": {"$ref": "#/$defs/id"},
        "claimId": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 1},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "requestHash": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["completed", "failed", "uncertain"]},
        "outputEvidence": {"$ref": "#/$defs/hashSet"},
        "errorEvidence": {"$ref": "#/$defs/hashSet"}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": {"const": "completed"},
                "outputEvidence": {"minItems": 1},
                "errorEvidence": {"maxItems": 0}
              }
            },
            {
              "properties": {
                "status": {"const": "failed"},
                "errorEvidence": {"minItems": 1}
              }
            },
            {
              "properties": {
                "status": {"const": "uncertain"},
                "errorEvidence": {"minItems": 1}
              }
            }
          ]
        }
      ]
    }
  }
}
