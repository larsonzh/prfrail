{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/v1/error-set.schema.json",
  "title": "ProofRail persistent error set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "errorSet", "errorSetHash"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "errorSet": {
      "$ref": "#/$defs/errorSet"
    },
    "errorSetHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "errorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorId", "errorHash", "occurredAt", "category", "code"],
      "properties": {
        "errorId": {"$ref": "#/$defs/id"},
        "errorHash": {"$ref": "#/$defs/sha256"},
        "occurredAt": {"$ref": "#/$defs/timestamp"},
        "category": {
          "$ref": "https://proofrail.dev/schemas/v1/error.schema.json#/$defs/error/properties/category"
        },
        "code": {
          "$ref": "https://proofrail.dev/schemas/v1/error.schema.json#/$defs/error/properties/code"
        }
      },
      "oneOf": [
        {"properties": {"category": {"const": "schema"}, "code": {"enum": ["schema.invalid-document", "schema.unsupported-version"]}}},
        {"properties": {"category": {"const": "static"}, "code": {"enum": ["static.unresolved-reference", "static.dependency-cycle", "static.path-invalid", "static.target-conflict"]}}},
        {"properties": {"category": {"const": "policy"}, "code": {"enum": ["policy.authorization-denied", "policy.budget-exhausted", "policy.boundary-violation"]}}},
        {"properties": {"category": {"const": "capability"}, "code": {"enum": ["capability.unavailable", "capability.unsupported-runner", "capability.isolation-unavailable"]}}},
        {"properties": {"category": {"const": "transport"}, "code": {"enum": ["transport.rejected", "transport.timeout", "transport.result-uncertain"]}}},
        {"properties": {"category": {"const": "execution"}, "code": {"enum": ["execution.start-failed", "execution.exit-nonzero", "execution.timed-out", "execution.resource-limited", "execution.termination-uncertain", "execution.artifact-missing", "execution.scan-failed"]}}},
        {"properties": {"category": {"const": "integrity"}, "code": {"enum": ["integrity.hash-mismatch", "integrity.reference-missing", "integrity.sequence-invalid", "integrity.signature-invalid", "integrity.publication-conflict"]}}},
        {"properties": {"category": {"const": "storage"}, "code": {"enum": ["storage.write-failed", "storage.durability-uncertain", "storage.capacity-exhausted"]}}},
        {"properties": {"category": {"const": "review"}, "code": {"enum": ["review.rejected", "review.waiver-invalid", "review.separation-violated"]}}},
        {"properties": {"category": {"const": "operator"}, "code": {"enum": ["operator.cancelled", "operator.action-required"]}}},
        {"properties": {"category": {"const": "internal"}, "code": {"enum": ["internal.invariant-violated", "internal.unexpected"]}}}
      ]
    },
    "errorSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorSetId", "createdAt", "operation", "errors", "primaryErrorId"],
      "properties": {
        "errorSetId": {"$ref": "#/$defs/id"},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "operation": {"$ref": "#/$defs/id"},
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/errorEntry"}
        },
        "primaryErrorId": {"$ref": "#/$defs/id"}
      }
    }
  }
}
