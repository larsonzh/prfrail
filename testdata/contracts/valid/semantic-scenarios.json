                    "harness": "node-standard",
                    "targets": ["javascript-files"]
                  },
                  {
                    "id": "python-scope",
                    "language": "python",
                    "harness": "python-standard",
                    "targets": ["python-files"]
                  }
                ]
              }
            ]
          }
        },
        "target.schema.json": {
          "schemaVersion": "1.0.0",
          "targets": [
            {
              "id": "c-files",
