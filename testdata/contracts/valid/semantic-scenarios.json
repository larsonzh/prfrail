              "paths": ["src/**/*.c"]
            },
            {
              "id": "javascript-files",
              "class": "source",
              "access": "read-write",
              "paths": ["web/**/*.js"]
            },
            {
              "id": "python-files",
              "class": "source",
              "access": "read-write",
              "paths": ["scripts/**/*.py"]
            }
          ]
        },
        "hook.schema.json": {
          "schemaVersion": "1.0.0",
          "hooks": [
            {
              "id": "handoff-check",
